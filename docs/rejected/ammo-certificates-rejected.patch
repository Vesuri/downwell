diff --git a/src/platform/amiga/AmigaAmmoBlocks.h b/src/platform/amiga/AmigaAmmoBlocks.h
new file mode 100644
index 00000000..6514d909
--- /dev/null
+++ b/src/platform/amiga/AmigaAmmoBlocks.h
@@ -0,0 +1,64 @@
+#ifndef DOWNWELL_AMIGA_AMMO_BLOCKS_H
+#define DOWNWELL_AMIGA_AMMO_BLOCKS_H
+#include "AmigaRenderer.h"
+#include "core/AmmoGaugeRows.h"
+
+// Certificates for final eight-line interiors, not a second compositor.
+// Nonuniform artwork/partial fills retain the ordered drawing path.
+class AmigaAmmoBlocks {
+    struct Block {
+        UWORD low = 0, high = 0, divider = 0;
+        bool valid = false;
+    } previous_[36], next_[36];
+public:
+    void invalidate() { for (auto& b : previous_) b.valid = false; }
+    void prepare(const downwell::AmmoGaugeRows* rows, const AmigaWordStamp* stamps,
+                 const AmigaHudBlockedColumn* dividers, unsigned meter,
+                 unsigned fillTop, unsigned fillHeight, int top, int bottom) {
+        for (auto& b : next_) b.valid = false;
+        if (!rows || !dividers) return;
+        const int base = 229 + 4 * meter;
+        for (unsigned first = base >= 232 ? base - 231 : 1; first < 184;) {
+            const bool filled = first < rows->filled;
+            const unsigned frame = rows->state[first] < 4 ? rows->state[first] : 3;
+            unsigned end = first + 1;
+            while (end < 184 && (end < rows->filled) == filled &&
+                   (rows->state[end] < 4 ? rows->state[end] : 3) == frame) ++end;
+            // All eight source rows overlap only in this run's middle.
+            int low = base - static_cast<int>(end) + 8;
+            int high = base - static_cast<int>(first) + 1;
+            if (low < top) low = top;
+            if (high > bottom) high = bottom;
+            const auto& stamp = stamps[(filled ? 4 : 0) + frame];
+            const UWORD mask = stamp.runMask[7] & 0xfff0;
+            for (int y = (low + 7) & ~7; y + 8 <= high; y += 8) {
+                bool white = fillHeight && y >= static_cast<int>(fillTop) &&
+                             y + 8 <= static_cast<int>(fillTop + fillHeight);
+                if (!white && fillHeight && y < static_cast<int>(fillTop + fillHeight) &&
+                    y + 8 > static_cast<int>(fillTop)) continue;
+                const unsigned source = y - 4 * meter;
+                const unsigned a = dividers->indices[source >> 3];
+                const unsigned phase = source & 7;
+                const unsigned b = phase ? dividers->indices[(source >> 3) + 1] : 0;
+                // Dictionary indices are bytes; reserve two phase bits (0/4)
+                // and one validity bit separately, without hashing collisions.
+                // Current dictionary has fewer than 32 entries. Larger packs
+                // must fall back rather than truncate identity.
+                if (a >= 32 || b >= 32) continue;
+                auto& block = next_[y >> 3];
+                block.low = (0xfff0 & ~mask) | (stamp.runLow[7] & mask);
+                block.high = ((white ? 0x8010 : 0xfff0) & ~mask) | (stamp.runHigh[7] & mask);
+                block.divider = a | (b << 5) | ((a || b) ? phase << 10 : 0);
+                block.valid = true;
+            }
+            first = end;
+        }
+    }
+    bool unchanged(unsigned index) const {
+        const auto& a = previous_[index];
+        const auto& b = next_[index];
+        return a.valid && b.valid && a.low == b.low && a.high == b.high && a.divider == b.divider;
+    }
+    void commit() { for (unsigned i = 0; i < 36; ++i) previous_[i] = next_[i]; }
+};
+#endif
