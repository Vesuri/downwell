diff --git a/src/platform/amiga/AmigaTerrainRowOwner.h b/src/platform/amiga/AmigaTerrainRowOwner.h
new file mode 100644
index 00000000..a0bc08d9
--- /dev/null
+++ b/src/platform/amiga/AmigaTerrainRowOwner.h
@@ -0,0 +1,73 @@
+#ifndef DOWNWELL_AMIGA_TERRAIN_ROW_OWNER_H
+#define DOWNWELL_AMIGA_TERRAIN_ROW_OWNER_H
+
+#include <cstdint>
+#include <cstring>
+
+// Fixed terrain may borrow an immutable, source-prefix row from the loaded
+// resource bank. Any mutation materializes that row before exposing a writable
+// byte. The bank must outlive this owner and any copy of it. No query builds a
+// cache or scans a segment list; row lookup is one indexed pointer read.
+#ifdef DOWNWELL_REFERENCE_TERRAIN_ROWS
+// Retained materialized occupancy representation for paired native timing.
+class AmigaTerrainRowOwner {
+    std::uint8_t cells_[128*512]{};
+public:
+    static constexpr unsigned columns=128,rows=512;
+    static constexpr unsigned size(){return columns*rows;}
+    void clear(){std::memset(cells_,0,sizeof(cells_));}
+    const std::uint8_t* readRow(unsigned y)const{return cells_+y*columns;}
+    std::uint8_t* writeRow(unsigned y){return cells_+y*columns;}
+    std::uint8_t read(unsigned cell)const{return cells_[cell];}
+    std::uint8_t operator[](unsigned cell)const{return cells_[cell];}
+    std::uint8_t& write(unsigned cell){return cells_[cell];}
+    bool admits(unsigned,const std::uint8_t*)const{return false;}
+    bool publish(unsigned,const std::uint8_t*,const std::uint8_t*){return false;}
+};
+#else
+class AmigaTerrainRowOwner {
+public:
+    static constexpr unsigned columns=128,rows=512;
+private:
+    inline static constexpr std::uint8_t empty_[columns]{};
+    std::uint8_t mutable_[rows][columns];
+    const std::uint8_t* row_[rows];
+public:
+    AmigaTerrainRowOwner(){clear();}
+    AmigaTerrainRowOwner(const AmigaTerrainRowOwner& other){*this=other;}
+    AmigaTerrainRowOwner& operator=(const AmigaTerrainRowOwner& other){
+        if(this==&other)return *this;
+        for(unsigned y=0;y<rows;++y){
+            if(other.row_[y]==other.mutable_[y]){
+                std::memcpy(mutable_[y],other.mutable_[y],columns);
+                row_[y]=mutable_[y];
+            }else row_[y]=other.row_[y];
+        }
+        return *this;
+    }
+    void clear(){for(auto& row:row_)row=empty_;}
+    const std::uint8_t* readRow(unsigned y)const{return row_[y];}
+    std::uint8_t* writeRow(unsigned y){
+        if(row_[y]!=mutable_[y]){
+            std::memcpy(mutable_[y],row_[y],columns);
+            row_[y]=mutable_[y];
+        }
+        return mutable_[y];
+    }
+    std::uint8_t read(unsigned cell)const{return row_[cell/columns][cell%columns];}
+    std::uint8_t operator[](unsigned cell)const{return read(cell);}
+    static constexpr unsigned size(){return rows*columns;}
+    std::uint8_t& write(unsigned cell){return writeRow(cell/columns)[cell%columns];}
+    // nullptr denotes the empty prefix, not permission to replace any row.
+    // Admission is read-only: a failed fast-path admission must leave the
+    // scalar publisher able to apply its original mutation/failure prefix.
+    bool admits(unsigned y,const std::uint8_t* predecessor)const{
+        return y<rows&&row_[y]==(predecessor?predecessor:empty_);
+    }
+    bool publish(unsigned y,const std::uint8_t* prepared,const std::uint8_t* predecessor){
+        if(!prepared||!admits(y,predecessor))return false;
+        row_[y]=prepared;return true;
+    }
+};
+#endif
+#endif
diff --git a/tests/platform/amiga/AmigaTerrainRowOwnerTest.cpp b/tests/platform/amiga/AmigaTerrainRowOwnerTest.cpp
new file mode 100644
index 00000000..dc71a625
--- /dev/null
+++ b/tests/platform/amiga/AmigaTerrainRowOwnerTest.cpp
@@ -0,0 +1,55 @@
+#include "platform/amiga/AmigaTerrainRowOwner.h"
+#include <array>
+#include <cassert>
+#include <memory>
+#include <cstdio>
+
+int main(){
+    using Rows=AmigaTerrainRowOwner;
+    auto owner=std::make_unique<Rows>();
+    std::array<std::uint8_t,Rows::columns> first{},second{};
+    first[42]=83;second=first;second[43]=34;
+    assert(owner->admits(0,nullptr)&&!owner->admits(Rows::rows,nullptr));
+    assert(!owner->publish(0,nullptr,nullptr));
+    assert(owner->publish(0,first.data(),nullptr));
+    assert(owner->readRow(0)==first.data()&&owner->read(42)==83);
+    assert(!owner->publish(0,second.data(),nullptr));
+    assert(owner->publish(0,second.data(),first.data()));
+    // A source event interrupts the immutable chain, even if it subsequently
+    // restores identical byte values. Later prefixes must use the fallback.
+    owner->write(42)=19;
+    assert(first[42]==83&&second[42]==83&&owner->read(42)==19);
+    owner->write(42)=83;
+    assert(!owner->admits(0,second.data()));
+    assert(!owner->publish(0,first.data(),second.data()));
+    assert(owner->publish(1,first.data(),nullptr));
+    auto copy=std::make_unique<Rows>(*owner);
+    assert(copy->readRow(0)!=owner->readRow(0));
+    assert(copy->readRow(1)==first.data());
+    owner->write(42)=0;copy->write(Rows::columns+42)=34;
+    assert(copy->read(42)==83&&owner->read(Rows::columns+42)==83&&first[42]==83);
+    *copy=*copy;
+    owner->clear();
+    for(unsigned y=0;y<Rows::rows;++y){
+        assert(owner->admits(y,nullptr));
+        for(unsigned x=0;x<Rows::columns;++x)assert(owner->read(y*Rows::columns+x)==0);
+    }
+    // Differential mutations across every row, with copies and resets.
+    auto reference=std::make_unique<std::array<std::uint8_t,Rows::rows*Rows::columns>>();
+    std::uint32_t random=91823;
+    for(unsigned step=0;step<8192;++step){
+        random=random*1664525u+1013904223u;
+        const unsigned y=(random>>16)%Rows::rows,x=random%Rows::columns;
+        if(step%31==0){owner->clear();reference->fill(0);}
+        if(owner->admits(y,nullptr)){
+            assert(owner->publish(y,first.data(),nullptr));
+            for(unsigned i=0;i<Rows::columns;++i)(*reference)[y*Rows::columns+i]=first[i];
+        }
+        owner->write(y*Rows::columns+x)=std::uint8_t(random>>24);
+        (*reference)[y*Rows::columns+x]=std::uint8_t(random>>24);
+        if(step%17==0){*copy=*owner;*owner=*copy;}
+        for(unsigned i=0;i<Rows::columns;++i)assert(owner->read(y*Rows::columns+i)==(*reference)[y*Rows::columns+i]);
+    }
+    for(unsigned i=0;i<reference->size();++i)assert(owner->read(i)==(*reference)[i]);
+    std::puts("Immutable terrain prefixes, mutation isolation, predecessor guards, deep copies and 8192 differential mutations passed");
+}
