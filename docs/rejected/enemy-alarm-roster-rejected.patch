diff --git a/src/core/NativeEnemyAlarmRoster.h b/src/core/NativeEnemyAlarmRoster.h
new file mode 100644
index 00000000..e29769d3
--- /dev/null
+++ b/src/core/NativeEnemyAlarmRoster.h
@@ -0,0 +1,65 @@
+#ifndef DOWNWELL_NATIVE_ENEMY_ALARM_ROSTER_H
+#define DOWNWELL_NATIVE_ENEMY_ALARM_ROSTER_H
+#include "InstanceHandle.h"
+#include <cstdint>
+namespace downwell {
+// Native object identity is immutable within a generation. Maintain the alarm
+// phase's exact-object/registration ordering at its mutation points. A phase
+// borrows a bank; only a mutation while that bank is pinned makes a copy.
+template<unsigned Capacity> class NativeEnemyAlarmRoster {
+public:
+    struct Entry {InstanceHandle handle;int object;std::uint32_t order;unsigned alarms;};
+    struct Phase {const Entry* entries=nullptr;unsigned count=0,alarms=0;};
+private:
+    struct Bank {Entry entries[Capacity];unsigned count=0,alarms=0;} banks_[2]{};
+    unsigned current_=0;
+    int pinned_=-1;
+    Bank& writable(){
+        if(pinned_==int(current_)){
+            const unsigned next=current_^1;
+            banks_[next]=banks_[current_];current_=next;
+        }
+        return banks_[current_];
+    }
+    static void mask(Bank& bank){
+        bank.alarms=0;
+        for(unsigned i=0;i<bank.count;++i)bank.alarms|=bank.entries[i].alarms;
+    }
+    static bool before(const Entry& a,const Entry& b){
+        return a.object<b.object||(a.object==b.object&&a.order<b.order);
+    }
+public:
+    bool begin(Phase& out){
+        if(pinned_>=0)return false;
+        pinned_=int(current_);const auto& bank=banks_[current_];
+        out={bank.entries,bank.count,bank.alarms};return true;
+    }
+    void end(){pinned_=-1;}
+    void clear(){auto& bank=writable();bank.count=bank.alarms=0;}
+    bool erase(unsigned slot){
+        const auto& old=banks_[current_];unsigned i=0;
+        while(i<old.count&&old.entries[i].handle.slot!=slot)++i;
+        if(i==old.count)return true;
+        auto& bank=writable();
+        for(unsigned j=i+1;j<bank.count;++j)bank.entries[j-1]=bank.entries[j];
+        --bank.count;mask(bank);return true;
+    }
+    bool put(Entry entry){
+        if(!entry.handle.generation||entry.object<0||!entry.order)return false;
+        const auto& old=banks_[current_];
+        unsigned found=old.count;
+        for(unsigned i=0;i<old.count;++i)if(old.entries[i].handle.slot==entry.handle.slot){
+            const auto& e=old.entries[i];
+            if(e.handle.generation==entry.handle.generation&&e.object==entry.object&&
+               e.order==entry.order&&e.alarms==entry.alarms)return true;
+            found=i;break;
+        }
+        if(found==old.count&&old.count==Capacity)return false;
+        erase(entry.handle.slot);auto& bank=writable();
+        unsigned at=0;while(at<bank.count&&!before(entry,bank.entries[at]))++at;
+        for(unsigned i=bank.count;i>at;--i)bank.entries[i]=bank.entries[i-1];
+        bank.entries[at]=entry;++bank.count;bank.alarms|=entry.alarms;return true;
+    }
+};
+}
+#endif
diff --git a/tests/core/NativeEnemyAlarmRosterTest.cpp b/tests/core/NativeEnemyAlarmRosterTest.cpp
new file mode 100644
index 00000000..063feb43
--- /dev/null
+++ b/tests/core/NativeEnemyAlarmRosterTest.cpp
@@ -0,0 +1,33 @@
+#include "core/NativeEnemyAlarmRoster.h"
+#include <cassert>
+#include <cstdio>
+int main(){
+    using Roster=downwell::NativeEnemyAlarmRoster<4>;
+    Roster roster;
+    assert(roster.put({{2,1},116,3,1}));
+    assert(roster.put({{0,1},112,1,2}));
+    assert(roster.put({{1,1},112,2,2}));
+    Roster::Phase phase;
+    assert(roster.begin(phase)&&phase.count==3&&phase.alarms==3);
+    assert(phase.entries[0].handle.slot==0&&phase.entries[1].handle.slot==1&&phase.entries[2].handle.slot==2);
+    Roster::Phase nested;assert(!roster.begin(nested));
+    const auto* original=phase.entries;
+    assert(roster.put({{0,1},112,1,2})); // no-op while pinned
+    assert(roster.erase(0));
+    assert(roster.put({{0,2},112,4,2})); // slot reuse cannot replace captured lifetime
+    assert(roster.put({{3,1},93,5,0}));
+    assert(!roster.put({{4,1},119,6,1})); // capacity failure preserves successful prefix
+    assert(phase.entries==original&&phase.count==3&&phase.entries[0].handle.generation==1);
+    roster.end();
+    assert(roster.begin(phase)&&phase.count==4&&phase.entries[0].object==93);
+    assert(phase.entries[1].handle.slot==1&&phase.entries[2].handle.slot==0);
+    roster.clear();assert(phase.count==4&&phase.entries[2].handle.generation==2);
+    roster.end();assert(roster.begin(phase)&&phase.count==0&&phase.alarms==0);roster.end();
+    for(unsigned generation=1;generation<1000;++generation){
+        assert(roster.put({{0,generation},113,generation,3}));
+        assert(roster.begin(phase)&&phase.count==1&&phase.entries[0].handle.generation==generation);
+        assert(roster.erase(0));assert(phase.entries[0].handle.generation==generation);
+        roster.end();
+    }
+    std::puts("Native enemy alarm roster: ordered registration, pinned mutations, reuse and failure prefixes pass");
+}
