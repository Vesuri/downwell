+        if(n==Terrain::descriptorEnd)n=terrain_->descriptorOf(first-First);
+        if(n==Terrain::descriptorEnd||terrain_->descriptorFirst(n)!=first-First||
+            terrain_->descriptorCount(n)!=count||terrain_->attachment(n).list<2)return false;
+        insertActive(First+n,key);return true;
+    }
+    bool remove(unsigned s){
+        if(!contains(s)||(terrain_&&terrain_->reservationPending()))return false;
+        const unsigned n=isolate(s);clearMark(s,n);unlink(n);return true;
+    }
+    void clear(){
+        for(unsigned list=0;list<2;++list)while(head_[list]!=End){
+            const unsigned n=head_[list];unlink(n);node(n).marks=0;
+        }
+        if(markedCount_)for(auto& word:marks_)word=0;markedCount_=0;
+    }
+    void clearReference(){for(unsigned list=0;list<2;++list)while(head_[list]!=End)remove(first(list));}
+    unsigned runCount()const{
+        unsigned count=0;for(unsigned list=0;list<2;++list)for(unsigned n=head_[list];n!=End;n=node(n).next)++count;return count;
+    }
+    class AnimationCursor {
+        const RunnerSharedRoomMembership& room_;unsigned current_,skipFirst_,skipLast_;
+    public:
+        AnimationCursor(const RunnerSharedRoomMembership& room,unsigned a,unsigned b)
+            :room_(room),current_(room.first(0)),skipFirst_(a),skipLast_(b){}
+        unsigned slot(){
+            while(current_!=End&&current_>=skipFirst_&&current_<skipLast_){
+                const unsigned n=room_.descriptor(current_);
+                current_=skipLast_<room_.end(n)?room_.liveAt(n,skipLast_):room_.after(n);
+                if(current_==room_.end(n))current_=room_.after(n);
+            }return current_;
+        }
+        bool within(unsigned a,unsigned b){const auto s=slot();return s>=a&&s<b;}
+        unsigned take(){const auto s=slot();if(s!=End)current_=room_.next(s);return s;}
+    };
+    template<class Visit> bool visitAnimationChecked(Visit visit)const{
+        for(unsigned s=first(0);s!=End;s=next(s))if(!visit(s))return false;return true;
+    }
+    template<class Visit> bool visitDrawChecked(Visit visit)const{
+        for(unsigned n=tail_[0];n!=End;n=node(n).previous)
+            for(unsigned s=end(n);s>begin(n);){--s;if(descriptor(s)==n&&!visit(s))return false;}
+        return true;
+    }
+    bool prepareRetainedAnimation(unsigned a,unsigned b)const{return a<=b&&b<=Capacity;}
+    template<class Visit> bool visitAnimationProjectedChecked(AnimationProjection&,unsigned a,unsigned b,bool& dirty,Visit visit)const{
+        return visitAnimationRetainedChecked(a,b,dirty,visit);
+    }
+    template<class Visit> bool visitAnimationRetainedChecked(unsigned a,unsigned b,bool& dirty,Visit visit)const{
+        if(a>b||b>Capacity)return false;
+        bool full=dirty;dirty=false;
+        if(full){DW_PROFILE_COUNT(counterAnimationFullPass);}else{DW_PROFILE_COUNT(counterAnimationProjectedPass);}
+        for(unsigned s=first(0);s!=End;){
+            if(dirty)full=true;
+            const unsigned n=descriptor(s);
+            if(!full&&s>=a&&s<b){
+                s=b<end(n)?liveAt(n,b):after(n);if(s==end(n))s=after(n);continue;
+            }
+            const unsigned following=next(s);if(!visit(s))return false;s=following;
+        }return true;
+    }
+    template<class Visit> bool visitCleanupChecked(Visit visit){
+        for(unsigned list=0;list<2;++list)for(unsigned s=first(list);s!=End;){
+            const unsigned following=next(s);if(!visit(s))return false;s=following;
+        }return true;
+    }
+    template<class Visit> bool visitMarkedCleanupChecked(Visit visit){
+        return visitMarkedCleanupOrdered([&](unsigned s,RunnerImageValue,bool){return visit(s);});
+    }
+    template<class Visit> bool visitMarkedCleanupOrdered(Visit visit){
+        if(!markedCount_)return true;
+        for(unsigned list=0;list<2;++list)for(unsigned s=first(list);s!=End;){
+            const unsigned n=descriptor(s),limit=end(n);
+            if(!node(n).marks){s=after(n);continue;}
+            while(s<limit&&!(descriptor(s)==n&&marked(s)))++s;
+            if(s==limit){s=after(n);continue;}
+            const unsigned following=next(s);
+            if(!visit(s,node(n).key,list==0))return false;s=following;
+        }return true;
+    }
+    template<class Select,class Inactive,class Publish>
+    bool reconcileSelectedChecked(Select select,Inactive inactive,Publish publish){
+        for(unsigned list=1;;--list){
+            for(unsigned s=first(list);s!=End;){
+                const unsigned n=descriptor(s),limit=end(n);s=select(s,limit);
+                if(s==limit){s=after(n);continue;}
+                s=liveAt(n,s);if(s==limit){s=after(n);continue;}
+                const unsigned following=next(s);
+                if(bool(inactive(s))!=bool(list)){
+                    const auto key=node(n).key;const bool wasMarked=marked(s);
+                    remove(s);const unsigned isolated=descriptor(s);
+                    if(list)insertActive(isolated,key);else insertAfter(isolated,key,1,tail_[1]);
+                    if(wasMarked)mark(s);if(!publish(s,list!=0))return false;
+                }s=following;
+            }if(!list)break;
+        }return true;
+    }
+    template<class Inactive,class Publish> bool reconcileChecked(Inactive inactive,Publish publish){
+        return reconcileSelectedChecked([](unsigned first,unsigned){return first;},inactive,publish);
+    }
+    template<class Inactive,class Publish> void reconcile(Inactive inactive,Publish publish){
+        reconcileChecked(inactive,[&](unsigned s,bool active){publish(s,active);return true;});
+    }
+};
+}
