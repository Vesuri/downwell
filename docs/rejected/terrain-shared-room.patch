+// Stored on the lifetime descriptor, separately from layer publication. Room
+// chronology survives layer changes; it must not be copied back with that state.
+struct RunnerRoomSpanState {
+    RunnerImageValue key{};
+    std::uint16_t next=65535,previous=65535,marks=0,list=2;
+};
+// Terrain geometry and slot lookup belong exclusively to Terrain. Only actors
+// need standalone nodes. Terrain must outlive this owner and forward descriptor
+// split/release notifications. Remove room membership before physical retirement.
+template<unsigned Capacity,unsigned First,unsigned Last,class Terrain>
+class RunnerSharedRoomMembership {
+    static_assert(First<Last&&Last<=Capacity&&Capacity<65534,"Invalid shared room domain");
+    static_assert(Terrain::descriptorEnd==Last-First,"Terrain domain mismatch");
+    using Slot=std::uint16_t;
+    Terrain* terrain_=nullptr;
+    RunnerRoomSpanState actors_[Capacity-(Last-First)?Capacity-(Last-First):1]{};
+    std::uint32_t marks_[(Capacity+31)/32]{};
+    unsigned head_[2]={Capacity,Capacity},tail_[2]={Capacity,Capacity},markedCount_=0;
+    bool good_=true;
+    static bool terrainSlot(unsigned s){return s>=First&&s<Last;}
+    RunnerRoomSpanState& node(unsigned n){return terrainSlot(n)?terrain_->attachment(n-First):actors_[n<First?n:n-(Last-First)];}
+    const RunnerRoomSpanState& node(unsigned n)const{return terrainSlot(n)?terrain_->attachment(n-First):actors_[n<First?n:n-(Last-First)];}
+    unsigned descriptor(unsigned s)const{
+        if(s>=End)return End;
+        if(!terrainSlot(s))return s;
+        if(!terrain_)return End;
+        const unsigned n=terrain_->descriptorOf(s-First);
+        return n==Terrain::descriptorEnd?End:First+n;
+    }
+    unsigned begin(unsigned n)const{return terrainSlot(n)?First+terrain_->descriptorFirst(n-First):n;}
+    unsigned end(unsigned n)const{return terrainSlot(n)?begin(n)+terrain_->descriptorCount(n-First):n+1;}
+    unsigned liveAt(unsigned n,unsigned s)const{
+        if(terrainSlot(n))while(s<end(n)&&descriptor(s)!=n)++s;
+        return s;
+    }
+    unsigned firstNode(unsigned n)const{
+        while(n!=End){const unsigned s=liveAt(n,begin(n));if(s<end(n))return s;n=node(n).next;}
+        return End;
+    }
