index 00000000..fc558cb9
--- /dev/null
+++ b/src/core/GameplayAlarmCapture.h
@@ -0,0 +1,93 @@
+#ifndef DOWNWELL_CORE_GAMEPLAY_ALARM_CAPTURE_H
+#define DOWNWELL_CORE_GAMEPLAY_ALARM_CAPTURE_H
+#include "AlarmBank.h"
+#include "InstanceHandle.h"
+namespace downwell {
+enum class GameplayAlarmFamily {enemy,breakable,debris,timeChange,entryDither,drone};
+struct GameplayAlarmEntry {
+    static constexpr unsigned end=~0u;
+    InstanceHandle key{};
+    unsigned next=end;
+    unsigned last=0; // Tail of this same-family run, meaningful at its head.
+    GameplayAlarmFamily family{};
+};
+// A family consumes only its contiguous run in a captured resource row.
+// Interleaved families with equal resource IDs keep registration order.
+class GameplayAlarmCursor {
+    const GameplayAlarmEntry* entries_;
+    unsigned next_;
+    unsigned end_;
+    GameplayAlarmFamily family_;
+public:
+    GameplayAlarmCursor(const GameplayAlarmEntry* entries,unsigned first):
+        entries_(entries),next_(first),end_(entries[entries[first].last].next),family_(entries[first].family){}
+    GameplayAlarmFamily family()const{return family_;}
+    bool empty()const{return next_==end_;}
+    void skip(){next_=end_;}
+    InstanceHandle take(){const auto& entry=entries_[next_];next_=entry.next;return entry.key;}
+    unsigned next()const{return next_;}
+};
+// Native objects do not change resource identity within a lifetime. Capture
+// registration order directly into resource rows instead of capturing a
+// generic (object, order, handle) array and sorting it. Only generation keys,
+// never compactable record pointers, survive a callback. This is a snapshot:
+// later births are deliberately absent until the next capture.
+template<unsigned Capacity,unsigned ObjectCapacity> class GameplayAlarmCapture {
+    static constexpr unsigned end=GameplayAlarmEntry::end;
+    struct Row {unsigned first=end,last=end,group=end,mask=0;};
+    Row rows_[ObjectCapacity]{};
+    GameplayAlarmEntry entries_[Capacity]{};
+    unsigned active_[ObjectCapacity]{};
+    unsigned objectCount_=0,count_=0,activeCount_=0,mask_=0;
+public:
+    template<class Mask> bool bind(unsigned objectCount,Mask mask){
+        objectCount_=0;
+        if(objectCount>ObjectCapacity)return false;
+        for(unsigned id=0;id<objectCount;++id){
+            unsigned events;
+            if(!mask(int(id),events)||(events&~unsigned(AlarmBank::allEvents)))return false;
+            rows_[id].mask=events;
+        }
+        objectCount_=objectCount;clear();return true;
+    }
+    void clear(){
+        for(unsigned id=0;id<objectCount_;++id)rows_[id].first=rows_[id].last=end;
+        count_=activeCount_=mask_=0;
+    }
+    template<class Decode> bool append(InstanceHandle shared,int object,Decode decode){
+        if(object<0||unsigned(object)>=objectCount_||!shared.generation)return false;
+        auto& row=rows_[object];
+        if(!row.mask)return true; // Immutable absent event row: no countdowns.
+        if(count_==Capacity)return false;
+        auto& entry=entries_[count_];
+        if(!decode(shared,entry.family,entry.key)||!entry.key.generation)return false;
+        entry.next=end;
+        if(row.last==end||entries_[row.last].family!=entry.family)row.group=count_;
+        entries_[row.group].last=count_;
+        if(row.last==end)row.first=count_;
+        else entries_[row.last].next=count_;
+        row.last=count_++;mask_|=row.mask;return true;
+    }
+    void finish(){
+        activeCount_=0;
+        for(unsigned id=0;id<objectCount_;++id)if(rows_[id].first!=end)active_[activeCount_++]=id;
+    }
+    template<class Visit> bool visit(Visit visit)const{
+        for(unsigned alarm=0;alarm<AlarmBank::count;++alarm){
+            const unsigned bit=1u<<alarm;
+            if(!(mask_&bit))continue;
+            for(unsigned i=0;i<activeCount_;++i){const auto& row=rows_[active_[i]];
+                if(!(row.mask&bit))continue;
+                unsigned first=row.first;
+                while(first!=end){
+                    GameplayAlarmCursor cursor(entries_,first);
+                    if(!visit(cursor,alarm)||!cursor.empty()||cursor.next()==first)return false;
+                    first=cursor.next();
+                }
+            }
+        }
+        return true;
+    }
+};
+}
+#endif
