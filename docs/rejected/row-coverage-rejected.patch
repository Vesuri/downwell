diff --git a/src/platform/amiga/AmigaRowCoverage.h b/src/platform/amiga/AmigaRowCoverage.h
new file mode 100644
index 00000000..c1eafb65
--- /dev/null
+++ b/src/platform/amiga/AmigaRowCoverage.h
@@ -0,0 +1,46 @@
+#ifndef DOWNWELL_AMIGA_ROW_COVERAGE_H
+#define DOWNWELL_AMIGA_ROW_COVERAGE_H
+#include "AmigaRenderer.h"
+
+// Physical rows, independent of camera position and plane storage. Producers
+// publish whole spans; consumers share the same footprint without rerasterizing.
+struct AmigaRowCoverage {
+    static constexpr unsigned count=downwellGameRingHeight/16;
+    static_assert(downwellGameRingHeight%16==0,"whole coverage words");
+    UWORD words[count]{};
+    void clear(){for(auto& word:words)word=0;}
+    void fill(){for(auto& word:words)word=0xffff;}
+    bool test(unsigned row)const{return (words[row/16]&(1u<<(row%16)))!=0;}
+    bool intersects(const AmigaRowCoverage& other)const{
+        for(unsigned i=0;i<count;++i)if(words[i]&other.words[i])return true;
+        return false;
+    }
+    void span(unsigned first,unsigned height,bool present=true){
+        while(height){
+            const unsigned bit=first%16;
+            const unsigned length=height<16-bit?height:16-bit;
+            const UWORD mask=static_cast<UWORD>(((1u<<length)-1)<<bit);
+            auto& word=words[first/16];
+            if(present)word|=mask;else word&=static_cast<UWORD>(~mask);
+            first+=length;height-=length;
+            if(first==downwellGameRingHeight)first=0;
+        }
+    }
+    template<class Visit> void runs(unsigned first,unsigned end,Visit visit)const{
+        unsigned start=end;
+        for(unsigned chunk=first/16;chunk<(end+15)/16;++chunk){
+            unsigned bits=words[chunk];
+            const unsigned base=chunk*16;
+            unsigned lo=first>base?first-base:0;
+            const unsigned hi=end<base+16?end-base:16;
+            if(!bits){if(start!=end){visit(start,base-start);start=end;}continue;}
+            if(bits==0xffff){if(start==end)start=base+lo;continue;}
+            for(unsigned bit=lo;bit<hi;++bit){
+                if(bits&(1u<<bit)){if(start==end)start=base+bit;}
+                else if(start!=end){visit(start,base+bit-start);start=end;}
+            }
+        }
+        if(start!=end)visit(start,end-start);
+    }
+};
+#endif
