diff --git a/src/core/RunnerSparseRoomMembership.h b/src/core/RunnerSparseRoomMembership.h
new file mode 100644
index 00000000..15f55cd7
--- /dev/null
+++ b/src/core/RunnerSparseRoomMembership.h
@@ -0,0 +1,164 @@
+#ifndef DOWNWELL_RUNNER_SPARSE_ROOM_MEMBERSHIP_H
+#define DOWNWELL_RUNNER_SPARSE_ROOM_MEMBERSHIP_H
+#include "RunnerRunRoomMembership.h"
+#include "RunnerRoomOrderState.h"
+namespace downwell {
+// Terrain owns room state on its identity runs, but never contributes a node
+// to actor animation. Only explicit full/reference visits expand terrain.
+// Reconciliation selects changed slots; cleanup orders only marked slots.
+template<unsigned Capacity,unsigned First,unsigned Last,class Terrain>
+class RunnerSparseRoomMembership {
+    static_assert(First<Last&&Last<=Capacity&&Capacity<65534,"Sparse room domain");
+    static constexpr unsigned Actors=Capacity-(Last-First);
+    using State=RunnerRoomOrderState;
+    using ActorRoom=RunnerRunRoomMembership<Actors,0,0>;
+    ActorRoom actors_;
+    State actorState_[Actors?Actors:1]{};
+    Terrain* terrain_=nullptr;
+    RunnerRegistrationOrder clock_;
+    std::uint16_t marked_[Capacity]{};
+    unsigned markedCount_=0;
+    mutable std::uint16_t scratch_[Capacity]{};
+    static bool external(unsigned s){return s>=First&&s<Last;}
+    static unsigned actor(unsigned s){return s<First?s:s-(Last-First);}
+    static unsigned global(unsigned s){return s<First?s:s+(Last-First);}
+    State state(unsigned s)const{
+        if(s>=Capacity)return {};
+        return external(s)?(terrain_?terrain_->roomState(s-First):State{}):actorState_[actor(s)];
+    }
+    void put(unsigned s,const State& value){
+        if(external(s))terrain_->setRoomState(s-First,value);else actorState_[actor(s)]=value;
+    }
+    static bool before(const State& a,const State& b){
+        if(a.list!=b.list)return a.list<b.list;
+        if(a.list==0){
+            if(RunnerSpatialSplit::less(a.depth,b.depth))return true;
+            if(RunnerSpatialSplit::less(b.depth,a.depth))return false;
+        }
+        return a.order.before(b.order);
+    }
+    void sort(std::uint16_t* slots,unsigned count)const{
+        // Mutated sets, not population-sized room projections. Birth does no
+        // sorting; actor order is maintained by its existing linked owner.
+        for(unsigned i=1;i<count;++i){const auto s=slots[i];const auto key=state(s);unsigned j=i;
+            while(j&&before(key,state(slots[j-1]))){slots[j]=slots[j-1];--j;}slots[j]=s;
+        }
+    }
+    void unmark(unsigned s){
+        if(!state(s).marked)return;
+        for(unsigned i=0;i<markedCount_;++i)if(marked_[i]==s){
+            for(unsigned j=i+1;j<markedCount_;++j)marked_[j-1]=marked_[j];--markedCount_;break;
+        }
+    }
+    // Reference-only complete order. Native actor animation, activation and
+    // marked cleanup must never call this path.
+    unsigned fullOrder()const{
+        unsigned n=0;
+        actors_.visitAnimationChecked([&](unsigned s){scratch_[n++]=std::uint16_t(global(s));return true;});
+        if(terrain_)terrain_->visitRoomSlots([&](unsigned s){if(state(First+s).list==0)scratch_[n++]=std::uint16_t(First+s);return true;});
+        sort(scratch_,n);return n;
+    }
+public:
+    static constexpr unsigned End=Capacity;
+    struct AnimationProjection {};
+    bool bindTerrain(Terrain& terrain){if(terrain_)return terrain_==&terrain;terrain_=&terrain;return true;}
+    bool contains(unsigned s)const{return state(s).list>=0;}
+    bool active(unsigned s)const{return state(s).list==0;}
+    bool marked(unsigned s)const{const auto r=state(s);return r.list>=0&&r.marked;}
+    bool bind(unsigned s,RunnerImageValue depth){
+        if(s>=End||!RunnerSpatialSplit::valid(depth)||(external(s)&&!terrain_))return false;
+        remove(s);clock_.advance();put(s,{clock_,depth,0,false});
+        return external(s)||actors_.bind(actor(s),depth);
+    }
+    bool bindTerrainSpan(unsigned first,unsigned count,RunnerImageValue depth){
+        if(!count)return true;
+        if(!terrain_||first<First||first>=Last||count>Last-first||!RunnerSpatialSplit::valid(depth))return false;
+        auto next=clock_;next.advance();
+        if(!terrain_->bindRoomSpan(first-First,count,{next,depth,0,false}))return false;
+        clock_=next.shifted(count-1);return true;
+    }
+    bool remove(unsigned s){
+        if(!contains(s))return false;unmark(s);put(s,{});
+        return external(s)||actors_.remove(actor(s));
+    }
+    bool mark(unsigned s){
+        auto r=state(s);if(r.list<0)return false;if(r.marked)return true;
+        r.marked=true;put(s,r);marked_[markedCount_++]=std::uint16_t(s);sort(marked_,markedCount_);return true;
+    }
+    void clear(){
+        actors_.clear();for(auto& r:actorState_)r={};
+        if(terrain_)terrain_->visitRoomSlots([&](unsigned s){terrain_->setRoomState(s,{});return true;});
+        markedCount_=0;
+    }
+    class AnimationCursor {
+        typename ActorRoom::AnimationCursor cursor_;
+        unsigned skipFirst_,skipLast_;
+    public:
+        AnimationCursor(const RunnerSparseRoomMembership& room,unsigned a,unsigned b)
+            :cursor_(room.actors_,0,0),skipFirst_(a),skipLast_(b){}
+        unsigned slot(){
+            while(cursor_.slot()!=ActorRoom::End){const auto s=global(cursor_.slot());
+                if(s<skipFirst_||s>=skipLast_)return s;cursor_.take();
+            }return End;
+        }
+        bool within(unsigned a,unsigned b){const auto s=slot();return s>=a&&s<b;}
+        unsigned take(){const auto s=slot();if(s!=End)cursor_.take();return s;}
+    };
+    bool prepareRetainedAnimation(unsigned a,unsigned b)const{return a<=b&&b<=Capacity;}
+    template<class Visit> bool visitAnimationChecked(Visit visit)const{
+        const unsigned n=fullOrder();for(unsigned i=0;i<n;++i)if(!visit(scratch_[i]))return false;return true;
+    }
+    template<class Visit> bool visitDrawChecked(Visit visit)const{
+        const unsigned n=fullOrder();for(unsigned i=n;i;)if(!visit(scratch_[--i]))return false;return true;
+    }
+    template<class Visit> bool visitAnimationRetainedChecked(unsigned a,unsigned b,bool& dirty,Visit visit)const{
+        if(a>b||b>End)return false;
+        bool full=dirty;dirty=false;
+        return visitAnimationChecked([&](unsigned s){if(dirty)full=true;return (!full&&s>=a&&s<b)||visit(s);});
+    }
+    template<class Visit> bool visitAnimationProjectedChecked(AnimationProjection&,unsigned a,unsigned b,bool& dirty,Visit visit)const{
+        return visitAnimationRetainedChecked(a,b,dirty,visit);
+    }
+    template<class Visit> bool visitMarkedCleanupOrdered(Visit visit){
+        bool havePrevious=false;State previous;
+        for(;;){
+            unsigned s=End;
+            for(unsigned i=0;i<markedCount_;++i){const auto r=state(marked_[i]);
+                if(r.list>=0&&(!havePrevious||before(previous,r))){s=marked_[i];break;}
+            }
+            if(s==End)return true;
+            previous=state(s);havePrevious=true;
+            if(!visit(s,previous.depth,previous.list==0))return false;
+        }
+    }
+    template<class Visit> bool visitMarkedCleanupChecked(Visit visit){
+        return visitMarkedCleanupOrdered([&](unsigned s,RunnerImageValue,bool){return visit(s);});
+    }
+    template<class Select,class Inactive,class Publish>
+    bool reconcileSelectedChecked(Select select,Inactive inactive,Publish publish){
+        for(unsigned list=1;;--list){
+            unsigned n=0;
+            for(unsigned s=select(0,End);s<End;s=select(s+1,End))
+                if(state(s).list==int(list))scratch_[n++]=std::uint16_t(s);
+            sort(scratch_,n);
+            for(unsigned i=0;i<n;++i){const unsigned s=scratch_[i];
+                if(bool(inactive(s))==bool(list))continue;
+                auto r=state(s);clock_.advance();r.order=clock_;r.list=std::int8_t(1-list);put(s,r);
+                if(!external(s)){
+                    // Keep actor links in the same source order as sparse
+                    // terrain changes; callbacks observe membership first.
+                    actors_.reconcileSelectedChecked([&](unsigned a,unsigned b){const auto local=actor(s);return local>=a&&local<b?local:b;},
+                        [&](unsigned){return list==0;},[](unsigned,bool){return true;});
+                }
+                if(r.marked)sort(marked_,markedCount_);
+                if(!publish(s,list!=0))return false;
+            }
+            if(!list)break;
+        }return true;
+    }
+    template<class Inactive,class Publish> bool reconcileChecked(Inactive inactive,Publish publish){
+        return reconcileSelectedChecked([](unsigned first,unsigned){return first;},inactive,publish);
+    }
+};
+}
+#endif
