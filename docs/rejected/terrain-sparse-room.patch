+#include "core/RunnerSparseRoomMembership.h"
+#include "core/RunnerRoomMembership.h"
+#include "core/RunnerActivationChanges.h"
+#include "core/NativeTerrainLifetimes.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+using namespace downwell;
+static void check(bool value,unsigned line){if(!value){std::fprintf(stderr,"sparse room check %u\n",line);std::abort();}}
+#define CHECK(x) check(bool(x),__LINE__)
+struct Terrain {
+    RunnerRoomOrderState states[32]{};
+    mutable unsigned reads=0,walks=0;
+    auto roomState(unsigned s)const{++reads;return states[s];}
+    void setRoomState(unsigned s,RunnerRoomOrderState value){states[s]=value;}
+    bool bindRoomSpan(unsigned first,unsigned count,RunnerRoomOrderState value){
+        if(first>=32||count>32-first)return false;
+        for(unsigned i=0;i<count;++i)if(states[first+i].list>=0)return false;
+        for(unsigned i=0;i<count;++i)states[first+i]=value.shifted(i);return true;
+    }
+    template<class Visit> bool visitRoomSlots(Visit visit)const{
+        ++walks;for(unsigned i=0;i<32;++i)if(states[i].list>=0&&!visit(i))return false;return true;
+    }
+};
+using Room=RunnerSparseRoomMembership<48,8,40,Terrain>;
+static RunnerImageValue key(int value){RunnerImageValue out;CHECK(out.assignInteger(value));return out;}
+#ifdef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+static void nativeReservations(){
+    using Native=NativeTerrainLifetimes<32>;
+    using NativeRoom=RunnerSparseRoomMembership<48,8,40,Native>;
+    const unsigned char cells[]={32,0,33,0,34,0,35,0,36,0,37,0,38,0,39,0};
+    for(unsigned prefix=0;prefix<=8;++prefix){
+        Native native;NativeRoom room;CHECK(room.bindTerrain(native));
+        struct Context{NativeRoom* room;unsigned prefix,clock=1;} context{&room,prefix};
+        Native::Binding binding;binding.context=&context;
+        binding.admit=[](void*,unsigned){return true;};
+        binding.birth=[](void* p,const Native::Identity& id,bool,std::uint32_t& stamp,std::uint32_t&){
+            auto& c=*static_cast<Context*>(p);stamp=c.clock++;return c.room->bind(id.handle.slot+8,key(100));};
+        binding.retire=[](void* p,unsigned s){return static_cast<Context*>(p)->room->remove(s+8);};
+        binding.mark=[](void* p,unsigned s){return static_cast<Context*>(p)->room->mark(s+8);};
+        binding.constructDirectSpan=[](void* p,const Native::Identity& id,Native::PreparedCells cells,int,
+            unsigned& completed,std::uint32_t& stamp,std::uint32_t* flags,RunnerRetainedLayerState&){
+            auto& c=*static_cast<Context*>(p);completed=c.prefix;stamp=c.clock;c.clock+=completed;
+            flags[0]=flags[1]=0;
+            CHECK(c.room->bindTerrainSpan(id.handle.slot+8,completed,key(100)));
+            return completed==cells.count?Native::SpanResult::success:Native::SpanResult::failure;
+        };
+        CHECK(native.bind(binding));bool effects=true;
+        CHECK(native.constructPrepared(51,effects,{cells,8,128,true})==(prefix==8));
+        CHECK(native.size()==prefix);
+        for(unsigned i=0;i<32;++i)CHECK(room.contains(i+8)==(i<prefix));
+        if(prefix!=8)continue;
+        for(unsigned i=0;i<8;++i){
+            const auto before=native.roomState(i);
+            RunnerRetainedLayerState layer;layer.layer=2;layer.publishedId=42;layer.order.serial={100+i,0};
+            native.setLayerState(i,layer);CHECK(native.roomState(i).same(before));
+        }
+        CHECK(native.valid());CHECK(native.clear());
+        for(unsigned i=0;i<32;++i)CHECK(!room.contains(i+8));
+        CHECK(native.append(60,16,32));CHECK(room.contains(8));
+        CHECK(native.append(60,32,32));CHECK(room.contains(9));
+        CHECK(native.clear());
+    }
+}
+#endif
+int main(){
+#ifdef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+    nativeReservations();
+#endif
+    Terrain terrain;Room room;RunnerRoomMembership<48> reference;
+    CHECK(room.bindTerrain(terrain));
+    unsigned comparisons=0;
+    auto compare=[&]{
+        for(unsigned s=0;s<48;++s){CHECK(room.contains(s)==reference.contains(s));
+            CHECK(room.active(s)==reference.active(s));CHECK(room.marked(s)==reference.marked(s));}
+        std::vector<unsigned> a,b;
+        CHECK(room.visitAnimationChecked([&](unsigned s){a.push_back(s);return true;}));
+        CHECK(reference.visitAnimationChecked([&](unsigned s){b.push_back(s);return true;}));CHECK(a==b);
+        a.clear();b.clear();
+        CHECK(room.visitDrawChecked([&](unsigned s){a.push_back(s);return true;}));
+        CHECK(reference.visitDrawChecked([&](unsigned s){b.push_back(s);return true;}));CHECK(a==b);
+        a.clear();b.clear();
+        terrain.reads=terrain.walks=0;
+        Room::AnimationCursor cursor(room,8,40);
+        while(cursor.slot()!=48)a.push_back(cursor.take());
+        CHECK(terrain.reads==0&&terrain.walks==0);
+        CHECK(reference.visitAnimationChecked([&](unsigned s){if(s<8||s>=40)b.push_back(s);return true;}));CHECK(a==b);
+        ++comparisons;
+    };
+    auto bind=[&](unsigned s,int depth){CHECK(room.bind(s,key(depth))&&reference.bind(s,key(depth)));};
+    bind(0,0);bind(47,0);
+    CHECK(room.bindTerrainSpan(8,32,key(0)));
+    for(unsigned s=8;s<40;++s)CHECK(reference.bind(s,key(0)));
+    bind(3,-1);bind(42,1);compare();
+    unsigned random=123456;
+    for(unsigned i=0;i<800;++i){
+        random=random*1664525u+1013904223u;
+        const unsigned s=(random>>8)%48,op=(random>>24)%4;
+        if(op==0)bind(s,int(random%3)-1);
+        else if(op==1){CHECK(room.remove(s)==reference.remove(s));}
+        else if(op==2){CHECK(room.mark(s)==reference.mark(s));}
+        else{
+            RunnerActivationChanges<48> changed;changed.mark(s);changed.mark((s+9)%48);
+            auto select=[&](unsigned first,unsigned end){return changed.next(first,end);};
+            auto inactive=[&](unsigned x){return ((x+random)%5)<3;};
+            std::vector<std::pair<unsigned,bool>> a,b;
+            terrain.walks=0;
+            CHECK(room.reconcileSelectedChecked(select,inactive,[&](unsigned x,bool active){a.emplace_back(x,active);return true;}));
+            CHECK(terrain.walks==0);
+            // The scalar room has no changed-set overload. Unselected flags
+            // retain their reconciled state, making its full pass the oracle.
+            CHECK(reference.reconcileChecked([&](unsigned x){return select(x,x+1)==x?inactive(x):!reference.active(x);},
+                [&](unsigned x,bool active){b.emplace_back(x,active);return true;}));CHECK(a==b);
+        }
+        compare();
+    }
+    std::vector<unsigned> a,b;
+    terrain.walks=0;
+    CHECK(room.visitMarkedCleanupChecked([&](unsigned s){a.push_back(s);room.remove(s);room.mark((s+1)%48);return true;}));
+    CHECK(terrain.walks==0);
+    // Use the raw source room traversal here: its saved successor is the next
+    // room member, not the scalar helper's pre-existing marked successor.
+    CHECK(reference.visitCleanupChecked([&](unsigned s){if(reference.marked(s)){
+        b.push_back(s);reference.remove(s);reference.mark((s+1)%48);}return true;}));
+    CHECK(a==b);compare();
+    room.clear();reference.clear();compare();
+    std::printf("Sparse room: %u state/order comparisons; native animation and changed passes never enumerate terrain\n",comparisons);
+}
