+bool AmigaGameplayGeneration::createPreparedGroup(void* opaque,
+    const downwell::AreaOneBuilder::PreparedTerrainGroup& group,bool& handled){
+    auto& self=*static_cast<AmigaGameplayGeneration*>(opaque);
+    handled=false;
+    if(self.sourceCreate_||!self.runtime_||!self.lifetimes_||!self.runtime_->terrainCreatesBackendOnly()||
+       self.runtime_->nativeTerrainInstances()!=self.lifetimes_)return true;
+    const auto* controller=self.runtime_->builderController();
+    if(!controller||!controller->hasBorrowedPositionPublication(group.x(),group.finalY()))return true;
+    TerrainLifetimes::PreparedCells rows[16];unsigned count=0,walls=0,platforms=0;
+    for(unsigned i=0;i<group.size();++i){
+        const auto batch=group.segment(i);
+        if(!amigaAdmitPreparedTerrain(self.index_,self.tiles_,batch))return true;
+        platforms+=batch.platforms();walls+=batch.count()-batch.platforms();
+        if(batch.count())rows[count++]={batch.creates(),batch.count(),batch.y,true};
+    }
+    if(count<2||platforms>AmigaTerrainTiles::capacity-self.tiles_.size()||
+       walls>self.index_.extraContacts.capacity()-self.index_.extraContacts.size())return true;
+    // All remaining per-row operations are admitted bounded stores, exact RNG
+    // advances and borrowed controller setters. No external reader runs until
+    // the next event cell. Publish ownership once, retaining each row's geometry.
+    const auto result=self.runtime_->constructNativeTerrainGroup(rows,count);
+    if(result==TerrainLifetimes::SpanResult::unsupported)return true;
+    handled=true;
+    if(result!=TerrainLifetimes::SpanResult::success)return false;
+    return group.execute([&](const downwell::AreaOneBuilder::PreparedTerrain& batch){
+        if(!batch.beginPublication())return false;
+        if(batch.count()){
+            if(batch.y-24<self.dirtyFirst)self.dirtyFirst=batch.y-24;
+            if(batch.y+24>self.dirtyEnd)self.dirtyEnd=batch.y+24;
+        }
+        if(!amigaPublishPreparedTerrain(self.index_,self.tiles_,batch))return false;
+        batch.completePublication();return true;
+    });
 }
 
