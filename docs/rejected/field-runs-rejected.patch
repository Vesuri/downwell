diff --git a/src/platform/amiga/AmigaFieldRuns.h b/src/platform/amiga/AmigaFieldRuns.h
new file mode 100644
index 00000000..74ff049d
--- /dev/null
+++ b/src/platform/amiga/AmigaFieldRuns.h
@@ -0,0 +1,76 @@
+#ifndef DOWNWELL_AMIGA_FIELD_RUNS_H
+#define DOWNWELL_AMIGA_FIELD_RUNS_H
+#include "AmigaFieldColumns.h"
+namespace downwell_field_runs {
+inline void markRows(UWORD* rows,unsigned first,unsigned count){
+    if(!rows)return;
+    while(count){
+        const unsigned bit=first&15,part=count<16-bit?count:16-bit;
+        rows[first/16]|=UWORD(((0xffffu>>(16-part))<<bit));
+        first+=part;count-=part;
+    }
+}
+template<bool Restore> void strip(const UBYTE* terrain,UBYTE* target,
+    const unsigned short* pixels,unsigned offset,unsigned physical,unsigned count,
+    unsigned shift,unsigned leftMask,unsigned rightMask,UWORD* rows){
+    using namespace downwell_field_columns;
+    const bool whole=leftMask==0xffffu&&(!shift||rightMask==0xffffu);
+    // Interior runs contain coverage on every row. Mark once per run, not
+    // once per word (or per colour plane). Edge clipping needs exact pixels.
+    if(whole)markRows(rows,physical,count);
+    for(unsigned i=0;i<count;++i,pixels+=2,offset+=24){
+        bool touched;
+        if(!shift)touched=paint<Restore>(terrain,target,offset,pixels[0],pixels[1],leftMask);
+        else{
+            touched=paint<Restore>(terrain,target,offset,pixels[0]>>shift,pixels[1]>>shift,leftMask);
+            touched=paint<Restore>(terrain,target,offset+1,
+                (unsigned(pixels[0])<<(16-shift))&0xffffu,
+                (unsigned(pixels[1])<<(16-shift))&0xffffu,rightMask)||touched;
+        }
+        if(rows&&!whole&&touched)rows[(physical+i)/16]|=UWORD(1u<<((physical+i)&15));
+    }
+}
+template<bool Restore> void transfer(const UBYTE* terrain,UBYTE* target,
+    const downwell::TimeFieldOutlines::Circle& circle,unsigned origin,UWORD* rows){
+    using namespace downwell;
+    if(circle.x<=downwellPlayfieldX-132||circle.x>=downwellPlayfieldX+downwellPlayfieldWidth+132||
+       circle.y<=-132||circle.y>=downwellDisplayHeight+132)return;
+    int base=(circle.x-14)/16,shift=(circle.x-14)%16;
+    if(shift<0){shift+=16;--base;}
+    int first=6-base-(shift!=0),end=17-base;
+    if(first < -8)first=-8;
+    if(end>10)end=10;
+    if(first>=end)return;
+    static const UWORD clip[24]={0,0,0,0,0,0,0x0003,
+        0xffff,0xffff,0xffff,0xffff,0xffff,0xffff,0xffff,0xffff,0xffff,0xfffc};
+    const auto* frame=fieldColumnFrames[fieldColumnRadii[circle.radius-128*256]];
+    for(int col=first;col<end;++col){
+        const unsigned column=frame[col+8];
+        const int x=base+col;
+        const unsigned left=clip[x],right=shift?clip[x+1]:0;
+        for(unsigned r=fieldColumnRunOffsets[column];r<fieldColumnRunOffsets[column+1];++r){
+            const auto& run=fieldColumnRuns[r];
+            int y=circle.y+run.row,skip=0,count=run.count;
+            if(y<0){skip=-y;count-=skip;y=0;}
+            if(y+count>downwellDisplayHeight)count=downwellDisplayHeight-y;
+            if(count<=0)continue;
+            unsigned physical=origin+unsigned(y);
+            if(physical>=downwellGameRingHeight)physical-=downwellGameRingHeight;
+            const unsigned initial=unsigned(count)<downwellGameRingHeight-physical?
+                unsigned(count):downwellGameRingHeight-physical;
+            const auto* pixels=fieldColumnRunPixels+run.pixels+2*skip;
+            strip<Restore>(terrain,target,pixels,physical*24+x,physical,initial,shift,left,right,rows);
+            if(initial<unsigned(count))strip<Restore>(terrain,target,pixels+2*initial,x,0,
+                unsigned(count)-initial,shift,left,right,rows);
+        }
+    }
+}
+}
+inline bool amigaFieldRuns(const UBYTE* terrain,UBYTE* target,
+    const downwell::TimeFieldOutlines::Circle& circle,unsigned origin,bool restore,UWORD* rows=nullptr){
+    if(origin>=downwellGameRingHeight||circle.radius<128*256||circle.radius>=130*256)return false;
+    if(restore)downwell_field_runs::transfer<true>(terrain,target,circle,origin,nullptr);
+    else downwell_field_runs::transfer<false>(terrain,target,circle,origin,rows);
+    return true;
+}
+#endif
