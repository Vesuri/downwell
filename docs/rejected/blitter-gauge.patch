+/* Blit setup costs about as much as CPU-filling eight rows of both planes. */
+static int blitHudWordColumn(AmigaRenderer* renderer, unsigned word, int top,
+                             int bottom, UWORD mask, UWORD low, UWORD high) {
+    AmigaWordBlit blit;
+    unsigned plane;
+    if (!renderer->wordBlit || bottom - top < 8 || top < 0 ||
+        bottom > downwellDisplayHeight || word >= downwellBytesPerPlaneLine/2) return 0;
+    /* A is the constant mask, B the constant colour; AB + !AC keeps the rest. */
+    blit.a = 0; blit.b = 0; blit.adat = mask; blit.firstMask = blit.lastMask = 0xffff;
+    blit.amod = blit.bmod = 0; blit.dmod = downwellBytesPerPlaneLine - 2;
+    blit.words = 1; blit.rows = (UWORD)(bottom - top); blit.minterm = 0xca;
+    for (plane = 0; plane < 2; ++plane) {
+        blit.d = renderer->hud + plane*downwellPlaneBytes + top*downwellBytesPerPlaneLine + word*2;
+        blit.bdat = plane ? high : low;
+        /* The CPU fill is idempotent, so it may follow a partial blit. */
+        if (!renderer->wordBlit(&blit)) return 0;
+    }
+    return 1;
+}
