 }
 int amigaBlitterSolidRect(UBYTE*, UWORD, UWORD, UWORD, UWORD, UWORD, UWORD) { return 0; }
 
+// Hardware word-blit semantics: per-word minterm over A, B and C (= D), with
+// the first/last word masks applied to A whether it is fetched or constant.
+static unsigned emulatedWordBlits;
+static int emulateWordBlit(const AmigaWordBlit* blit) {
+    auto load = [](const UBYTE* at) { return UWORD((at[0] << 8) | at[1]); };
+    const UBYTE* a = blit->a;
+    const UBYTE* b = blit->b;
+    UBYTE* d = blit->d;
+    for (unsigned row = 0; row < blit->rows; ++row) {
+        for (unsigned word = 0; word < blit->words; ++word) {
+            UWORD av = a ? load(a) : blit->adat;
+            if (word == 0) av &= blit->firstMask;
+            if (word + 1 == blit->words) av &= blit->lastMask;
+            const UWORD bv = b ? load(b) : blit->bdat, cv = load(d);
+            UWORD result = 0;
+            for (unsigned term = 0; term < 8; ++term)
+                if (blit->minterm & (1u << term))
+                    result |= UWORD((term & 4 ? av : ~av) & (term & 2 ? bv : ~bv) & (term & 1 ? cv : ~cv));
+            d[0] = UBYTE(result >> 8); d[1] = UBYTE(result);
+            if (a) a += 2;
+            if (b) b += 2;
+            d += 2;
+        }
+        if (a) a += blit->amod;
+        if (b) b += blit->bmod;
+        d += blit->dmod;
+    }
+    ++emulatedWordBlits;
+    return 1;
+}
