index 8f2ccba7..3ca1c902 100644
--- a/src/platform/amiga/AmigaBlitter.cpp
+++ b/src/platform/amiga/AmigaBlitter.cpp
@@ -1,5 +1,7 @@
+#include <hardware/blit.h>
 #include "framework/AmigaHardware.h"
 #include "framework/Bitmap.h"
+#include "AmigaRenderer.h"
 
 #include <exec/types.h>
 inline void* operator new(__SIZE_TYPE__, void* address) noexcept { return address; }
@@ -77,3 +79,32 @@ extern "C" int amigaBlitterSolidRect(UBYTE* destination, UWORD targetHeight,
     AmigaHardware::blitterDrain();
     return 1;
 }
+
+extern "C" int amigaBlitterWords(const AmigaWordBlit* blit)
+{
+    const UBYTE* const pointers[] = {blit->a, blit->b, blit->d};
+    for (const UBYTE* pointer : pointers)
+        if ((ULONG)pointer >= 0x200000UL || ((ULONG)pointer & 1)) return 0;
+    if (!blit->d || !blit->words || blit->words > 64 || !blit->rows || blit->rows > 1024)
+        return 0;
+    // C is fetched only when the minterm depends on it; D always replaces it.
+    const UWORD minterm = blit->minterm;
+    const bool useC = ((minterm ^ (minterm >> 1)) & 0x55) != 0;
+    AmigaHardware::blitterDrain();
+    *bltcon0Pointer = (uint16_t)((blit->a ? BC0F_SRCA : 0) | (blit->b ? BC0F_SRCB : 0) |
+        (useC ? BC0F_SRCC : 0) | BC0F_DEST | minterm);
+    *bltcon1Pointer = 0;
+    *bltafwmPointer = blit->firstMask;
+    *bltalwmPointer = blit->lastMask;
+    if (blit->a) { *bltamodPointer = blit->amod; *bltaptPointer = (uint16_t*)blit->a; }
+    else *bltadatPointer = blit->adat;
+    if (blit->b) { *bltbmodPointer = blit->bmod; *bltbptPointer = (uint16_t*)blit->b; }
+    else *bltbdatPointer = blit->bdat;
+    *bltcmodPointer = blit->dmod;
+    *bltdmodPointer = blit->dmod;
+    *bltcptPointer = (uint16_t*)blit->d;
+    *bltdptPointer = (uint16_t*)blit->d;
+    *bltsizePointer = (uint16_t)(((blit->rows & 1023) << 6) | (blit->words & 63));
+    AmigaHardware::blitterWait();
+    return 1;
+}
