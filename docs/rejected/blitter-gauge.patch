+/* One aligned blitter operation, D = minterm(A, B, C) with C read from D.
+   A and B are DMA sources when non-null, otherwise the constants adat/bdat.
+   As in hardware, firstMask and lastMask apply to A (both to a one-word
+   row). Modulos are bytes added after each row. Returns 0 when declined. */
+typedef struct AmigaWordBlit {
+    const UBYTE* a;
+    const UBYTE* b;
+    UBYTE* d;
+    UWORD adat, bdat, firstMask, lastMask;
+    WORD amod, bmod, dmod;
+    UWORD words, rows;
+    UBYTE minterm;
+} AmigaWordBlit;
+typedef int (*AmigaWordBlitter)(const AmigaWordBlit*);
+/* Complete before returning. Declines anything outside Chip RAM. */
+int amigaBlitterWords(const AmigaWordBlit*);
