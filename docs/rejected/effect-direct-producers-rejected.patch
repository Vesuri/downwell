diff --git a/tests/core/DeferredPaletteEffectsTest.cpp b/tests/core/DeferredPaletteEffectsTest.cpp
new file mode 100644
index 00000000..e9ec093b
--- /dev/null
+++ b/tests/core/DeferredPaletteEffectsTest.cpp
@@ -0,0 +1,81 @@
+#include "core/DeferredPaletteEffects.h"
+#include <array>
+#include <cassert>
+#include <climits>
+#include <cstdio>
+using Raster=downwell::PaletteEffectSurface<64,48>;
+using Deferred=downwell::DeferredPaletteEffects<64,48,32>;
+int main(){
+    Deferred surface;Raster reference;
+    std::uint8_t bank[16][120];
+    surface.bindImmutableRange(&bank[0][0],&bank[0][0]+sizeof(bank));
+    std::uint32_t rng=19;auto next=[&](){rng=rng*1664525u+1013904223u;return rng;};
+    unsigned checks=0;
+    const auto compare=[&](){
+        std::array<int,64*48> expected,actual;expected.fill(-1);actual.fill(-1);
+        auto painter=[](auto& output){return [&](unsigned x,unsigned y,std::uint16_t a,
+            std::uint16_t low,std::uint16_t high){
+            for(unsigned bit=0;bit<16;++bit)if(a&(0x8000u>>bit))
+                output[y*64+x+bit]=!!(low&(0x8000u>>bit))+2*!!(high&(0x8000u>>bit));
+            return true;
+        };};
+        reference.visit(painter(expected));
+        if(surface.usesRaster())surface.visit(painter(actual));else surface.visitContributions(painter(actual));
+        assert(actual==expected);
+        assert(reference.samePixels(surface.raster())); // Readback must not disable deferred rendering.
+        for(unsigned q=0;q<64;++q){
+            const int l=int(next()%90)-20,t=int(next()%70)-15;
+            const int r=l+next()%40,b=t+next()%30;
+            assert(surface.intersects(l,t,r,b)==reference.intersects(l,t,r,b));++checks;
+        }
+        assert(surface.intersects(INT_MIN,INT_MIN,INT_MAX,INT_MAX)==reference.intersects(INT_MIN,INT_MIN,INT_MAX,INT_MAX));
+    };
+    for(unsigned trial=0;trial<256;++trial){
+        surface.clear();reference.clear();
+        for(auto& image:bank)for(auto& value:image)value=std::uint8_t(next()>>24);
+        for(unsigned i=0;i<16;++i){
+            const unsigned width=1+next()%29,height=1+next()%10;
+            const Raster::Asset a{{bank[i],40,width,height,4},bank[i]+40,bank[i]+80};
+            const int x=int(next()%90)-20,y=int(next()%70)-15;
+            if(i%3==2){assert(surface.subtract(a.alpha,x,y));assert(reference.subtract(a.alpha,x,y));}
+            else{assert(surface.add(a,x,y));assert(reference.add(a,x,y));}
+            compare();assert(!surface.usesRaster());
+        }
+    }
+    // Mutable unknown sources must be consumed before the caller edits them.
+    std::uint8_t dot[]={0x80,0},black[]={0,0};
+    const Raster::Asset a{{dot,2,1,1,2},black,black};
+    surface.clear();reference.clear();
+    assert(surface.add(a,3,5)&&reference.add(a,3,5));assert(surface.usesRaster());
+    dot[0]=0;compare();dot[0]=0x80;
+    assert(surface.subtract(a.alpha,3,5)&&reference.subtract(a.alpha,3,5));compare();
+    surface.clear();reference.clear();compare();assert(!surface.usesRaster());
+    // Capacity exhaustion materializes the complete prefix in original order.
+    downwell::DeferredPaletteEffects<64,48,4> small;
+    small.bindImmutableRange(&bank[0][0],&bank[0][0]+sizeof(bank));
+    for(unsigned i=0;i<5;++i){
+        const Raster::Asset item{{bank[i],40,29,10,4},bank[i]+40,bank[i]+80};
+        assert(small.add(item,i*3,i));assert(reference.add(item,i*3,i));
+    }
+    assert(small.usesRaster()&&reference.samePixels(small.raster()));
+    auto bad=a;bad.alpha.bytes=0;assert(!surface.add(bad,0,0));
+    assert(surface.add(a,INT_MIN,INT_MAX));
+    // A queued raster backend must consume unknown borrowed data before the
+    // caller can mutate it, not on the subsequent visibility query.
+    struct Queued{
+        std::uint16_t alpha[4*48]{},low[4*48]{},high[4*48]{};
+        const std::uint8_t* pending=nullptr;
+        bool flushed=false;
+    } queue;
+    Deferred borrowed;
+    assert(borrowed.rasterForBinding().bindStorage(queue.alpha,queue.low,queue.high,4,{&queue,
+        [](void* p,const Raster::Mask& m,const std::uint8_t*,const std::uint8_t*,int,int){
+            static_cast<Queued*>(p)->pending=m.data;return true;
+        },[](void* p,unsigned,unsigned){static_cast<Queued*>(p)->pending=nullptr;},
+        [](void* p){auto& q=*static_cast<Queued*>(p);if(q.pending){
+            q.alpha[0]=std::uint16_t(q.pending[0])<<8;q.pending=nullptr;q.flushed=true;
+        }}}));
+    assert(borrowed.add(a,0,0)&&queue.flushed&&!queue.pending);
+    dot[0]=0;assert(borrowed.intersects(0,0,1,1));
+    std::printf("Deferred effects: 4096 ordered color/shade comparisons, %u exact queries, mutable and capacity fallbacks passed\n",checks);
+}
