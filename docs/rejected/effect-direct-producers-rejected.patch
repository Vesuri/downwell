diff --git a/src/core/DeferredPaletteEffects.h b/src/core/DeferredPaletteEffects.h
new file mode 100644
index 00000000..2b11c46b
--- /dev/null
+++ b/src/core/DeferredPaletteEffects.h
@@ -0,0 +1,140 @@
+#ifndef DOWNWELL_CORE_DEFERRED_PALETTE_EFFECTS_H
+#define DOWNWELL_CORE_DEFERRED_PALETTE_EFFECTS_H
+#include "PaletteEffectSurface.h"
+#include <cstddef>
+#include <cstdint>
+
+namespace downwell {
+// Retain immutable producers, not their intermediate viewport raster. Each
+// contribution loses the alpha of all later subtractions. Publishing the
+// surviving contributions in order is equivalent to the scalar surface,
+// including opaque black and an add following a subtract. Borrowed source
+// ranges must stay alive and immutable until clear(). Everything else is
+// copied immediately through the retained raster path.
+template<unsigned Width=160,unsigned Height=284,unsigned Capacity=128>
+class DeferredPaletteEffects {
+    static_assert(Capacity>0,"producer command capacity must be nonzero");
+public:
+    using Raster=PaletteEffectSurface<Width,Height>;
+    using Mask=typename Raster::Mask;
+    using Asset=typename Raster::Asset;
+    void bindImmutableRange(const std::uint8_t* begin,const std::uint8_t* end){
+        begin_=reinterpret_cast<std::uintptr_t>(begin);
+        end_=reinterpret_cast<std::uintptr_t>(end);
+    }
+    // Startup-only hook for a platform's retained raster backend.
+    Raster& rasterForBinding(){return raster_;}
+    const Raster& raster()const{materialize();return raster_;}
+    bool usesRaster()const{return fallback_;}
+    void clear(){
+        if(materialized_)raster_.clear();
+        count_=0;fallback_=false;materialized_=false;
+    }
+    bool add(const Asset& a,int x,int y){
+        if(!a.low||!a.high)return false;
+        return append(a,x,y,false);
+    }
+    bool subtract(const Mask& m,int x,int y){return append({m,nullptr,nullptr},x,y,true);}
+    bool intersects(int left,int top,int right,int bottom)const{
+        if(fallback_)return raster_.intersects(left,top,right,bottom);
+        bool found=false;
+        contributions<false>(left,top,right,bottom,[&](unsigned,unsigned,std::uint16_t,
+            std::uint16_t,std::uint16_t){found=true;return false;});
+        return found;
+    }
+    // Final composed pixels for a reference consumer. Does not change the
+    // normal direct-publication route; oracle reads must not test the fallback
+    // instead of the implementation they are meant to verify.
+    template<class Emit> void visit(Emit emit)const{raster().visit(emit);}
+    template<class Emit> void visitContributions(Emit emit)const{
+        contributions<true>(0,0,Width,Height,emit);
+    }
+    template<class Emit> void visitBounds(Emit emit)const{
+        for(unsigned i=0;i<count_;++i){
+            const auto& c=commands_[i];if(c.subtract)continue;
+            const int top=c.y<0?0:c.y;
+            const int bottom=c.y+int(c.asset.alpha.height)>int(Height)?Height:c.y+int(c.asset.alpha.height);
+            emit(unsigned(top),unsigned(bottom-top));
+        }
+    }
+private:
+    struct Command{Asset asset;int x,y;bool subtract;};
+    Command commands_[Capacity];
+    unsigned count_=0;
+    std::uintptr_t begin_=0,end_=0;
+    mutable Raster raster_;
+    mutable bool materialized_=false;
+    bool fallback_=false;
+    bool immutable(const std::uint8_t* p,unsigned bytes)const{
+        const auto address=reinterpret_cast<std::uintptr_t>(p);
+        return begin_&&address>=begin_&&address<=end_&&bytes<=end_-address;
+    }
+    void materialize()const{
+        if(materialized_)return;
+        raster_.clear();
+        for(unsigned i=0;i<count_;++i){const auto& c=commands_[i];
+            if(c.subtract)raster_.subtract(c.asset.alpha,c.x,c.y);
+            else raster_.add(c.asset,c.x,c.y);
+        }
+        materialized_=true;
+    }
+    bool append(const Asset& a,int x,int y,bool subtract){
+        const auto& m=a.alpha;
+        if(!m.data||!m.width||m.width>65535||!m.height||m.height>65535||
+           m.stride>8192||m.stride<(m.width+7)/8||m.bytes<m.stride*m.height)return false;
+        if(x>=int(Width)||y>=int(Height)||x<=-int(m.width)||y<=-int(m.height))return true;
+        if(!fallback_&&(count_==Capacity||!immutable(m.data,m.bytes)||
+            (!subtract&&(!immutable(a.low,m.bytes)||!immutable(a.high,m.bytes))))){
+            materialize();fallback_=true;
+        }
+        if(fallback_){
+            const bool okay=subtract?raster_.subtract(m,x,y):raster_.add(a,x,y);
+            raster_.finishWrites();return okay;
+        }
+        commands_[count_++]={a,x,y,subtract};materialized_=false;return true;
+    }
+    static std::uint16_t word(const Command& c,const std::uint8_t* pixels,int x,int y){
+        const auto& m=c.asset.alpha;
+        if(y<c.y||y>=c.y+int(m.height))return 0;
+        const int left=x>c.x?x:c.x;
+        const int right=x+16<c.x+int(m.width)?x+16:c.x+int(m.width);
+        if(left>=right)return 0;
+        const unsigned sx=unsigned(left-c.x),byte=sx/8;
+        const auto* row=pixels+unsigned(y-c.y)*m.stride;
+        std::uint32_t bits=std::uint32_t(row[byte])<<16;
+        if(byte+1<m.stride)bits|=std::uint32_t(row[byte+1])<<8;
+        if(byte+2<m.stride)bits|=row[byte+2];
+        bits=(bits>>(8-sx%8))&0xffffu;
+        bits&=0xffffu<<(16-unsigned(right-left));
+        return std::uint16_t(bits>>unsigned(left-x));
+    }
+    template<bool Colors,class Emit>
+    void contributions(int left,int top,int right,int bottom,Emit emit)const{
+        if(left<0)left=0;
+        if(top<0)top=0;
+        if(right>int(Width))right=Width;
+        if(bottom>int(Height))bottom=Height;
+        if(left>=right||top>=bottom)return;
+        for(unsigned i=0;i<count_;++i){
+            const auto& c=commands_[i];if(c.subtract)continue;
+            const auto& m=c.asset.alpha;
+            const int l=left>c.x?left:c.x,r=right<c.x+int(m.width)?right:c.x+int(m.width);
+            const int t=top>c.y?top:c.y,b=bottom<c.y+int(m.height)?bottom:c.y+int(m.height);
+            if(l>=r||t>=b)continue;
+            for(int y=t;y<b;++y)for(int x=(l/16)*16;x<r;x+=16){
+                std::uint16_t alpha=word(c,m.data,x,y);
+                if(x<l)alpha&=std::uint16_t(0xffffu>>(l-x));
+                if(r-x<16)alpha&=std::uint16_t(0xffffu<<(16-(r-x)));
+                for(unsigned j=i+1;alpha&&j<count_;++j)
+                    if(commands_[j].subtract)
+                        alpha&=std::uint16_t(~word(commands_[j],commands_[j].asset.alpha.data,x,y));
+                if(!alpha)continue;
+                std::uint16_t low=0,high=0;
+                if constexpr(Colors){low=word(c,c.asset.low,x,y)&alpha;high=word(c,c.asset.high,x,y)&alpha;}
+                if(!emit(unsigned(x),unsigned(y),alpha,low,high))return;
+            }
+        }
+    }
+};
+}
+#endif
