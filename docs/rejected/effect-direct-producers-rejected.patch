+bool AmigaEffectSurface::publish(const downwell::DeferredPaletteEffects<>& surface,Bitmap& display,
+    unsigned buffer,unsigned origin,AmigaGameplayRows& rows){
+    if(surface.usesRaster())return publish(surface.raster(),display,buffer,origin,rows);
+    bool started=false;
+    unsigned previousY=downwellGameRingHeight;
+    UBYTE* row=nullptr;
+    const auto merge=[](UBYTE* p,UWORD alpha,UWORD paint){
+        UWORD& word=*reinterpret_cast<UWORD*>(p);
+        word=UWORD((word&~alpha)|(paint&alpha));
+    };
+    surface.visitContributions([&](unsigned x,unsigned y,UWORD alpha,UWORD low,UWORD high){
+        if(!started){AmigaHardware::blitterDrain();started=true;}
+        if(y!=previousY){
+            previousY=y;
+            row=static_cast<UBYTE*>(display.data)+((origin+y)%downwellGameRingHeight)*downwellBytesPerPlaneLine;
+        }
+        constexpr unsigned shift=downwellPlayfieldX%16;
+        auto* destination=row+(downwellPlayfieldX/16+x/16)*2;
+        merge(destination,UWORD(alpha>>shift),UWORD(low>>shift));
+        merge(destination+downwellGameRingPlaneBytes,UWORD(alpha>>shift),UWORD(high>>shift));
+        if constexpr(shift){
+            merge(destination+2,UWORD(unsigned(alpha)<<(16-shift)),UWORD(unsigned(low)<<(16-shift)));
+            merge(destination+2+downwellGameRingPlaneBytes,UWORD(unsigned(alpha)<<(16-shift)),UWORD(unsigned(high)<<(16-shift)));
+        }
+        return true;
+    });
+    if(started)surface.visitBounds([&](unsigned y,unsigned height){
+        rows.damage(origin,y,height,static_cast<UBYTE>(1u<<buffer));
+    });
+    return true;
+}
