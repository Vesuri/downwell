diff --git a/src/core/RunnerRealComparison.h b/src/core/RunnerRealComparison.h
index 4bf0fd9b..9262e0e0 100644
--- a/src/core/RunnerRealComparison.h
+++ b/src/core/RunnerRealComparison.h
@@ -5,7 +5,8 @@ namespace downwell {
 // Finite normal/zero subset of the original runner's real comparison path.
 // Returns -1/0/+1 for delta below -epsilon, inside the band, or above epsilon.
 // Unsupported arithmetic is explicit, not silently interpreted as equality.
-inline bool compareRunnerReal(MotionBinary64 left,MotionBinary64 right,int& order) {
+// The subtracting form: compareRunnerReal's oracle and its general case.
+inline bool compareRunnerRealReference(MotionBinary64 left,MotionBinary64 right,int& order) {
     right.high^=0x80000000u;
     if(!left.add(right)) return false;
     const auto magnitude=left.high&0x7fffffffu;
@@ -14,5 +15,36 @@ inline bool compareRunnerReal(MotionBinary64 left,MotionBinary64 right,int& orde
     order=outside?(left.high&0x80000000u?-1:1):0;
     return true;
 }
+// The same answers without the subtraction where it cannot be near the
+// band (valid inputs below 2^1022, so the difference cannot overflow):
+// identical values, a zero side, opposite signs or exponents two or more
+// apart at magnitudes from 2^-13 (the difference then exceeds 2^-14,
+// well outside epsilon 1e-5). Near-equal pairs subtract.
+inline bool compareRunnerReal(MotionBinary64 left,MotionBinary64 right,int& order) {
+    const unsigned el=(left.high>>20)&2047u,er=(right.high>>20)&2047u;
+    if(el<2046u&&er<2046u&&left.valid()&&right.valid()){
+        if(left.high==right.high&&left.low==right.low){order=0;return true;}
+        const bool lz=left.zero(),rz=right.zero();
+        if(lz&&rz){order=0;return true;}
+        if(lz||rz){
+            const auto& value=rz?left:right;
+            const auto magnitude=value.high&0x7fffffffu;
+            const bool outside=magnitude>0x3ee4f8b5u||(magnitude==0x3ee4f8b5u&&value.low>0x88e368f1u);
+            const bool negative=(value.high>>31)!=0;
+            order=!outside?0:(rz?(negative?-1:1):(negative?1:-1));
+            return true;
+        }
+        const bool ln=(left.high>>31)!=0,rn=(right.high>>31)!=0;
+        const unsigned larger=el>er?el:er;
+        if(larger>=1010u){
+            if(ln!=rn){order=ln?-1:1;return true;}
+            if(el>=er+2u||er>=el+2u){
+                const bool leftBigger=el>er;
+                order=(leftBigger!=ln)?1:-1;return true;
+            }
+        }
+    }
+    return compareRunnerRealReference(left,right,order);
+}
 }
 #endif
