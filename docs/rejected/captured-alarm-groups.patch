index 00000000..64012cf7
--- /dev/null
+++ b/src/core/CapturedAlarmGroups.h
@@ -0,0 +1,31 @@
+#ifndef DOWNWELL_CAPTURED_ALARM_GROUPS_H
+#define DOWNWELL_CAPTURED_ALARM_GROUPS_H
+#include <cstdint>
+namespace downwell {
+// Immutable group boundaries/event columns of one sorted registration capture.
+// Never stores countdowns, eligibility or a current object after mutation.
+template<unsigned Capacity> class CapturedAlarmGroups {
+public:
+    struct Group {std::uint16_t end,mask;};
+    template<class Snapshot,class Metadata>
+    bool prepare(const Snapshot& snapshot,const Metadata& metadata,unsigned& alarms){
+        count_=0;alarms=0;
+        if(snapshot.size()>65535u)return false;
+        for(unsigned first=0;first<snapshot.size();){
+            unsigned mask;
+            if(count_==Capacity||!metadata.mask(snapshot.object(first),mask)||mask>0xfffu)return false;
+            const unsigned end=snapshot.objectGroupEnd(first);
+            if(end<=first||end>snapshot.size())return false;
+            groups_[count_++]={static_cast<std::uint16_t>(end),static_cast<std::uint16_t>(mask)};
+            alarms|=mask;first=end;
+        }
+        return true;
+    }
+    unsigned size()const{return count_;}
+    const Group& group(unsigned i)const{return groups_[i];}
+private:
+    Group groups_[Capacity?Capacity:1]{};
+    unsigned count_=0;
+};
+}
+#endif
