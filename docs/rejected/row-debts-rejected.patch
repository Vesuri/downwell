diff --git a/src/platform/amiga/AmigaRowDebts.h b/src/platform/amiga/AmigaRowDebts.h
new file mode 100644
index 00000000..bdd4f32c
--- /dev/null
+++ b/src/platform/amiga/AmigaRowDebts.h
@@ -0,0 +1,77 @@
+#ifndef DOWNWELL_AMIGA_ROW_DEBTS_H
+#define DOWNWELL_AMIGA_ROW_DEBTS_H
+#include <cstdint>
+
+// Exact physical-row debt. Producers and consumers exchange half-open spans;
+// no per-scanline expansion is needed. At most ceil(Rows/2) nonadjacent runs
+// can exist, including an adversarial alternating-row pattern.
+template<unsigned Rows> class AmigaRowDebts {
+    static_assert(Rows>0&&Rows<65536,"Row endpoints must fit a word");
+    struct Range { std::uint16_t first,end; };
+    Range ranges_[(Rows+1)/2]{};
+    unsigned count_=0;
+    void erase(unsigned first,unsigned end){
+        const unsigned removed=end-first;
+        for(unsigned i=end;i<count_;++i)ranges_[first++]=ranges_[i];
+        count_-=removed;
+    }
+public:
+    void reset(){ranges_[0]={0,Rows};count_=1;}
+    bool contains(unsigned row)const{
+        unsigned lo=0,hi=count_;
+        while(lo<hi){const unsigned mid=(lo+hi)/2;
+            if(row<ranges_[mid].first)hi=mid;
+            else if(row>=ranges_[mid].end)lo=mid+1;
+            else return true;
+        }
+        return false;
+    }
+    void add(unsigned first,unsigned end){
+        if(first>=end)return;
+        unsigned begin=0;
+        while(begin<count_&&ranges_[begin].end<first)++begin;
+        unsigned stop=begin;
+        while(stop<count_&&ranges_[stop].first<=end){
+            if(ranges_[stop].first<first)first=ranges_[stop].first;
+            if(ranges_[stop].end>end)end=ranges_[stop].end;
+            ++stop;
+        }
+        if(stop==begin){
+            for(unsigned i=count_;i>begin;--i)ranges_[i]=ranges_[i-1];
+            ++count_;
+        }else if(stop>begin+1)erase(begin+1,stop);
+        ranges_[begin]={std::uint16_t(first),std::uint16_t(end)};
+    }
+    void remove(unsigned first,unsigned end){
+        if(first>=end)return;
+        unsigned begin=0;
+        while(begin<count_&&ranges_[begin].end<=first)++begin;
+        if(begin==count_||ranges_[begin].first>=end)return;
+        if(ranges_[begin].first<first){
+            const unsigned oldEnd=ranges_[begin].end;
+            ranges_[begin++].end=first;
+            if(oldEnd>end){
+                for(unsigned i=count_;i>begin;--i)ranges_[i]=ranges_[i-1];
+                ranges_[begin]={std::uint16_t(end),std::uint16_t(oldEnd)};
+                ++count_;return;
+            }
+        }
+        unsigned stop=begin;
+        while(stop<count_&&ranges_[stop].end<=end)++stop;
+        if(stop<count_&&ranges_[stop].first<end)ranges_[stop].first=end;
+        erase(begin,stop);
+    }
+    bool next(unsigned first,unsigned end,unsigned& top,unsigned& bottom)const{
+        if(first>=end)return false;
+        for(unsigned i=0;i<count_;++i){
+            const auto& range=ranges_[i];
+            if(range.end<=first)continue;
+            if(range.first>=end)break;
+            top=range.first<first?first:range.first;
+            bottom=range.end>end?end:range.end;
+            return true;
+        }
+        return false;
+    }
+};
+#endif
