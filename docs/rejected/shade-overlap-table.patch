diff --git a/tools/generate-amiga-shade-overlap.py b/tools/generate-amiga-shade-overlap.py
new file mode 100644
index 00000000..eb73f20c
--- /dev/null
+++ b/tools/generate-amiga-shade-overlap.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Prepare exact gem/shade alpha-overlap bits, not pre-shaded sprite images."""
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def build(pack):
+    magic, version, header, count, _ = struct.unpack_from('>4sHHI8s', pack)
+    assert (magic, version, header) == (b'DWAP', 2, 20)
+    records = {}
+    for i in range(count):
+        record = struct.unpack_from('>HHhhHHHHII', pack, header + 24*i)
+        records[record[:2]] = record
+
+    def mask(key):
+        r = records[key]
+        width, height, dma, flags, offset, size = r[4:]
+        assert flags == 3 and dma % 16 == 0 and dma >= width
+        stride = dma//8
+        assert size == stride*height*3 and offset+size <= len(pack)
+        raw = pack[offset+2*stride*height:offset+size]
+        rows = [int.from_bytes(raw[y*stride:(y+1)*stride], 'big')
+                >> (dma-width) for y in range(height)]
+        return width, height, rows
+
+    sw, sh, shade = mask((117, 0))
+    bits = bytearray()
+    directory = []
+    for sprite in (133, 134):
+        for frame in range(4):
+            width, height, gem = mask((sprite, frame))
+            columns, rows = sw+width-1, sh+height-1
+            stride = (columns+7)//8
+            offset = len(bits)
+            for dy in range(1-sh, height):
+                row = bytearray(stride)
+                for dx in range(1-sw, width):
+                    shift = sw+dx-width
+                    overlaps = any(gem[y] & (shade[y-dy] >> shift if shift >= 0
+                                             else shade[y-dy] << -shift)
+                                   for y in range(max(0, dy), min(height, dy+sh)))
+                    if overlaps:
+                        column = dx+sw-1
+                        row[column//8] |= 128 >> (column % 8)
+                bits.extend(row)
+            directory.append(dict(sprite=sprite, frame=frame, offset=offset,
+                                  columns=columns, rows=rows, stride=stride,
+                                  firstX=1-sw, firstY=1-sh))
+    return directory, bytes(bits)
+
+
+def main():
+    source = ROOT/'generated/amiga-game.dwap'
+    pack = source.read_bytes()
+    provenance = json.loads((ROOT/'generated/amiga-game.packing.json').read_text())
+    assert hashlib.sha256(pack).hexdigest() == provenance['packSha256']
+    directory, bits = build(pack)
+    # This is an exact full-mask predicate. A runtime consumer must retain
+    # the scalar query for viewport-clipped masks, and admit immutable art.
+    output = ROOT/'generated/amiga-shade-overlap.bin'
+    output.write_bytes(bits)
+    records = [struct.unpack_from('>HHhhHHHHII', pack, 20+i*24)
+               for i in range(struct.unpack_from('>I', pack, 8)[0])]
+    expected = bytearray()
+    descriptors = []
+    for key in [(117, 0)]+[(s, f) for s in (133, 134) for f in range(4)]:
+        r = next(r for r in records if r[:2] == key)
+        stride = r[6]//8
+        size = stride*r[5]
+        descriptors.append((r[4], r[5], stride, len(expected), size))
+        expected.extend(pack[r[8]+2*size:r[8]+3*size])
+    def array(name, typename, values, columns=None):
+        rows = ['{'+','.join(map(str, v))+'}' if isinstance(v, tuple) else str(v) for v in values]
+        return ('static const '+typename+' '+name+'[]'+(f'[{columns}]' if columns else '')+
+                '={\n'+',\n'.join(rows)+'\n};\n')
+    header = '// Generated original-asset overlap predicates; do not commit.\nnamespace downwell_shade_overlap {\n'
+    header += array('bits', 'unsigned char', bits)
+    header += array('masks', 'unsigned short', descriptors, 5)
+    header += array('source', 'unsigned char', expected)
+    header += array('directory', 'unsigned short',
+                    [(d['offset'], d['columns'], d['rows'], d['stride']) for d in directory], 4)
+    header += '}\n'
+    (ROOT/'generated/amiga-shade-overlap.h').write_text(header)
+    manifest = dict(schemaVersion=1, generator='amiga-shade-overlap-v1',
+                    extractor=provenance['extractor'], sourceSha256=provenance['sourceSha256'],
+                    generatorSha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+                    inputPackSha256=hashlib.sha256(pack).hexdigest(),
+                    outputSha256=hashlib.sha256(bits).hexdigest(),
+                    headerSha256=hashlib.sha256(header.encode()).hexdigest(),
+                    bytes=len(bits), directory=directory,
+                    runtimeEnabled=False)
+    (ROOT/'generated/amiga-shade-overlap.json').write_text(json.dumps(manifest, indent=2)+'\n')
+    print(json.dumps(manifest, indent=2))
+
+
+if __name__ == '__main__':
+    main()
