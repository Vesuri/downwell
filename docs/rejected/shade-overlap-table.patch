index 00000000..18003235
--- /dev/null
+++ b/tests/amiga-shade-overlap-test.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Exhaust the overlap bank against independent per-pixel mask intersections."""
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+root = Path(__file__).resolve().parents[1]
+pack = (root/'generated/amiga-game.dwap').read_bytes()
+bits = (root/'generated/amiga-shade-overlap.bin').read_bytes()
+manifest = json.loads((root/'generated/amiga-shade-overlap.json').read_text())
+assert hashlib.sha256(pack).hexdigest() == manifest['inputPackSha256']
+assert hashlib.sha256(bits).hexdigest() == manifest['outputSha256']
+records = {}
+for i in range(struct.unpack_from('>I', pack, 8)[0]):
+    r = struct.unpack_from('>HHhhHHHHII', pack, 20+24*i)
+    records[r[:2]] = r
+
+
+def pixels(key):
+    r = records[key]
+    width, height, stride = r[4], r[5], r[6]//8
+    base = r[8]+2*height*stride
+    return {(x, y) for y in range(height) for x in range(width)
+            if pack[base+y*stride+x//8] & (128 >> (x % 8))}
+
+
+shade = pixels((117, 0))
+checks = 0
+for entry in manifest['directory']:
+    gem = pixels((entry['sprite'], entry['frame']))
+    for row in range(-1, entry['rows']+1):
+        for column in range(-1, entry['columns']+1):
+            dx, dy = column+entry['firstX'], row+entry['firstY']
+            expected = any((x-dx, y-dy) in shade for x, y in gem)
+            actual = (0 <= row < entry['rows'] and 0 <= column < entry['columns'] and
+                      bool(bits[entry['offset']+row*entry['stride']+column//8] &
+                           (128 >> (column % 8))))
+            assert actual == expected, (entry['sprite'], entry['frame'], dx, dy)
+            checks += 1
+print(f'Exact full-mask overlap: {checks} positions agree; {len(bits)} table bytes')
