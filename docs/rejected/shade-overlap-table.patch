+bool AmigaGameplayDrawList::shadeOverlap(bool large,unsigned frame,
+    const downwell::EffectMaskAssets::Asset& gem,const downwell::EffectMaskAssets::Asset& shade,
+    int gx,int gy,int sx,int sy,bool& result)const{
+#ifdef DOWNWELL_REFERENCE_SHADE_OVERLAP
+    (void)large;(void)frame;(void)gem;(void)shade;(void)gx;(void)gy;(void)sx;(void)sy;(void)result;
+    return false;
+#else
+    const unsigned index=(large?4:0)+frame;
+    if(frame>=4||gem.mask.data!=shadeMasks_[index+1]||shade.mask.data!=shadeMasks_[0])return false;
+    // The table describes full masks. Their intersection is wholly visible
+    // when either canvas is inside the viewport; otherwise retain clipping.
+    const auto contained=[](const auto& mask,int x,int y){
+        return x>=0&&y>=0&&x+int(mask.width)<=160&&y+int(mask.height)<=284;
+    };
+    if(!contained(gem.mask,gx,gy)&&!contained(shade.mask,sx,sy))return false;
+    const int x=sx-gx+95,y=sy-gy+95;
+    const auto* d=downwell_shade_overlap::directory[index];
+    result=x>=0&&y>=0&&unsigned(x)<d[1]&&unsigned(y)<d[2]&&
+        (downwell_shade_overlap::bits[d[0]+unsigned(y)*d[3]+unsigned(x)/8]&(128u>>(x&7)));
+    return true;
+#endif
+}
