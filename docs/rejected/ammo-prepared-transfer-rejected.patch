@@ -19,6 +19,51 @@ ROOT = Path(__file__).resolve().parents[1]
 sha = lambda data: hashlib.sha256(data).hexdigest()
 
 
+def transfer_phrases(tiles, pairs):
+    """Offline repeated-pair compression; runtime copies flat final phrases."""
+    ids = {pair:i for i,pair in enumerate(pairs)}
+    originals = [[ids[row] for row in tile] for tile in tiles]
+    sequences = [list(s) for s in originals]
+    words = [(i,) for i in range(len(pairs))]
+    while True:
+        frequencies = collections.Counter()
+        for sequence in sequences:
+            frequencies.update((a,b) for a,b in zip(sequence,sequence[1:])
+                               if len(words[a])+len(words[b]) <= 32)
+        if not frequencies:
+            break
+        def saving(pair):
+            return frequencies[pair]*2-(len(words[pair[0]])+len(words[pair[1]]))*4-4
+        pair = max(frequencies,key=saving)
+        if saving(pair) <= 0:
+            break
+        token = len(words)
+        words.append(words[pair[0]]+words[pair[1]])
+        for sequence in sequences:
+            out, i = [], 0
+            while i < len(sequence):
+                if i+1 < len(sequence) and (sequence[i],sequence[i+1]) == pair:
+                    out.append(token)
+                    i += 2
+                else:
+                    out.append(sequence[i])
+                    i += 1
+            sequence[:] = out
+    assert all(tuple(p for token in seq for p in words[token]) == tuple(original)
+               for seq,original in zip(sequences,originals))
+    used = sorted({token for seq in sequences for token in seq})
+    remap = {token:i for i,token in enumerate(used)}
+    payload, phrases, references, directory = [], [], [], []
+    for token in used:
+        phrases.append((len(payload),len(words[token])))
+        payload.extend(word for p in words[token] for word in pairs[p])
+    for seq in sequences:
+        directory.append((len(references),len(seq)))
+        references.extend(remap[token] for token in seq)
+    assert max(len(payload),len(references),len(phrases)) < 65536
+    return payload, phrases, references, directory
+
+
