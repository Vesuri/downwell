+    // Reset ownership only: readers still use the ordinary complete grid.
+    // End is exclusive; an empty interval has end zero. First admission must
+    // clear arbitrary caller storage before intervals can certify zero bytes.
+    unsigned char writtenFirst[rows]{};
+    unsigned char writtenEnd[rows]{};
+    bool resetAdmitted=false;
+    void noteWrite(unsigned row,unsigned first,unsigned end){
+#ifndef DOWNWELL_REFERENCE_TERRAIN_RESET
+        if(!writtenEnd[row] || first<writtenFirst[row])writtenFirst[row]=first;
+        if(end>writtenEnd[row])writtenEnd[row]=end;
+#else
+        (void)row;(void)first;(void)end;
+#endif
+    }
+    void clearOccupancy(){
+#ifdef DOWNWELL_REFERENCE_TERRAIN_RESET
+        std::memset(cells,0,sizeof(cells));
+#else
+        if(!resetAdmitted)std::memset(cells,0,sizeof(cells));
+        else for(unsigned row=0;row<rows;++row)
+            if(writtenEnd[row])std::memset(cells+row*columns+writtenFirst[row],0,
+                writtenEnd[row]-writtenFirst[row]);
+        std::memset(writtenEnd,0,sizeof(writtenEnd));
+        resetAdmitted=true;
+#endif
+    }
     AmigaLandingIndex nextLanding; // candidate bits; row+1/zero query encoding
