+void verifyOccupancyReset(){
+    AmigaTerrainIndex index;
+    std::memset(index.cells,0xa5,sizeof(index.cells));
+    const AmigaTerrainCollisionContext empty{nullptr,nullptr,nullptr,nullptr,0,nullptr};
+    for(unsigned round=0;round<12;++round){
+        require(amigaBuildTerrainIndex(empty,index),"reset occupancy owner");
+        require(std::all_of(std::begin(index.cells),std::end(index.cells),
+            [](unsigned char c){return c==0;}),"reset clears entire observable grid");
+        for(unsigned row=0;row<512;++row){
+            const unsigned column=(row*37+round*11)%128;
+            require(amigaAddTerrainObject(index,60,-512+16*int(column),16*int(row)),
+                "full-domain reset fixture publication");
+            if(row%3==0)require(amigaRemoveTerrainWall(index,-512+16*int(column),16*int(row)),
+                "removal does not discard reset ownership");
+        }
+        AmigaTerrainTiles tiles;
+        AmigaTerrainRunIndex all(index,60,-512,8176,16,128);
+        require(all.publishSpan(tiles),"full-width row retains exclusive end 128");
+        for(unsigned overlap=0;overlap<260;++overlap)
+            (void)amigaAddTerrainObject(index,60,-512,0);
+        require(!amigaAddTerrainObject(index,60,-512,0),"overflow fixture reaches failed publication");
+    }
+    require(amigaBuildTerrainIndex(empty,index),"final reset after failed publication");
+    require(std::all_of(std::begin(index.cells),std::end(index.cells),
+        [](unsigned char c){return c==0;}),"failed prefix resets exactly");
+}
