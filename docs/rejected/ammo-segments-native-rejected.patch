diff --git a/src/platform/amiga/AmigaAmmoSegmentBank.h b/src/platform/amiga/AmigaAmmoSegmentBank.h
new file mode 100644
index 00000000..e83fc556
--- /dev/null
+++ b/src/platform/amiga/AmigaAmmoSegmentBank.h
@@ -0,0 +1,58 @@
+#ifndef DOWNWELL_AMIGA_AMMO_SEGMENT_BANK_H
+#define DOWNWELL_AMIGA_AMMO_SEGMENT_BANK_H
+#include "AmigaRenderer.h"
+#include "core/AmmoGaugeRows.h"
+#include "../../../generated/amiga-ammo-segments-probe.h"
+
+// Presentation bank for the shared producer's fixed-capacity trajectories.
+// Capacity changes are admitted only after equal-state groups are verified.
+class AmigaAmmoSegmentBank {
+    unsigned capacity_ = 0;
+    bool uniform_ = false;
+public:
+    static bool matches(const AmigaWordStamp* stamps) {
+        for (unsigned i=0;i<10;++i) for (unsigned y=0;y<8;++y)
+            if (stamps[i].low[y]!=downwell_ammo_segments::sourceStamps[i][y][0] ||
+                stamps[i].high[y]!=downwell_ammo_segments::sourceStamps[i][y][1]) return false;
+        return true;
+    }
+    void invalidate() { capacity_ = 0; uniform_ = false; }
+    bool prepare(const downwell::AmmoGaugeRows* rows, unsigned capacity) {
+        if (!rows || !capacity || capacity > 16) { invalidate(); return false; }
+        if (capacity_ != capacity) { capacity_ = capacity; uniform_ = false; }
+        if (!uniform_) {
+            const auto* bounds = downwell_ammo_segments::boundaries[capacity-1];
+            for (unsigned segment=0;segment<capacity;++segment)
+                for (unsigned row=bounds[segment]+1;row<bounds[segment+1];++row)
+                    if (rows->state[row]!=rows->state[bounds[segment]]) return false;
+            uniform_ = true;
+        }
+        return true;
+    }
+    unsigned draw(UBYTE* destination, UBYTE* working, const downwell::AmmoGaugeRows& rows,
+                  unsigned ammo, unsigned meter, int top, int bottom) const {
+        const auto* bounds=downwell_ammo_segments::boundaries[capacity_-1];
+        const unsigned config=downwell_ammo_segments::configStart[capacity_-1]+(ammo*4+meter)*capacity_;
+        unsigned writes=0;
+        for (unsigned segment=0;segment<capacity_;++segment) {
+            int y=229+4*meter-bounds[segment+1]+(segment==capacity_-1 ? 1 : 8);
+            const int end=229+4*meter-bounds[segment]+8;
+            if (y>=bottom || end<=top) continue;
+            const unsigned own=rows.state[bounds[segment]]<4 ? rows.state[bounds[segment]] : 3;
+            const unsigned previous=segment ? (rows.state[bounds[segment-1]]<4 ? rows.state[bounds[segment-1]] : 3) : 0;
+            const auto page=downwell_ammo_segments::configurations[config+segment];
+            const auto tile=downwell_ammo_segments::pages[page][own*4+previous];
+            const auto* directory=downwell_ammo_segments::tiles[tile];
+            for (unsigned i=0;i<directory[1] && y<bottom;++i) {
+                const auto* run=downwell_ammo_segments::runs[directory[0]+i];
+                const auto* pair=downwell_ammo_segments::pairs[run[1]];
+                const int last=y+run[0];
+                if (last>top) writes+=amigaRendererPublishPreparedHudRun(destination,working,
+                    y>top ? y : top,last<bottom ? last : bottom,pair[0],pair[1]);
+                y=last;
+            }
+        }
+        return writes;
+    }
+};
+#endif
