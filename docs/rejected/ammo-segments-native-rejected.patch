diff --git a/src/platform/amiga/AmigaRenderer.c b/src/platform/amiga/AmigaRenderer.c
index 353c9bb5..3cc1cca2 100644
--- a/src/platform/amiga/AmigaRenderer.c
+++ b/src/platform/amiga/AmigaRenderer.c
@@ -702,6 +702,24 @@ unsigned amigaRendererPublishHudColumn(UBYTE* destination, UBYTE* working,
     return writes;
 }
 
+unsigned amigaRendererPublishPreparedHudRun(UBYTE* destination, UBYTE* working,
+    int top, int bottom, UWORD low, UWORD high) {
+    unsigned writes=0;
+    UBYTE* input=working+top*downwellBytesPerPlaneLine+36;
+    UBYTE* target=destination+top*downwellBytesPerPlaneLine+36;
+    for (;top<bottom;++top) {
+        UWORD old=readWord(input), value=(old&15u)|low;
+        if (old!=value) { writeWord(input,value); writeWord(target,value); ++writes; }
+        old=readWord(input+downwellPlaneBytes); value=(old&15u)|high;
+        if (old!=value) {
+            writeWord(input+downwellPlaneBytes,value);
+            writeWord(target+downwellPlaneBytes,value); ++writes;
+        }
+        input+=downwellBytesPerPlaneLine; target+=downwellBytesPerPlaneLine;
+    }
+    return writes;
+}
