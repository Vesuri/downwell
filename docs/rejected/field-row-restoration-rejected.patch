+// Exact screen-row spans, prepared offline from the same raster. Translation
+// and vertical clipping are the only runtime work; no word or row scanning.
+template<class Span> inline bool amigaFieldColumnSpans(
+    const downwell::TimeFieldOutlines::Circle& circle,Span span){
+    using namespace downwell;
+    if(circle.radius<128*256||circle.radius>=130*256)return false;
+    if(circle.x < -21||circle.x>=402)return true;
+    const unsigned x=unsigned(circle.x+21);
+    const unsigned frame=fieldColumnRadii[circle.radius-128*256];
+    const unsigned block=fieldFootprintFrames[frame][x/16];
+    const unsigned pattern=fieldFootprintBlocks[block][x%16];
+    const short* p=fieldFootprintSpans+fieldFootprintOffsets[pattern];
+    const short* end=fieldFootprintSpans+fieldFootprintOffsets[pattern+1];
+    for(;p!=end;p+=2){
+        int first=circle.y+p[0],stop=circle.y+p[1];
+        if(first<0)first=0;
+        if(stop>downwellDisplayHeight)stop=downwellDisplayHeight;
+        if(first<stop)span(unsigned(first),unsigned(stop-first));
+    }
+    return true;
+}
 #endif
