+// Borrowed constructor metadata, not a layer element or an always-active
+// family. Every birth still receives its own retained state and source key.
+// Layer identity/depth are checked before using pointers into reusable slots.
+struct RunnerConstructedSpan {
+    NativeFamilyBirth::Population population;
+    RunnerRegistrationOrder* clock=nullptr;
+    bool* cutoffDirty=nullptr;
+    const bool* present=nullptr;
+    const std::int32_t *id=nullptr,*depth=nullptr;
+    std::int32_t expectedId=-1,expectedDepth=0;
+    unsigned layer=0xffffffffu;
+    bool current()const{return present&&*present&&*id==expectedId&&*depth==expectedDepth;}
+    bool admits(unsigned count)const{
+        return current()&&count&&count<=population.capacity-*population.logical;
+    }
+    bool publish(unsigned count,RunnerRetainedLayerState& first){
+        if(!admits(count))return false;
+        *population.retained+=count;*population.logical+=count;
+        clock->advance();first={{*clock,false},expectedId,layer,false};
+        *clock=clock->shifted(count-1);*cutoffDirty=true;return true;
+    }
+};
 // Terrain supplies layerState(slot/handle) and visitLayerStates(handle,state).
 // Its records own retained state; this adapter owns only physical order keys,
 // per-layer cutoffs and scratch used at logical merge/normalization boundaries.
@@ -150,6 +172,14 @@ public:
         first={stamp(false),Base::get(layer)->id,layer,false};
         clock_=clock_.shifted(count-1);cutoffs_[layer].dirty=true;return true;
     }
+    bool borrowConstructedSpan(unsigned layer,RunnerConstructedSpan& out){
+        const auto* value=Base::get(layer);
+        if(!succeeded()||!value||!Base::borrowRetainedPopulation(layer,out.population))return false;
+        out.clock=&clock_;out.cutoffDirty=&cutoffs_[layer].dirty;
+        out.present=&value->present;out.id=&value->id;out.depth=&value->depth;
+        out.expectedId=value->id;out.expectedDepth=value->depth;out.layer=layer;
+        return true;
+    }
