diff --git a/src/core/AssetCrc32.h b/src/core/AssetCrc32.h
new file mode 100644
index 00000000..66b66dad
--- /dev/null
+++ b/src/core/AssetCrc32.h
@@ -0,0 +1,25 @@
+#ifndef DOWNWELL_ASSET_CRC32_H
+#define DOWNWELL_ASSET_CRC32_H
+#include <cstddef>
+#include <cstdint>
+namespace downwell {
+// Accidental-corruption check for host-certified local assets, not an
+// authentication primitive for untrusted downloads.
+inline std::uint32_t assetCrc32(const std::uint8_t* bytes,std::size_t size){
+    struct Table {
+        std::uint32_t words[256]{};
+        constexpr Table(){
+            for(unsigned i=0;i<256;++i){
+                auto n=std::uint32_t(i);
+                for(unsigned bit=0;bit<8;++bit)n=(n>>1)^((n&1)?0xedb88320u:0u);
+                words[i]=n;
+            }
+        }
+    };
+    static constexpr Table table{};
+    std::uint32_t crc=0xffffffffu;
+    for(std::size_t i=0;i<size;++i)crc=(crc>>8)^table.words[(crc^bytes[i])&255];
+    return crc^0xffffffffu;
+}
+}
+#endif
diff --git a/tools/certify-builder-patterns.py b/tools/certify-builder-patterns.py
new file mode 100644
index 00000000..df314d5b
--- /dev/null
+++ b/tools/certify-builder-patterns.py
@@ -0,0 +1,34 @@
+#!/usr/bin/env python3
+"""Certify the exact local cavern pack with the retained host parser/oracle."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import zlib
+
+ROOT = Path(__file__).resolve().parents[1]
+VERSION = 'certify-builder-patterns/v1'
+
+def main():
+    pack = ROOT / 'generated/downwell-builder-patterns.dwbp'
+    validator = ROOT / 'build/builder-pattern-pack-test'
+    before = pack.read_bytes()
+    subprocess.run([str(validator), str(pack)], check=True)
+    if pack.read_bytes() != before:
+        raise SystemExit('pack changed during certification')
+    crc = zlib.crc32(before)
+    (ROOT / 'generated/amiga-pattern-certificate.h').write_text(
+        f'// {VERSION}; host validated, do not edit.\n#pragma once\n'
+        f'#define DOWNWELL_CERTIFIED_PATTERN_BYTES {len(before)}u\n'
+        f'#define DOWNWELL_CERTIFIED_PATTERN_CRC 0x{crc:08x}u\n')
+    paths = ['data/data.win', 'generated/downwell-builder-patterns.dwbp',
+             'src/core/BuilderPatternPack.cpp', 'src/core/BuilderPatternPack.h',
+             'src/core/AssetCrc32.h', 'tests/core/BuilderPatternPackTest.cpp',
+             'tools/certify-builder-patterns.py', 'build/builder-pattern-pack-test']
+    (ROOT / 'generated/amiga-pattern-certificate.json').write_text(json.dumps({
+        'tool': VERSION, 'crc32': f'{crc:08x}',
+        'inputs': {p: hashlib.sha256((ROOT / p).read_bytes()).hexdigest() for p in paths}
+    }, indent=2)+'\n')
+
+if __name__ == '__main__':
+    main()

