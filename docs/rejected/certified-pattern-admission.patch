+BuilderPatternPack BuilderPatternPack::certifiedLocal(const std::uint8_t* bytes,
+    std::size_t size,std::size_t certifiedSize,std::uint32_t certifiedCrc){
+    BuilderPatternPack result(nullptr,0);
+    if(!bytes||size<headerSize||size!=certifiedSize||assetCrc32(bytes,size)!=certifiedCrc)
+        return result;
+    // Certification is currently for the cavern prepared-program format only.
+    if(u32(bytes)!=0x50425744u||u16(bytes+4)!=formatVersion||
+       u16(bytes+6)!=headerSize||u32(bytes+8)!=manifestSchema||
+       u64(bytes+20)!=sourceHashPrefix)return result;
+    result.bytes_=bytes;
+    result.patternCount_=u32(bytes+12);result.cellCount_=u32(bytes+16);
+    result.rowCount_=u32(bytes+28);result.patternsOffset_=headerSize;
+    result.rowsOffset_=headerSize+result.patternCount_*patternRecordSize;
+    result.cellsOffset_=result.rowsOffset_+result.rowCount_*rowRecordSize;
+    result.preparedOffsets_=bytes+result.cellsOffset_+result.cellCount_+4;
+    result.preparedPrograms_=result.preparedOffsets_+(std::size_t(result.rowCount_)*2+3)*4;
+    result.error_=BuilderPatternPackError::none;
+    return result;
+}
