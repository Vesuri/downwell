diff --git a/tests/platform/amiga/AmigaTerrainWordsTest.cpp b/tests/platform/amiga/AmigaTerrainWordsTest.cpp
new file mode 100644
--- /dev/null
+++ b/tests/platform/amiga/AmigaTerrainWordsTest.cpp
@@ -0,0 +1,79 @@
+#include "platform/amiga/AmigaRenderer.h"
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <vector>
+
+int amigaBlitterDrawPlanarMasked(const UBYTE*, const UBYTE*, UWORD, UWORD,
+    UWORD, UBYTE*, UWORD, UWORD, UWORD, UWORD, UWORD, UWORD, UWORD, int) { return 0; }
+int amigaBlitterClearPlanar(UBYTE*, UWORD, UWORD) { return 0; }
+int amigaBlitterSolidRect(UBYTE*, UWORD, UWORD, UWORD, UWORD, UWORD, UWORD) { return 0; }
+
+static void require(bool ok, const char* message) {
+    if (!ok) { std::cerr << message << '\n'; std::exit(1); }
+}
+static std::vector<UBYTE> read(const char* path) {
+    std::ifstream input(path, std::ios::binary);
+    std::vector<UBYTE> result{std::istreambuf_iterator<char>(input), {}};
+    require(!result.empty(), "asset file missing");
+    return result;
+}
+int main(int argc, char** argv) {
+    require(argc == 3, "usage: terrain-words-test game.dwap terrain.words");
+    const auto pack = read(argv[1]);
+    auto bank = read(argv[2]);
+    AmigaTerrainWords words{};
+    require(amigaRendererBindTerrainWords(&words, bank.data(), bank.data()+bank.size()),
+        "valid terrain bank rejected");
+    // All phases/frames, screen edges, row clips, and wrap across both planes.
+    const int clips[][4] = {{0,0,380,284}, {110,0,160,284}, {113,7,1,273},
+        {0,12,380,1}, {117,265,150,13}, {-5,-7,390,300}};
+    unsigned cases = 0;
+    for (unsigned frame=0; frame<26; ++frame)
+    for (int phase=0; phase<16; ++phase)
+    for (unsigned origin : {0u, 307u, 319u})
+    for (bool hud : {false, true})
+    for (int base : {-16, 96, 256, 368})
+    for (int top : {-15, 0, 8, 269, 283})
+    for (const auto& clip : clips) {
+        std::vector<UBYTE> a(downwellGameRingBytes+32), b;
+        std::vector<UBYTE> ha(downwellLayerBytes+32), hb;
+        // Nonzero destinations detect lost transparency and collateral writes.
+        for (unsigned i=0; i<a.size(); ++i) a[i]=(i*37+frame*13+phase)&255;
+        for (unsigned i=0; i<ha.size(); ++i) ha[i]=(i*71+frame*7+phase)&255;
+        b=a; hb=ha;
+        AmigaRenderer reference{}, candidate{};
+        amigaRendererInit(&reference, a.data()+16, ha.data()+16);
+        amigaRendererInit(&candidate, b.data()+16, hb.data()+16);
+        amigaRendererSetGameOrigin(&reference, origin);
+        amigaRendererSetGameOrigin(&candidate, origin);
+        if (hud) { reference.target=reference.hud; candidate.target=candidate.hud; }
+        amigaRendererSetClipRect(&reference, clip[0],clip[1],clip[2],clip[3]);
+        amigaRendererSetClipRect(&candidate, clip[0],clip[1],clip[2],clip[3]);
+        amigaRendererDrawAsset(&reference, pack.data(), pack.data()+pack.size(),
+            51, frame, base+phase+8, top+8, 0);
+        require(amigaRendererDrawTerrainWords(&candidate, &words, frame, base+phase+8,top+8),
+            "valid tile not handled");
+        if (a!=b || ha!=hb) {
+            std::cerr << "mismatch frame=" << frame << " phase=" << phase
+                << " origin=" << origin << " hud=" << hud << " left=" << base+phase
+                << " top=" << top << " clip=" << clip[0] << ',' << clip[1]
+                << ',' << clip[2] << ',' << clip[3] << '\n';
+            return 1;
+        }
+        ++cases;
+    }
+    AmigaRenderer unused{};
+    require(!amigaRendererDrawTerrainWords(&unused,&words,26,0,0), "invalid frame accepted");
+    for (unsigned offset=0; offset<16; ++offset) {
+        bank[offset]^=1;
+        require(!amigaRendererBindTerrainWords(&words,bank.data(),bank.data()+bank.size()),
+            "invalid header accepted");
+        require(!words.data && !words.frames, "invalid binding retained old bank");
+        bank[offset]^=1;
+    }
+    require(!amigaRendererBindTerrainWords(&words,bank.data(),bank.data()+bank.size()-1),
+        "truncated bank accepted");
+    std::cout << cases << " terrain placements match reference pixels and guard bytes\n";
+}

diff --git a/tools/generate-amiga-terrain-words.py b/tools/generate-amiga-terrain-words.py
new file mode 100644
--- /dev/null
+++ b/tools/generate-amiga-terrain-words.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Prepare all horizontal placements of sprite 51 from offline planar DWAP art."""
+import argparse
+import hashlib
+import json
+import struct
+from pathlib import Path
+
+VERSION = "generate-amiga-terrain-words.py/1"
+SOURCE = "c07daf5fbe940ae0a19503b5ba5137a56ee492753b1cea34b276a5cf7545fdb8"
+
+
+def build(pack):
+    magic, version, header, count, _ = struct.unpack_from(">4sHHI8s", pack)
+    if magic != b"DWAP" or version != 2 or header + count * 24 > len(pack):
+        raise ValueError("unsupported DWAP directory")
+    tiles = {}
+    for i in range(count):
+        sprite, frame, ox, oy, w, h, dw, flags, offset, size = struct.unpack_from(
+            ">HHhhHHHHII", pack, header + i * 24)
+        if sprite != 51:
+            continue
+        if (ox, oy, w, h, dw, flags) != (8, 8, 16, 16, 16, 3):
+            raise ValueError("unexpected sprite-51 geometry/planes")
+        if size < 64 or offset > len(pack) or size > len(pack) - offset or frame in tiles:
+            raise ValueError("invalid tile payload")
+        tiles[frame] = pack[offset:offset + 64]
+    if sorted(tiles) != list(range(26)):
+        raise ValueError("pinned sprite 51 must have frames 0..25")
+    output = bytearray(struct.pack(">4s6H", b"DWTW", 1, 51, 26, 16, 16, 16))
+    for frame in range(26):
+        tile = tiles[frame]
+        for shift in range(16):
+            for row in range(16):
+                low = struct.unpack_from(">H", tile, row * 2)[0] << (16 - shift)
+                high = struct.unpack_from(">H", tile, 32 + row * 2)[0] << (16 - shift)
+                # Renderer transparency is the union of the two colour planes.
+                # Preserve it, including opaque palette-black (pen 3).
+                for bits in (16, 0):
+                    lo, hi = (low >> bits) & 65535, (high >> bits) & 65535
+                    output.extend(struct.pack(">3H", lo | hi, lo, hi))
+    return bytes(output)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--input", type=Path, default=Path("generated/amiga-game.dwap"))
+    parser.add_argument("--output", type=Path, default=Path("generated/amiga-terrain.words"))
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    pack = args.input.read_bytes()
+    provenance = json.loads(args.input.with_suffix(".packing.json").read_text())
+    digest = hashlib.sha256(pack).hexdigest()
