+    if(l<left)l=left;if(t<top)t=top;
+    if(right>left+16)right=left+16;if(bottom>top+16)bottom=top+16;
+    if(l>=right||t>=bottom)return 1;
+    firstWord=l>>4;lastWord=(right-1)>>4;
+    for(column=firstWord;column<=lastWord;++column){
+        UWORD mask=0xffff;
+        if(column==firstWord)mask&=(UWORD)(0xffffu>>(l&15));
+        if(column==lastWord)mask&=(UWORD)(0xffffu<<(15-((right-1)&15)));
+        clips[column-firstWord]=mask;
