+    planeBytes=height*downwellBytesPerPlaneLine;
+    physical=r->target==r->game?(r->gameOrigin+(unsigned)t)%height:(unsigned)t;
+    destination=r->target+physical*downwellBytesPerPlaneLine+firstWord*2;
+    source=words->data+(frame*16+(left&15))*192+(t-top)*12+(firstWord-(left>>4))*6;
+    for(row=t;row<bottom;++row){
+        for(column=0;column<=lastWord-firstWord;++column){
+            const UBYTE* s=source+column*6;
+            UBYTE* d=destination+column*2;
+            const UWORD mask=readWord(s)&clips[column];
+            if(mask){
+                writeWord(d,(readWord(d)&(UWORD)~mask)|(readWord(s+2)&mask));
+                writeWord(d+planeBytes,(readWord(d+planeBytes)&(UWORD)~mask)|(readWord(s+4)&mask));
+            }
+        }
+        source+=12;destination+=downwellBytesPerPlaneLine;
+        if(++physical==height){physical=0;destination=r->target+firstWord*2;}
+    }
+    return 1;
+}
