@@ -0,0 +1,43 @@
+#include "core/EffectCoverageCommands.h"
+#include "core/PaletteEffectSurface.h"
+#include <cassert>
+#include <cstdio>
+#include <cstdint>
+using Surface=downwell::PaletteEffectSurface<64,48>;
+int main() {
+    Surface reference;
+    downwell::EffectCoverageCommands<32> commands;
+    std::uint8_t masks[16][40],colors[40];
+    for(auto& c:colors)c=0xff;
+    std::uint32_t rng=19;
+    auto next=[&](){rng=rng*1664525u+1013904223u;return rng;};
+    unsigned checks=0;
+    for(unsigned trial=0;trial<256;++trial) {
+        reference.clear();commands.clear();
+        for(unsigned i=0;i<16;++i) {
+            for(auto& c:masks[i])c=std::uint8_t(next()>>24);
+            const unsigned width=1+next()%29,height=1+next()%10;
+            const Surface::Mask mask{masks[i],40,width,height,4};
+            const int x=int(next()%90)-20,y=int(next()%70)-15;
+            const bool subtract=i%3==2;
+            commands.append(mask,x,y,subtract);
+            assert(subtract?reference.subtract(mask,x,y):reference.add({mask,colors,colors},x,y));
+            for(unsigned q=0;q<64;++q) {
+                const int l=next()%64,t=next()%48;
+                const int r=l+next()%(65-l),b=t+next()%(49-t);
+                assert(commands.intersects(l,t,r,b)==int(reference.intersects(l,t,r,b)));++checks;
+            }
+            assert(commands.intersects(0,0,64,48)==int(reference.intersects(0,0,64,48)));++checks;
+        }
+    }
+    const std::uint8_t point[]={0x80,0};
+    const Surface::Mask mask{point,2,1,1,2};
+    commands.clear();commands.append(mask,0,0,false);commands.append(mask,0,0,true);
+    assert(commands.intersects(0,0,1,1)==0);
+    commands.append(mask,0,0,false);assert(commands.intersects(0,0,1,1)==1);
+    for(unsigned i=0;i<33;++i)commands.append(mask,0,0,false);
+    assert(commands.intersects(0,0,1,1)==-1);
+    commands.clear();assert(commands.intersects(0,0,1,1)==0);
+    commands.invalidate();assert(commands.intersects(0,0,1,1)==-1);
+    std::printf("Effect coverage commands: %u exact raster queries plus subtraction/re-add/overflow checks\n",checks);
+}
