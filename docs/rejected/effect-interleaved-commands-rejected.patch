+++ b/src/core/EffectCoverageCommands.h
@@ -0,0 +1,66 @@
+#ifndef DOWNWELL_CORE_EFFECT_COVERAGE_COMMANDS_H
+#define DOWNWELL_CORE_EFFECT_COVERAGE_COMMANDS_H
+#include <cstdint>
+namespace downwell {
+// Exact alpha queries over immutable, borrowed masks. Sources must remain
+// alive and unchanged until clear(). This is command metadata, not a second
+// raster: adding opaque black still adds coverage; subtraction only removes
+// earlier coverage. Platforms may decline this route for mutable sources.
+template<unsigned Capacity=128> class EffectCoverageCommands {
+    struct Command {
+        const std::uint8_t* mask;
+        int x,y;
+        unsigned width,height,stride;
+        bool subtract;
+    } commands_[Capacity];
+    unsigned count_=0;
+    bool valid_=true;
+    static std::uint16_t coverage(const Command& c,int x,int y) {
+        if(y<c.y || y>=c.y+int(c.height))return 0;
+        const int left=x>c.x?x:c.x;
+        const int right=x+16<c.x+int(c.width)?x+16:c.x+int(c.width);
+        if(left>=right)return 0;
+        const unsigned sx=unsigned(left-c.x),byte=sx/8;
+        const auto* row=c.mask+unsigned(y-c.y)*c.stride;
+        std::uint32_t bits=std::uint32_t(row[byte])<<16;
+        if(byte+1<c.stride)bits|=std::uint32_t(row[byte+1])<<8;
+        if(byte+2<c.stride)bits|=row[byte+2];
+        bits=(bits>>(8-sx%8))&0xffffu;
+        bits&=0xffffu<<(16-unsigned(right-left));
+        return std::uint16_t(bits>>unsigned(left-x));
+    }
+public:
+    void clear(){count_=0;valid_=true;}
+    void invalidate(){valid_=false;}
+    template<class Mask> void append(const Mask& m,int x,int y,bool subtract) {
+        if(!valid_)return;
+        if(count_==Capacity){valid_=false;return;}
+        commands_[count_++]={m.data,x,y,m.width,m.height,m.stride,subtract};
+    }
+    // Caller clips to the bounded viewport first. -1 requests the retained
+    // raster query (capacity exhaustion or a non-immutable producer).
+    int intersects(int left,int top,int right,int bottom)const {
+        if(!valid_)return -1;
+        if(left>=right || top>=bottom)return 0;
+        for(unsigned i=0;i<count_;++i) {
+            const auto& c=commands_[i];
+            if(c.subtract)continue;
+            const int l=left>c.x?left:c.x,r=right<c.x+int(c.width)?right:c.x+int(c.width);
+            const int t=top>c.y?top:c.y,b=bottom<c.y+int(c.height)?bottom:c.y+int(c.height);
+            if(l>=r || t>=b)continue;
+            for(int y=t;y<b;++y)for(int x=l;x<r;x+=16) {
+                std::uint16_t bits=coverage(c,x,y);
+                if(r-x<16)bits&=std::uint16_t(0xffffu<<(16-(r-x)));
+                // Later adds cannot erase coverage. Each later subtract
+                // removes this add's contribution; later adds get their own
+                // turn, so re-addition after subtraction stays visible.
+                for(unsigned j=i+1;bits && j<count_;++j)
+                    if(commands_[j].subtract)bits&=std::uint16_t(~coverage(commands_[j],x,y));
+                if(bits)return 1;
+            }
+        }
+        return 0;
+    }
+};
+}
+#endif
