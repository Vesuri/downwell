+/* One monotone sweep, not repeated insertion/overlay into a general RLE list.
+   Repeated source rows have a constant fully overlapped middle; only the seven
+   rows around a group boundary need the source's ordered partial overlaps. */
+unsigned amigaRendererPublishAmmoColumn(UBYTE* destination, UBYTE* working,
+    AmigaAmmoColumnCache* cache, const UBYTE* states, unsigned filled, unsigned meter,
+    unsigned fillTop, unsigned fillHeight, const AmigaWordStamp* stamps,
+    const AmigaHudBlockedColumn* dividers, int top, int bottom) {
+    const int base = 229+4*meter, shift = 4*meter;
+    const unsigned firstVisible = base >= 232 ? base-231 : 0;
+    const unsigned bank = cache->bank ^ 1u;
+    AmigaAmmoColumnSpan* next = cache->spans[bank];
+    const AmigaAmmoColumnSpan* previous = cache->spans[cache->bank];
+    unsigned groups = 0, group = 0, old = 0, count = 0, writes = 0, i;
+    int y = bottom-1;
+    const int retained = cache->valid && cache->top == top && cache->bottom == bottom;
+    if (top < shift || bottom > 284 || top >= bottom || meter > 3 || !dividers->runStarts) return 0;
+    for (i = firstVisible; i < 184; ++i) {
+        const unsigned frame = states[i] < 4 ? states[i] : 3;
+        const unsigned stamp = i < filled ? (i ? 4+frame : 8+frame%2) : frame;
+        if (!groups || stamp != cache->groups[groups-1].stamp) {
+            cache->groups[groups].stamp = stamp;
+            cache->groups[groups++].end = i+1;
+        } else cache->groups[groups-1].end = i+1;
+    }
+    while (y >= top) {
+        int begin = top, start = base-y, stop = start+8;
+        const unsigned fillEnd = fillTop+fillHeight;
+        UWORD low = 0xfff0, high = 0xfff0;
+        if ((unsigned)y >= fillTop && (unsigned)y < fillEnd) {
+            high = 0x8010;
+            if (begin < (int)fillTop) begin = fillTop;
+        } else if ((unsigned)y >= fillEnd && begin < (int)fillEnd) begin = fillEnd;
+        if (start < (int)firstVisible) start = firstVisible;
+        if (stop > 184) stop = 184;
+        while (group < groups && cache->groups[group].end <= start) ++group;
+        if (start < stop && group < groups) {
+            const AmigaWordStamp* stamp = stamps+cache->groups[group].stamp;
+            if (start == base-y && stop == start+8 && stop <= cache->groups[group].end) {
+                const int first = y-(cache->groups[group].end-stop);
+                const UWORD mask = stamp->runMask[7] & 0xfff0u;
+                if (begin < first) begin = first;
+                low = (low & (UWORD)~mask) | (stamp->runLow[7] & mask);
+                high = (high & (UWORD)~mask) | (stamp->runHigh[7] & mask);
+            } else {
+                unsigned g = group;
+                begin = y;
+                while (start < stop) {
+                    const unsigned end = cache->groups[g].end < stop ? cache->groups[g].end : stop;
+                    const unsigned index = (start-(base-y))*8 + end-1-(base-y);
+                    UWORD mask;
+                    stamp = stamps+cache->groups[g].stamp;
+                    mask = stamp->runMask[index] & 0xfff0u;
+                    low = (low & (UWORD)~mask) | (stamp->runLow[index] & mask);
+                    high = (high & (UWORD)~mask) | (stamp->runHigh[index] & mask);
+                    start = end; ++g;
+                }
+            }
+        } else if (base-y+8 <= (int)firstVisible) {
+            const int first = base+8-firstVisible;
+            if (begin < first) begin = first;
+        }
+        {
+            const unsigned sourceY = y-shift, blockY = sourceY >> 3;
+            const unsigned block = dividers->indices[blockY];
+            const UWORD* words = dividers->blocks+block*16+(sourceY&7)*2;
+            const UWORD mask = (words[0] | words[1]) & 0xfff0u;
+            int first;
+            if (!block) {
+                unsigned b = blockY;
+                while (b && !dividers->indices[b-1]) --b;
+                first = b*8+shift;
+            } else first = blockY*8+dividers->runStarts[block*8+(sourceY&7)]+shift;
+            if (begin < first) begin = first;
+            low = (low & (UWORD)~mask) | (words[0] & mask);
+            high = (high & (UWORD)~mask) | (words[1] & mask);
+        }
+        if (count && next[count-1].low == low && next[count-1].high == high)
+            next[count-1].first = begin;
+        else { next[count].first = begin; next[count].low = low; next[count++].high = high; }
+        {
+            int end = y+1;
+            while (end > begin) {
+                int first = begin;
+                unsigned plane;
+                if (retained) {
+                    while (old < cache->count[cache->bank] && previous[old].first >= end) ++old;
+                    if (first < previous[old].first) first = previous[old].first;
+                }
+                for (plane = 0; plane < 2; ++plane) {
+                    const UWORD value = plane ? high : low;
+                    if (!retained || value != (plane ? previous[old].high : previous[old].low)) {
+                        UBYTE* target = destination+plane*downwellPlaneBytes+first*downwellBytesPerPlaneLine+36;
+                        UBYTE* backing = working+plane*downwellPlaneBytes+first*downwellBytesPerPlaneLine+36;
+                        int row;
+                        for (row = first; row < end; ++row) {
+                            writeWord(target, (readWord(target)&0x000fu)|value);
+                            writeWord(backing, (readWord(backing)&0x000fu)|value);
+                            target += downwellBytesPerPlaneLine; backing += downwellBytesPerPlaneLine;
+                            ++writes;
+                        }
+                    }
+                }
+                end = first;
+            }
+        }
+        y = begin-1;
+    }
+    cache->count[bank] = count; cache->bank = bank;
+    cache->top = top; cache->bottom = bottom; cache->valid = 1;
+    return writes;
+}
