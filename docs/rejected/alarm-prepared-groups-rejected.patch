new file mode 100644
index 00000000..4bb73a6d
--- /dev/null
+++ b/src/core/GameplayAlarmSchedule.h
@@ -0,0 +1,49 @@
+#ifndef DOWNWELL_CORE_GAMEPLAY_ALARM_SCHEDULE_H
+#define DOWNWELL_CORE_GAMEPLAY_ALARM_SCHEDULE_H
+#include "AlarmBank.h"
+#include "InstanceHandle.h"
+namespace downwell {
+enum class GameplayAlarmFamily {enemy,breakable,debris,timeChange,entryDither,drone};
+// Prepared from the authoritative object/registration-ordered capture. This
+// is a phase snapshot, not a live family scan: new births cannot join it and
+// every countdown resolves the captured generation in its family records.
+// Equal-object families may interleave, so groups may split an object row.
+template<unsigned Capacity> class GameplayAlarmSchedule {
+    struct Group {unsigned first=0,count=0,mask=0;GameplayAlarmFamily family{};};
+    InstanceHandle keys_[Capacity]{};
+    Group groups_[Capacity]{};
+    unsigned groupCount_=0,mask_=0;
+public:
+    template<class Snapshot,class Decode,class Mask>
+    bool prepare(const Snapshot& snapshot,Decode decode,Mask mask){
+        groupCount_=0;mask_=0;
+        if(snapshot.size()>Capacity)return false;
+        int previousObject=-1;
+        GameplayAlarmFamily previousFamily{};
+        for(unsigned i=0;i<snapshot.size();++i){
+            GameplayAlarmFamily family;
+            if(!decode(snapshot.handle(i),family,keys_[i])||!keys_[i].generation)return false;
+            const int object=snapshot.object(i);
+            if(!groupCount_||object!=previousObject||family!=previousFamily){
+                unsigned events;
+                if(!mask(object,events)||(events&~unsigned(AlarmBank::allEvents)))return false;
+                groups_[groupCount_++]={i,0,events,family};mask_|=events;
+                previousObject=object;previousFamily=family;
+            }
+            ++groups_[groupCount_-1].count;
+        }
+        return true;
+    }
+    template<class Visit> bool visit(Visit visit)const{
+        for(unsigned alarm=0;alarm<AlarmBank::count;++alarm){
+            const unsigned bit=1u<<alarm;
+            if(!(mask_&bit))continue;
+            for(unsigned i=0;i<groupCount_;++i){const auto& group=groups_[i];
+                if((group.mask&bit)&&!visit(group.family,keys_+group.first,group.count,alarm))return false;
+            }
+        }
+        return true;
+    }
+};
+}
+#endif
