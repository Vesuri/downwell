+
+bool GameplayWorld::advanceEnemyAlarmGroup(const downwell::InstanceHandle* keys,unsigned count,unsigned alarm){
+    if(!run_.effectsSucceeded||alarm>=downwell::AlarmBank::count||(count&&!keys))return run_.effectsSucceeded=false;
+    // Other resource events retain the current adapter's unimplemented body;
+    // they have no stored counter in EnemyState. Do not invent an Alarm 2.
+    if(alarm>1)return true;
+    for(unsigned i=0;i<count;++i){
+        auto* enemy=const_cast<EnemyState*>(resolveEnemyLifetime(keys[i]));
+        if(!enemy||!enemy->active||enemy->destroyRequested)continue;
+        auto& value=alarm==0?enemy->alarm0:enemy->alarm1;
+        if(downwell::AlarmBank::advanceValue(value,(downwell::enemyAlarmEvents(enemy->objectId)&(1u<<alarm))!=0)&&
+            !dispatchEnemyAlarmEvents(*enemy,alarm==0,alarm==1))return false;
+    }
+    return run_.effectsSucceeded;
+}
+
+bool GameplayWorld::advanceBoxAlarmGroup(const downwell::InstanceHandle* keys,unsigned count,unsigned alarm){
+    if(!run_.effectsSucceeded||alarm>=downwell::AlarmBank::count||(count&&!keys))return run_.effectsSucceeded=false;
+    if(alarm!=0||!boxAlarmMayDispatch(alarm))return true;
+    for(unsigned i=0;i<count;++i){
+        const auto key=keys[i];
+        if(key.slot>=breakableCount_)continue;
+        auto& box=breakables_[key.slot];
+        if(!key.generation||box.lifetimeId!=key.generation||!box.active||box.destroyRequested)continue;
+        if(downwell::AlarmBank::advanceValue(box.alarm0))box.state.alarmZero();
+    }
+    return true;
+}
 
