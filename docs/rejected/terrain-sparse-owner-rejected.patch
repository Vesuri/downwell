diff --git a/src/platform/amiga/AmigaTerrainRowOwner.h b/src/platform/amiga/AmigaTerrainRowOwner.h
new file mode 100644
index 00000000..fc8d949a
--- /dev/null
+++ b/src/platform/amiga/AmigaTerrainRowOwner.h
@@ -0,0 +1,104 @@
+#ifndef DOWNWELL_AMIGA_TERRAIN_ROW_OWNER_H
+#define DOWNWELL_AMIGA_TERRAIN_ROW_OWNER_H
+#include <cstdint>
+#include <cstring>
+
+// Immutable source-ordered prefixes plus individual mutable cell overrides.
+// Neither an event Create nor a collision mutation copies an entire row.
+// A published prefix is borrowed from an immutable builder pack.
+class AmigaTerrainRowOwner {
+public:
+    static constexpr unsigned columns=128,rows=512;
+    static constexpr unsigned size(){return rows*columns;}
+private:
+    std::uint8_t values_[columns*rows];
+#ifndef DOWNWELL_REFERENCE_TERRAIN_ROWS
+    inline static constexpr std::uint8_t empty_[columns]{};
+    const std::uint8_t* base_[rows];
+    std::uint8_t changed_[rows][columns/8];
+    std::uint8_t order_[rows][columns];
+    std::uint16_t count_[rows];
+    bool changed(unsigned row,unsigned column)const{
+        return (changed_[row][column/8]&(1u<<(column&7)))!=0;
+    }
+    static unsigned addition(unsigned column,const std::uint8_t* words,unsigned count){
+        for(unsigned i=0;i<count;++i,words+=4)
+            if(column>=words[0]&&column<words[0]+2u)return words[2+column-words[0]];
+        return 0;
+    }
+#endif
+public:
+    AmigaTerrainRowOwner(){clear();}
+    void clear(){
+#ifdef DOWNWELL_REFERENCE_TERRAIN_ROWS
+        std::memset(values_,0,sizeof(values_));
+#else
+        for(unsigned y=0;y<rows;++y){base_[y]=empty_;count_[y]=0;}
+        std::memset(changed_,0,sizeof(changed_));
+#endif
+    }
+    std::uint8_t read(unsigned cell)const{
+#ifdef DOWNWELL_REFERENCE_TERRAIN_ROWS
+        return values_[cell];
+#else
+        const unsigned row=cell/columns,column=cell%columns;
+        return changed(row,column)?values_[cell]:base_[row][column];
+#endif
+    }
+    std::uint8_t operator[](unsigned cell)const{return read(cell);}
+    std::uint8_t& write(unsigned cell){
+#ifndef DOWNWELL_REFERENCE_TERRAIN_ROWS
+        const unsigned row=cell/columns,column=cell%columns;
+        if(!changed(row,column)){
+            values_[cell]=base_[row][column];
+            changed_[row][column/8]|=std::uint8_t(1u<<(column&7));
+            order_[row][count_[row]++]=std::uint8_t(column);
+        }
+#endif
+        return values_[cell];
+    }
+    struct ConstRow {
+        const AmigaTerrainRowOwner* owner;unsigned cell;
+        std::uint8_t operator[](unsigned offset)const{return owner->read(cell+offset);}
+        std::uint8_t operator*()const{return owner->read(cell);}
+        ConstRow operator+(int offset)const{return {owner,unsigned(int(cell)+offset)};}
+        ConstRow& operator+=(int offset){cell=unsigned(int(cell)+offset);return *this;}
+    };
+    struct MutableRow {
+        AmigaTerrainRowOwner* owner;unsigned cell;
+        std::uint8_t& operator[](unsigned offset)const{return owner->write(cell+offset);}
+        std::uint8_t& operator*()const{return owner->write(cell);}
+        MutableRow operator+(int offset)const{return {owner,unsigned(int(cell)+offset)};}
+        MutableRow& operator+=(int offset){cell=unsigned(int(cell)+offset);return *this;}
+    };
+    ConstRow readRow(unsigned row)const{return {this,row*columns};}
+    MutableRow writeRow(unsigned row){return {this,row*columns};}
+    bool admits(unsigned row,const std::uint8_t* previous,const std::uint8_t* words,unsigned count)const{
+#ifdef DOWNWELL_REFERENCE_TERRAIN_ROWS
+        (void)row;(void)previous;(void)words;(void)count;return false;
+#else
+        if(row>=rows||base_[row]!=(previous?previous:empty_))return false;
+        // Overflow contacts require the original ordered scalar publisher.
+        // Admission is read-only: no RNG or partial mutation on rejection.
+        for(unsigned i=0;i<count_[row];++i){
+            const unsigned column=order_[row][i];
+            if((values_[row*columns+column]>>6)+(addition(column,words,count)>>6)>3)return false;
+        }
+        return true;
+#endif
+    }
+    bool publish(unsigned row,const std::uint8_t* prepared,const std::uint8_t* previous,
+                 const std::uint8_t* words,unsigned count){
+        if(!prepared||!admits(row,previous,words,count))return false;
+#ifndef DOWNWELL_REFERENCE_TERRAIN_ROWS
+        for(unsigned i=0;i<count_[row];++i){
+            const unsigned column=order_[row][i],delta=addition(column,words,count);
+            auto& value=values_[row*columns+column];
+            value=std::uint8_t(((value|delta)&63)|(((value>>6)+(delta>>6))<<6));
+        }
+        base_[row]=prepared;
+#endif
+        return true;
+    }
+};
+#endif
diff --git a/tests/platform/amiga/AmigaTerrainRowOwnerTest.cpp b/tests/platform/amiga/AmigaTerrainRowOwnerTest.cpp
new file mode 100644
index 00000000..d4b9686a
--- /dev/null
+++ b/tests/platform/amiga/AmigaTerrainRowOwnerTest.cpp
@@ -0,0 +1,42 @@
+#include "platform/amiga/AmigaTerrainRowOwner.h"
+#include <array>
+#include <cassert>
+#include <memory>
+#include <iostream>
+int main(){
+    using Owner=AmigaTerrainRowOwner;
+    auto owner=std::make_unique<Owner>();
+    std::array<std::uint8_t,128> first{},second{};
+    const std::uint8_t a[]={42,3,83,34},b[]={42,3,83,34};
+    first[42]=83;first[43]=34;second[42]=147;second[43]=34;
+    assert(owner->publish(7,first.data(),nullptr,a,1));
+    owner->write(7*128+42)|=4; // event box over an existing wall
+    owner->write(7*128+43)=0; // destruction before the next fixed segment
+    owner->write(7*128+99)=7; // event outside the prepared word range
+    assert(owner->publish(7,second.data(),first.data(),b,1));
+    assert(owner->read(7*128+42)==151&&owner->read(7*128+43)==34&&owner->read(7*128+99)==7);
+    assert(first[42]==83&&second[42]==147);
+    auto copy=std::make_unique<Owner>(*owner);
+    owner->write(7*128+42)=255;
+    assert(copy->read(7*128+42)==151);
+    assert(!owner->admits(7,second.data(),b,1)); // scalar overflow path
+    assert(!owner->publish(7,first.data(),second.data(),b,1));
+    assert(owner->read(7*128+42)==255);
+    assert(!owner->admits(7,nullptr,a,1)&&!owner->admits(512,nullptr,a,1));
+    owner->clear();
+    for(unsigned i=0;i<Owner::size();++i)assert(owner->read(i)==0);
+    auto expected=std::make_unique<std::array<std::uint8_t,Owner::size()>>();
+    std::uint32_t rng=19;
+    for(unsigned n=0;n<10000;++n){
+        rng=rng*1664525u+1013904223u;const unsigned at=rng%Owner::size();
+        owner->write(at)=std::uint8_t(rng>>24);(*expected)[at]=std::uint8_t(rng>>24);
+        if(n%97==0){*copy=*owner;*owner=*copy;}
+    }
+    for(unsigned i=0;i<Owner::size();++i)assert(owner->read(i)==(*expected)[i]);
+    // Fully overridden rows remain exact through prefix publication.
+    owner->clear();
+    for(unsigned i=0;i<128;++i)owner->write(i)=4;
+    assert(owner->publish(0,first.data(),nullptr,a,1));
+    for(unsigned i=0;i<128;++i)assert(owner->read(i)==unsigned(first[i]|4));
+    std::cout<<"Sparse terrain prefixes, overrides, copy/reset and overflow admission agree\n";
+}
