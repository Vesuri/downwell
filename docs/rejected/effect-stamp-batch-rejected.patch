+void AmigaHardware::blitterPaletteStamp(uint16_t* low, uint16_t* high, uint16_t* mask,
+    uint16_t* alpha, uint32_t planeBytes, uint16_t width, uint16_t height,
+    int16_t sourceModulo, int16_t destinationModulo, int16_t shift,
+    uint16_t firstWordMask, uint16_t lastWordMask)
+{
+    auto* lowTarget = reinterpret_cast<uint16_t*>(reinterpret_cast<uint8_t*>(alpha) + planeBytes);
+    auto* highTarget = reinterpret_cast<uint16_t*>(reinterpret_cast<uint8_t*>(lowTarget) + planeBytes);
+    // The first operation establishes every register, including when preceding
+    // unrelated work is queued. Its two successors inherit only that state.
+    blitterCopyWithMask(low, lowTarget, mask, width, height, sourceModulo,
+        destinationModulo, sourceModulo, shift, shift, firstWordMask, lastWordMask, false);
+    const auto begin = [](uint16_t registers) {
+        *blitterQueueAddPosition++ = registers;
+        if (blitterQueueAddPosition + registers * 2 >= blitterQueueBufferEnd)
+            blitterQueueAddPosition = blitterQueueBuffer;
+    };
+    const auto word = [](uint16_t reg, uint16_t value) {
+        *blitterQueueAddPosition++ = reg;
+        *blitterQueueAddPosition++ = value;
+    };
+    const auto pointer = [&](uint16_t reg, const uint16_t* value) {
+        const uint32_t address = reinterpret_cast<uint32_t>(value);
+        word(reg, uint16_t(address >> 16));
+        word(reg + 2, uint16_t(address));
+    };
+    const uint16_t size = uint16_t((height << 6) | width);
+    // Hardware advances all four pointers during the low-plane operation.
+    // Reload them, but not its masks, modulos, shifts or minterm.
+    begin(9);
+    pointer(bltapth, mask);
+    pointer(bltbpth, high);
+    pointer(bltcpth, highTarget);
+    pointer(bltdpth, highTarget);
+    word(bltsize, size);
+    // Alpha uses the same A mask, C/D stride and traversal direction. Disable
+    // B DMA and its shift, and supply all-one B data to OR opacity into C.
+    begin(10);
+    word(bltcon1, shift < 0 ? BLITREVERSE : 0);
+    word(bltcon0, uint16_t(BC0F_SRCA | BC0F_SRCC | BC0F_DEST | 0xca |
+        ((shift < 0 ? -shift : shift) << 12)));
+    word(bltbdat, 0xffff);
+    pointer(bltapth, mask);
+    pointer(bltcpth, alpha);
+    pointer(bltdpth, alpha);
+    word(bltsize, size);
+    hasQueuedBlits = true;
+    processBlitterQueue();
+}
