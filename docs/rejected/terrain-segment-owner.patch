+    bool marked(unsigned slot)const{
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        if(reference_)return reference_->marked(slot);
+#endif
+        return slot<Capacity&&(terrainSlot(slot)?terrain_&&terrain_->roomMarked(slot-First):actors_.marked(local(slot)));
+    }
+    bool mark(unsigned slot){
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        if(reference_)return reference_->mark(slot);
+#endif
+        return slot<Capacity&&(terrainSlot(slot)?terrain_&&terrain_->roomMark(slot-First):actors_.mark(local(slot)));
+    }
+    bool remove(unsigned slot){
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        if(reference_)return reference_->remove(slot);
+#endif
+        return slot<Capacity&&(terrainSlot(slot)?terrain_&&terrain_->roomRemove(slot-First):actors_.remove(local(slot)));
+    }
+    bool bind(unsigned slot,RunnerImageValue key){
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        if(reference_)return reference_->bind(slot,key);
+#endif
+        if(slot>=Capacity||!RunnerSpatialSplit::valid(key))return false;
+        if(terrainSlot(slot))return bindTerrainSpan(slot,1,key);
+        if(!actors_.bind(local(slot),key))return false;
+        actorSequence_[local(slot)]=stamp();return true;
+    }
+    bool bindTerrainSpan(unsigned first,unsigned count,RunnerImageValue key){
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        if(reference_)return reference_->bindTerrainSpan(first,count,key);
+#endif
+        if(!count)return true;
+        if(!terrain_||first<First||first>=Last||count>Last-first||!RunnerSpatialSplit::valid(key))return false;
+        const auto sequence=clock_.shifted(1);
+        // shifted preserves the zero sentinel; the first real stamp is one.
+        auto begin=sequence;if(!begin.present())begin.low=1;
+        if(!terrain_->roomBind(first-First,count,key,begin))return false;
+        stamp(count);return true;
+    }
+    bool prepareRetainedAnimation(unsigned first,unsigned last)const{return first<=last&&last<=Capacity;}
+    class AnimationCursor {
+        const RunnerSegmentRoomMembership& room_;
+        unsigned first_,last_,actor_;
+        bool actorsOnly_,started_=false;
+        RunnerSegmentRoomState previous_,key_;
+        unsigned selected_=End;
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        unsigned referenceSlot_=End;
+#endif
+    public:
+        AnimationCursor(const RunnerSegmentRoomMembership& room,unsigned first,unsigned last)
+            :room_(room),first_(first),last_(last),actor_(room.actors_.firstSlot(0)),
+             actorsOnly_(first<=First&&last>=Last){
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+            if(room.reference_)referenceSlot_=room.reference_->firstSlot(0);
+#endif
+        }
+        unsigned slot(){
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+            if(room_.reference_){
+                while(referenceSlot_!=End&&referenceSlot_>=first_&&referenceSlot_<last_)
+                    referenceSlot_=room_.reference_->nextSlot(referenceSlot_);
+                return referenceSlot_;
+            }
+#endif
+            if(actorsOnly_){
+                while(actor_!=Actors::End){const unsigned s=global(actor_);
+                    if(s<first_||s>=last_)return s;actor_=room_.actors_.nextSlot(actor_);
+                }return End;
+            }
+            if(selected_==End)selected_=room_.next(true,false,started_?&previous_:nullptr,false,
+                [&](unsigned first,unsigned end){return first>=first_&&first<last_?(last_<end?last_:end):first;},key_);
+            return selected_;
+        }
+        unsigned take(){
+            const auto s=slot();if(s==End)return s;
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+            if(room_.reference_){referenceSlot_=room_.reference_->nextSlot(s);return s;}
+#endif
+            if(actorsOnly_)actor_=room_.actors_.nextSlot(actor_);
+            else{previous_=key_;started_=true;selected_=End;}
+            return s;
+        }
+        bool within(unsigned first,unsigned last){const auto s=slot();return s>=first&&s<last;}
+    };
+    template<class Visit> bool visitAnimationChecked(Visit visit)const{
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        if(reference_)return reference_->visitAnimationChecked(visit);
+#endif
+        return walk(true,false,false,[&](unsigned s,RunnerImageValue,bool){return visit(s);});
+    }
+    template<class Visit> bool visitDrawChecked(Visit visit)const{
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        if(reference_)return reference_->visitDrawChecked(visit);
+#endif
+        return walk(true,false,true,[&](unsigned s,RunnerImageValue,bool){return visit(s);});
+    }
+    template<class Visit> bool visitAnimationRetainedChecked(unsigned first,unsigned last,bool& dirty,Visit visit)const{
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        if(reference_)return reference_->visitAnimationRetainedChecked(first,last,dirty,visit);
+#endif
+        if(first>last||last>Capacity)return false;
+        bool full=dirty;dirty=false;
+        RunnerSegmentRoomState previous,key;bool started=false;
+        for(;;){
+            if(dirty)full=true;
+            const auto s=next(true,false,started?&previous:nullptr,false,[&](unsigned begin,unsigned end){
+                return !full&&begin>=first&&begin<last?(last<end?last:end):begin;
+            },key);
+            if(s==End)return true;previous=key;started=true;
+            if(!visit(s))return false;
+        }
+    }
+    template<class Visit> bool visitAnimationProjectedChecked(AnimationProjection&,unsigned first,unsigned last,bool& dirty,Visit visit)const{
+        return visitAnimationRetainedChecked(first,last,dirty,visit);
+    }
+    template<class Visit> bool visitMarkedCleanupOrdered(Visit visit){
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        if(reference_)return reference_->visitMarkedCleanupOrdered(visit);
+#endif
+        return walk(true,true,false,visit)&&walk(false,true,false,visit);
+    }
+    template<class Visit> bool visitMarkedCleanupChecked(Visit visit){
+        return visitMarkedCleanupOrdered([&](unsigned s,RunnerImageValue,bool){return visit(s);});
+    }
+    template<class Visit> bool visitCleanupChecked(Visit visit){
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        if(reference_)return reference_->visitCleanupChecked(visit);
+#endif
+        return walk(true,false,false,[&](unsigned s,RunnerImageValue,bool){return visit(s);})&&
+            walk(false,false,false,[&](unsigned s,RunnerImageValue,bool){return visit(s);});
+    }
+    template<class Select,class Inactive,class Publish> bool reconcileSelectedChecked(Select select,Inactive inactive,Publish publish){
+#ifndef DOWNWELL_EXTERNAL_COLLISION_BACKEND
+        if(reference_)return reference_->reconcileSelectedChecked(select,inactive,publish);
+#endif
+        for(unsigned list=1;;--list){
+            RunnerSegmentRoomState previous,key;bool started=false;
+            for(;;){
+                const auto s=next(!list,false,started?&previous:nullptr,false,select,key);
+                if(s==End)break;previous=key;started=true;
+                if(bool(inactive(s))!=bool(list)){
+                    const auto sequence=stamp();
+                    if(terrainSlot(s)){
+                        if(!terrain_->roomMove(s-First,list!=0,sequence))return false;
+                    }else{
+                        if(!actors_.moveToList(local(s),list!=0))return false;
+                        actorSequence_[local(s)]=sequence;
+                    }
+                    if(!publish(s,list!=0))return false;
+                }
+            }
+            if(!list)break;
+        }return true;
+    }
+    template<class Inactive,class Publish> bool reconcileChecked(Inactive inactive,Publish publish){
+        return reconcileSelectedChecked([](unsigned first,unsigned){return first;},inactive,publish);
+    }
+};
+}
+#endif
diff --git a/src/core/RunnerSegmentRoomState.h b/src/core/RunnerSegmentRoomState.h
new file mode 100644
index 00000000..b713e3c0
--- /dev/null
+++ b/src/core/RunnerSegmentRoomState.h
@@ -0,0 +1,26 @@
+#ifndef DOWNWELL_CORE_RUNNER_SEGMENT_ROOM_STATE_H
+#define DOWNWELL_CORE_RUNNER_SEGMENT_ROOM_STATE_H
+#include "RunnerSpatialSplit.h"
+#include "RunnerRegistrationOrder.h"
+namespace downwell {
+// Room chronology is independent of registration and logical Draw-layer order.
+// A common segment value represents its unmodified cells. Deferred activation
+// changes membership only at reconciliation, not when flag 2 is requested.
+struct RunnerSegmentRoomState {
+    RunnerImageValue depth;
+    RunnerRegistrationOrder sequence;
+    bool present=false,active=true,marked=false;
+    RunnerSegmentRoomState shifted(unsigned n)const{
+        auto out=*this;out.sequence=sequence.shifted(n);return out;
+    }
+    bool same(const RunnerSegmentRoomState& b)const{
+        return depth.bits==b.depth.bits&&sequence.same(b.sequence)&&present==b.present&&active==b.active&&marked==b.marked;
+    }
+    bool before(const RunnerSegmentRoomState& b)const{
+        if(active!=b.active)return active;
+        if(active&&!RunnerSpatialSplit::equal(depth,b.depth))return RunnerSpatialSplit::less(depth,b.depth);
+        return sequence.before(b.sequence);
+    }
+};
+}
+#endif
diff --git a/src/core/TerrainSegmentRecords.h b/src/core/TerrainSegmentRecords.h
new file mode 100644
index 00000000..cdcd3993
--- /dev/null
+++ b/src/core/TerrainSegmentRecords.h
@@ -0,0 +1,235 @@
+#ifndef DOWNWELL_CORE_TERRAIN_SEGMENT_RECORDS_H
+#define DOWNWELL_CORE_TERRAIN_SEGMENT_RECORDS_H
+#include "InstanceHandle.h"
+#include <cstdint>
+namespace downwell {
+// A record is authoritative for its entire source-ordered cell interval.
+// There is no slot locator or per-cell initialization. A mutation splits only
+// the affected cell from its neighbours. Records stay in birth order; fresh
+// allocation also keeps slot order, allowing binary search until slot reuse.
+// Publication contains the common runner state, with shifted(n) supplying the
+// nth cell's chronology. Its exceptional state is materialized by writable().
+template<unsigned Capacity,class Publication> class TerrainSegmentRecords {
+    static_assert(Capacity&&Capacity<65535,"Terrain segment capacity");
+    struct Segment {
+        Publication state{};
+        const unsigned char* cells=nullptr;
+        std::uint32_t generation=0,source=0;
+        unsigned first=0,count=0;
+        int object=0,x=0,y=0,step=0,creationCode=-1;
+        int objectAt(unsigned i)const{return cells?((cells[2*i]&128)?93:60):object;}
+        int xAt(unsigned i)const{return cells?(int(cells[2*i]&127)-32)*16:x+int(i)*step;}
+        void advance(unsigned n){
+            state=state.shifted(n);first+=n;generation+=n;count-=n;
+            if(cells)cells+=2*n;else x+=int(n)*step;
+        }
+    };
+    Segment segments_[Capacity]{};
+    unsigned count_=0,population_=0;
+    bool slotOrdered_=true,reserved_=false;
+    unsigned find(unsigned slot)const{
+        if(slotOrdered_){
+            unsigned first=0,end=count_;
+            while(first<end){const unsigned middle=first+(end-first)/2;
+                const auto& s=segments_[middle];
+                if(slot<s.first)end=middle;
+                else if(slot-s.first>=s.count)first=middle+1;
+                else return middle;
+            }
+        }else for(unsigned n=0;n<count_;++n){const auto& s=segments_[n];
+            if(slot>=s.first&&slot-s.first<s.count)return n;
+        }
+        return count_;
+    }
+    bool admitted(InstanceHandle h,unsigned count)const{
+        if(reserved_||!count||!h.generation||h.slot>=Capacity||count>Capacity-h.slot||
+           count>Capacity-population_||count-1>0xffffffffu-h.generation)return false;
+        if(!count_||h.slot>=segments_[count_-1].first+segments_[count_-1].count){
+            if(slotOrdered_)return true;
+        }
+        for(unsigned n=0;n<count_;++n){const auto& s=segments_[n];
+            if(h.slot<s.first+s.count&&s.first<h.slot+count)return false;
+        }
+        return true;
+    }
+    void insert(unsigned n){
+        for(unsigned i=count_;i>n;--i)segments_[i]=segments_[i-1];
+        ++count_;
+    }
+    void erase(unsigned n){
+        for(unsigned i=n+1;i<count_;++i)segments_[i-1]=segments_[i];
+        --count_;
+    }
+    unsigned isolate(unsigned n,unsigned slot){
+        const unsigned offset=slot-segments_[n].first;
+        if(offset){
+            insert(n+1);segments_[n+1]=segments_[n];
+            segments_[n+1].advance(offset);segments_[n].count=offset;++n;
+        }
+        if(segments_[n].count>1){
+            insert(n+1);segments_[n+1]=segments_[n];
+            segments_[n+1].advance(1);segments_[n].count=1;
+        }
+        return n;
+    }
+    void published(unsigned count){
+        const auto& s=segments_[count_];
+        if(count_&&s.first<segments_[count_-1].first+segments_[count_-1].count)slotOrdered_=false;
+        ++count_;population_+=count;
+    }
+public:
+    struct Identity {
+        InstanceHandle handle{};
+        int object=0,x=0,y=0,creationCode=-1;
+        std::uint32_t source=0;
+    };
+    unsigned size()const{return population_;}
+    unsigned runCount()const{return count_;}
+    bool reservationPending()const{return reserved_;}
+    // Allocation asks the authoritative ranges once, not occupied() for each
+    // prospective cell. The fresh tail is a range proof; reuse walks gaps.
+    unsigned freeSpan(unsigned& first)const{
+        if(first>=Capacity)return 0;
+        if(!count_||(slotOrdered_&&first>=segments_[count_-1].first+segments_[count_-1].count))
+            return Capacity-first;
+        unsigned n;
+        while((n=find(first))!=count_){
+            first=segments_[n].first+segments_[n].count;
+            if(first>=Capacity)return 0;
+        }
+        unsigned end=Capacity;
+        for(unsigned i=0;i<count_;++i)
+            if(segments_[i].first>first&&segments_[i].first<end)end=segments_[i].first;
+        return end-first;
+    }
+    bool occupied(unsigned slot)const{return slot<Capacity&&find(slot)!=count_;}
+    bool contains(InstanceHandle h)const{
+        const unsigned n=find(h.slot);
+        return n!=count_&&h.generation&&h.generation==segments_[n].generation+h.slot-segments_[n].first;
+    }
+    InstanceHandle currentHandle(unsigned slot)const{
+        const unsigned n=find(slot);if(n==count_)return {};
+        const auto& s=segments_[n];return {slot,s.generation+slot-s.first};
+    }
+    int object(unsigned slot)const{
+        const unsigned n=find(slot);return n==count_?-1:segments_[n].objectAt(slot-segments_[n].first);
+    }
+    InstanceHandle handle(unsigned ordinal)const{
+        for(unsigned n=0;n<count_;++n){const auto& s=segments_[n];
+            if(ordinal<s.count)return {s.first+ordinal,s.generation+ordinal};
+            ordinal-=s.count;
+        }return {};
+    }
+    bool read(InstanceHandle h,Identity& out)const{
+        const unsigned n=find(h.slot);if(n==count_)return false;
+        const auto& s=segments_[n];const unsigned offset=h.slot-s.first;
+        if(!h.generation||h.generation!=s.generation+offset)return false;
+        out={h,s.objectAt(offset),s.xAt(offset),s.y,s.creationCode,s.source};return true;
+    }
+    bool publication(InstanceHandle h,Publication& out)const{
+        const unsigned n=find(h.slot);if(n==count_)return false;
+        const auto& s=segments_[n];const unsigned offset=h.slot-s.first;
+        if(!h.generation||h.generation!=s.generation+offset)return false;
+        out=s.state.shifted(offset);return true;
+    }
+    const Publication* common(unsigned slot)const{
+        const unsigned n=find(slot);return n==count_?nullptr:&segments_[n].state;
+    }
+    Publication* writable(unsigned slot){
+        const unsigned n=find(slot);if(reserved_||n==count_)return nullptr;
+        return &segments_[isolate(n,slot)].state;
+    }
+    bool changePublication(InstanceHandle h,const Publication& value){
+        Publication old;
+        if(reserved_||!publication(h,old))return false;
+        if(old.same(value))return true;
+        *writable(h.slot)=value;return true;
+    }
+    bool append(InstanceHandle h,int object,int x,int y,std::uint32_t source=0,int creation=-1,
+                const Publication& state=Publication{}){
+        if((object!=60&&object!=93&&object!=99)||!admitted(h,1))return false;
+        if(count_&&!source&&creation==-1){auto& s=segments_[count_-1];
+            if(!s.cells&&!s.source&&s.creationCode==-1&&s.object==object&&s.y==y&&
+               s.first+s.count==h.slot&&s.generation+s.count==h.generation){
+                const int last=s.xAt(s.count-1);
+                const int step=last<=2147483631&&x==last+16?16:
+                    last>=(-2147483632)&&x==last-16?-16:0;
+                if(step&&(s.count==1||s.step==step)&&s.state.shifted(s.count).same(state)){
+                    s.step=step;++s.count;++population_;return true;
+                }
+            }
+        }
+        auto& s=segments_[count_];s=Segment{};
+        s.state=state;s.generation=h.generation;s.source=source;s.first=h.slot;s.count=1;
+        s.object=object;s.x=x;s.y=y;s.creationCode=creation;published(1);return true;
+    }
+    Publication* reserveRetainedCells(InstanceHandle h,const unsigned char* cells,int y,unsigned count){
+        if(!cells||!admitted(h,count))return nullptr;
+        auto& s=segments_[count_];s=Segment{};
+        s.cells=cells;s.first=h.slot;s.generation=h.generation;s.count=count;s.y=y;
+        reserved_=true;return &s.state;
+    }
+    bool commitRetainedCells(unsigned completed){
+        if(!reserved_||completed>segments_[count_].count)return false;
+        reserved_=false;if(!completed)return true;
+        segments_[count_].count=completed;published(completed);return true;
+    }
+    bool appendRetainedCells(InstanceHandle h,const unsigned char* cells,int y,unsigned count,const Publication& state){
+        if(!count)return !reserved_;
+        auto* out=reserveRetainedCells(h,cells,y,count);
+        if(!out)return false;*out=state;return commitRetainedCells(count);
+    }
+    bool appendSpan(InstanceHandle h,int object,int x,int y,int step,unsigned count,const Publication& state){
+        if((object!=60&&object!=93)||(step!=16&&step!=-16)||!admitted(h,count))return false;
+        const int distance=int(count-1)*16;
+        if((step>0&&x>2147483647-distance)||(step<0&&x<(-2147483647-1)+distance))return false;
+        // Scalar geometry coalescing is only needed for the non-borrowed
+        // fallback. Prepared rows use one reserve/commit above.
+        for(unsigned i=0;i<count;++i)
+            if(!append({h.slot+i,h.generation+i},object,x+int(i)*step,y,0,-1,state.shifted(i)))return false;
+        return true;
+    }
+    bool retire(InstanceHandle h){
+        if(reserved_||!contains(h))return false;
+        unsigned n=find(h.slot);auto& s=segments_[n];
+        if(s.count==1)erase(n);
+        else if(h.slot==s.first)s.advance(1);
+        else if(h.slot+1==s.first+s.count)--s.count;
+        else{
+            const unsigned offset=h.slot-s.first;
+            insert(n+1);segments_[n+1]=segments_[n];
+            segments_[n+1].advance(offset+1);segments_[n].count=offset;
+        }
+        --population_;return true;
+    }
+    template<bool Rows,class Visit> bool visitSelected(int first,int end,Visit visit)const{
+        for(unsigned n=0;n<count_;++n){const auto& s=segments_[n];
+            if(Rows&&((s.y<first&&unsigned(first)-unsigned(s.y)>=16u)||
+                (s.y>=end&&unsigned(s.y)-unsigned(end)>=16u)))continue;
+            for(unsigned i=0;i<s.count;++i)
+                if(!visit(Identity{{s.first+i,s.generation+i},s.objectAt(i),s.xAt(i),s.y,s.creationCode,s.source}))return false;
+        }return true;
+    }
+    template<class Visit> bool visit(Visit visit)const{return visitSelected<false>(0,0,visit);}
+    template<class Visit> bool visitRows(int first,int end,Visit visit)const{
+        return first>=end||visitSelected<true>(first,end,visit);
+    }
+    class PublicationRun {
+        const Segment& segment_;
+    public:
+        explicit PublicationRun(const Segment& s):segment_(s){}
+        unsigned first()const{return segment_.first;}
+        unsigned count()const{return segment_.count;}
+        const Publication& publication()const{return segment_.state;}
+        template<bool Reverse=false,class Visit> bool visitSlots(Visit visit)const{
+            for(unsigned i=0;i<segment_.count;++i){const unsigned offset=Reverse?segment_.count-1-i:i;
+                if(!visit(segment_.first+offset,offset))return false;
+            }return true;
+        }
+    };
+    template<class Visit> bool visitPublicationRuns(Visit visit)const{
+        for(unsigned n=0;n<count_;++n)if(!visit(PublicationRun(segments_[n])))return false;return true;
+    }
+};
+}
+#endif
diff --git a/tests/core/RunnerSegmentRoomMembershipTest.cpp b/tests/core/RunnerSegmentRoomMembershipTest.cpp
new file mode 100644
index 00000000..4d191a3f
--- /dev/null
+++ b/tests/core/RunnerSegmentRoomMembershipTest.cpp
@@ -0,0 +1,111 @@
+#include "core/NativeTerrainLifetimes.h"
+#include "core/RunnerSegmentRoomMembership.h"
+#include <cassert>
+#include <vector>
+#include <tuple>
+#include <cstdio>
+using Terrain=downwell::NativeTerrainLifetimes<16>;
+using Room=downwell::RunnerSegmentRoomMembership<32,8,24,Terrain>;
+using Reference=downwell::RunnerRunRoomMembership<32,8,24>;
+using Key=downwell::RunnerImageValue;
+struct Fixture {
+    Terrain terrain;
+    Room room;
+    Reference reference;
+    bool inactive[32]{};
+    unsigned registration=1;
+    Fixture(){
+        assert(room.bindTerrainOwner(terrain));
+        Terrain::Binding binding;
+        binding.context=this;binding.admit=[](void*,unsigned){return true;};
+        binding.birth=[](void* p,const Terrain::Identity& id,bool,std::uint32_t& stamp,std::uint32_t&){
+            auto& f=*static_cast<Fixture*>(p);stamp=f.registration++;
+            return f.room.bind(id.handle.slot+8,Key{0x42c80000});
+        };
+        binding.retire=[](void* p,unsigned slot){return static_cast<Fixture*>(p)->room.remove(slot+8);};
+        binding.mark=[](void* p,unsigned slot){return static_cast<Fixture*>(p)->room.mark(slot+8);};
+        binding.create=[](void*,const Terrain::Identity&,int,std::uint32_t&){return true;};
+        binding.constructDirectSpan=[](void* p,const Terrain::Identity& id,Terrain::PreparedCells cells,int,
+            unsigned& completed,std::uint32_t& stamp,std::uint32_t* flags,downwell::RunnerRetainedLayerState&){
+            auto& f=*static_cast<Fixture*>(p);stamp=f.registration;f.registration+=cells.count;
+            flags[0]=flags[1]=8;completed=cells.count;
+            return f.room.bindTerrainSpan(id.handle.slot+8,cells.count,Key{0x42c80000})?
+                Terrain::SpanResult::success:Terrain::SpanResult::failure;
+        };
+        assert(terrain.bind(binding));
+    }
+    void actor(unsigned slot,unsigned bits){assert(room.bind(slot,Key{bits})&&reference.bind(slot,Key{bits}));}
+    void compare(){
+        std::vector<unsigned> a,b;
+        assert(room.visitAnimationChecked([&](unsigned s){a.push_back(s);return true;}));
+        assert(reference.visitAnimationChecked([&](unsigned s){b.push_back(s);return true;}));assert(a==b);
+        a.clear();b.clear();
+        assert(room.visitDrawChecked([&](unsigned s){a.push_back(s);return true;}));
+        assert(reference.visitDrawChecked([&](unsigned s){b.push_back(s);return true;}));assert(a==b);
+        a.clear();b.clear();
+        Room::AnimationCursor ac(room,8,24);Reference::AnimationCursor bc(reference,8,24);
+        for(unsigned s=ac.take();s!=32;s=ac.take())a.push_back(s);
+        for(unsigned s=bc.take();s!=32;s=bc.take())b.push_back(s);assert(a==b);
+        for(unsigned s=0;s<32;++s){
+            assert(room.contains(s)==reference.contains(s));
+            assert(room.active(s)==reference.active(s));assert(room.marked(s)==reference.marked(s));
+        }
+    }
+    void reconcile(unsigned failure=0){
+        std::vector<std::pair<unsigned,bool>> a,b;
+        const bool x=room.reconcileChecked([&](unsigned s){return inactive[s];},[&](unsigned s,bool active){
+            a.emplace_back(s,active);return !failure||a.size()!=failure;
+        });
+        const bool y=reference.reconcileChecked([&](unsigned s){return inactive[s];},[&](unsigned s,bool active){
+            b.emplace_back(s,active);return !failure||b.size()!=failure;
+        });assert(x==y&&a==b);compare();
+    }
+};
+int main(){
+    {
+        // A scalar fallback can finish its preceding room span inside the
+        // next birth callback (for example when allocation crosses a hole).
+        // The pending identity must not hide those already-committed cells.
+        struct Deferred {Terrain terrain;Room room;unsigned previous=16;} f;
+        assert(f.room.bindTerrainOwner(f.terrain));
+        Terrain::Binding binding;binding.context=&f;
+        binding.admit=[](void*,unsigned){return true;};
+        binding.birth=[](void* p,const Terrain::Identity& id,bool,std::uint32_t& stamp,std::uint32_t&){
+            auto& f=*static_cast<Deferred*>(p);stamp=id.handle.generation;
+            if(f.previous!=16&&!f.room.bind(f.previous+8,Key{0x42c80000}))return false;
+            f.previous=id.handle.slot;return true;
+        };
+        binding.retire=[](void* p,unsigned slot){return static_cast<Deferred*>(p)->room.remove(slot+8);};
+        binding.mark=[](void* p,unsigned slot){return static_cast<Deferred*>(p)->room.mark(slot+8);};
+        assert(f.terrain.bind(binding));
+        assert(f.terrain.append(60,0,160));
+        assert(f.terrain.append(60,16,160));
+        assert(f.room.contains(8)&&!f.room.contains(9));
+        assert(f.room.bind(9,Key{0x42c80000}));
+    }
+    unsigned char cells[32];for(unsigned i=0;i<16;++i){cells[i*2]=static_cast<unsigned char>(32+i+(i&1?128:0));cells[i*2+1]=0;}
+    for(unsigned failure=0;failure<=4;++failure){
+        Fixture f;
+        f.actor(0,0x42c80000);f.actor(25,0);
+        bool okay=true;
+        assert(f.terrain.constructPrepared(51,okay,{cells,8,160,true})&&okay);
+        assert(f.reference.bindTerrainSpan(8,8,Key{0x42c80000}));
+        f.actor(1,0x42c80000);f.actor(26,0x43480000);
+        assert(f.terrain.constructPrepared(51,okay,{cells+16,8,176,true})&&okay);
+        assert(f.reference.bindTerrainSpan(16,8,Key{0x42c80000}));f.compare();
+        assert(f.terrain.runCount()==2); // Two births, no cell materialization.
+        for(unsigned slot:{1u,9u,16u,26u})f.inactive[slot]=true;
+        f.reconcile(failure);
+        if(failure)continue;
+        for(unsigned slot:{0u,9u,12u,16u,26u})assert(f.room.mark(slot)&&f.reference.mark(slot));
+        f.inactive[9]=false;f.inactive[26]=false;f.inactive[12]=true;f.reconcile();
+        std::vector<std::tuple<unsigned,unsigned,bool>> a,b;
+        assert(f.room.visitMarkedCleanupOrdered([&](unsigned s,Key key,bool active){
+            a.emplace_back(s,key.bits,active);return f.room.remove(s);
+        }));
+        assert(f.reference.visitMarkedCleanupOrdered([&](unsigned s,Key key,bool active){
+            b.emplace_back(s,key.bits,active);return f.reference.remove(s);
+        }));assert(a==b);f.compare();
+    }
+    std::puts("Segment-owned room: actor merge, animation skips, deferred activation, cleanup and failed prefixes agree");
+}
diff --git a/tests/core/TerrainSegmentRecordsTest.cpp b/tests/core/TerrainSegmentRecordsTest.cpp
