+#include "core/TerrainSegmentRecords.h"
+#include "core/TerrainOwnershipRuns.h"
+#include <cassert>
+#include <cstdio>
+struct State {
+    unsigned serial=0,flags=0;
+    State shifted(unsigned n)const{return {serial+n,flags};}
+    bool same(const State& b)const{return serial==b.serial&&flags==b.flags;}
+};
+using Segments=downwell::TerrainSegmentRecords<64,State>;
+using Reference=downwell::TerrainOwnershipRuns<64,State>;
+static void compare(const Segments& segments,const Reference& reference){
+    assert(segments.size()==reference.size());
+    for(unsigned i=0;i<segments.size();++i){
+        const auto a=segments.handle(i),b=reference.handle(i);
+        assert(a.slot==b.slot&&a.generation==b.generation);
+        Segments::Identity ai;Reference::Identity bi;State as,bs;
+        assert(segments.read(a,ai)&&reference.read(b,bi));
+        assert(ai.object==bi.object&&ai.x==bi.x&&ai.y==bi.y&&ai.source==bi.source&&ai.creationCode==bi.creationCode);
+        assert(segments.publication(a,as)&&reference.publication(b,bs)&&as.same(bs));
+    }
+    for(unsigned slot=0;slot<64;++slot){
+        unsigned expected=slot;
+        while(expected<64&&reference.occupied(expected))++expected;
+        unsigned end=expected;
+        while(end<64&&!reference.occupied(end))++end;
+        unsigned actual=slot;
+        assert(segments.freeSpan(actual)==end-expected&&actual==expected);
+        assert(segments.occupied(slot)==reference.occupied(slot));
+        const auto a=segments.currentHandle(slot),b=reference.currentHandle(slot);
+        assert(a.slot==b.slot&&a.generation==b.generation);
+        assert(segments.object(slot)==reference.object(slot));
+        assert(!segments.contains({slot,a.generation+1000000}));
+    }
+}
+int main(){
+    unsigned char cells[128];
+    for(unsigned i=0;i<64;++i){cells[i*2]=static_cast<unsigned char>(i|((i&1)?128:0));cells[i*2+1]=0;}
+    for(unsigned completed=0;completed<=64;++completed){
+        Segments segments;Reference reference;
+        auto* target=segments.reserveRetainedCells({0,1},cells,160,64);
+        assert(target&&!segments.size()&&!segments.occupied(0)&&segments.reservationPending());
+        *target={100,0x28};
+        assert(!segments.append({0,1},60,0,0)&&!segments.writable(0));
+        assert(!segments.commitRetainedCells(65));
+        assert(segments.commitRetainedCells(completed));
+        assert(reference.appendRetainedCells({0,1},cells,160,completed,{100,0x28}));
+        compare(segments,reference);
+        if(!completed)continue;
+        assert(segments.runCount()==1);
+        for(unsigned i=0;i<completed;++i){
+            const auto h=segments.handle(i);State state;
+            assert(segments.publication(h,state));
+            assert(segments.changePublication(h,state)&&segments.runCount()==1);
+        }
+        for(unsigned i=0;i<completed;++i){
+            const auto h=segments.handle(i);const State state{500+i, i^31u};
+            assert(segments.changePublication(h,state)&&reference.changePublication(h,state));
+            compare(segments,reference);
+        }
+        assert(segments.runCount()==completed);
+    }
+    Segments segments;Reference reference;
+    assert(segments.appendRetainedCells({0,1},cells,160,64,{100,0x28}));
+    assert(reference.appendRetainedCells({0,1},cells,160,64,{100,0x28}));
+    unsigned random=17391,generation=1000;
+    for(unsigned step=0;step<12000;++step){
+        random=random*1664525u+1013904223u;
+        const unsigned slot=(random>>8)&63;
+        const auto h=segments.currentHandle(slot);
+        if(!h.generation){
+            const State state{generation,random>>16};
+            assert(segments.append({slot,generation},60,int(slot)*16,320,0,-1,state));
+            assert(reference.append({slot,generation},60,int(slot)*16,320,0,-1,state));
+            ++generation;
+        }else if(random&1){
+            assert(segments.retire(h)&&reference.retire(h));
+        }else{
+            const State state{generation++,random>>16};
+            *segments.writable(slot)=state;
+            assert(reference.changePublication(h,state));
+        }
+        compare(segments,reference);
+    }
+    unsigned visited=0;
+    assert(segments.visitPublicationRuns([&](const auto& run){
+        return run.visitSlots([&](unsigned slot,unsigned offset){
+            State state;assert(segments.publication(segments.currentHandle(slot),state));
+            assert(state.same(run.publication().shifted(offset)));++visited;return true;
+        });
+    }));
+    assert(visited==segments.size());
+    std::puts("Segment records: prefixes, lazy cell mutation, chronology, holes and reuse match the retained oracle");
+}
