+bool AmigaGameplayGeneration::createPreparedGroup(void* opaque,
+    const downwell::AreaOneBuilder::PreparedTerrainGroup& group,bool& handled){
+    auto& self=*static_cast<AmigaGameplayGeneration*>(opaque);handled=false;
+    if(self.sourceCreate_||!self.runtime_||!self.lifetimes_||!self.runtime_->terrainCreatesBackendOnly()||
+       self.runtime_->nativeTerrainInstances()!=self.lifetimes_)return true;
+    const auto* controller=self.runtime_->builderController();
+    if(!controller||!controller->hasBorrowedPositionPublication(group.x(),group.finalY()))return true;
+    unsigned platforms=0,walls=0;
+    if(!group.visitSegments([&](const downwell::AreaOneBuilder::PreparedTerrain& batch){
+        if(!amigaAdmitPreparedTerrain(self.index_,self.tiles_,batch))return false;
+        platforms+=batch.platforms();walls+=batch.count()-batch.platforms();return true;
+    }))return true;
+    if(platforms>AmigaTerrainTiles::capacity-self.tiles_.size()||
+       walls>self.index_.extraContacts.capacity()-self.index_.extraContacts.size())return true;
