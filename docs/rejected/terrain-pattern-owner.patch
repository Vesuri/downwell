+    // prepared on the host. No per-row identity constructors or scratch arrays.
+    // Admission excludes callbacks/readers until the next source event cell.
+    const auto result=self.runtime_->tryConstructNativeTerrainPattern(
+        {group.geometry.geometry,group.geometry.count,group.y(),true,true});
+    if(result==TerrainLifetimes::SpanResult::unsupported)return true;
+    handled=true;
+    if(result!=TerrainLifetimes::SpanResult::success)return false;
+    return group.execute([&](const downwell::AreaOneBuilder::PreparedTerrain& batch){
+        if(!batch.beginPublication())return false;
+        if(batch.count()){
+            if(batch.y-24<self.dirtyFirst)self.dirtyFirst=batch.y-24;
+            if(batch.y+24>self.dirtyEnd)self.dirtyEnd=batch.y+24;
+        }
+        if(!amigaPublishPreparedTerrain(self.index_,self.tiles_,batch))return false;
+        batch.completePublication();return true;
+    });
 }
 
