+
+bool BuilderPatternPack::validateGroups(std::uint32_t geometrySize)const{
+    std::uint32_t previous=0;
+    for(unsigned i=0;i<groupCount_;++i){
+        const auto* record=groupRecords_+i*24;
+        const auto start=u32(record),end=u32(record+4),geometry=u32(record+8),index=u32(record+12);
+        const unsigned count=u16(record+16),rows=u16(record+18),segments=u16(record+20);
+        if((i&&start<=previous)||start>=preparedSize_||end>=preparedSize_||index>=rowCount_*2||
+           rows>=256||!count||segments<2||u16(record+22)||!range(geometry,count*2,geometrySize))return false;
+        previous=start;
+        bool inPattern=false;
+        for(unsigned p=0;p<patternCount_;++p){
+            PackedBuilderPattern pattern;if(!this->pattern(p,pattern))return false;
+            if(index/2>=pattern.firstRow&&index/2-pattern.firstRow<pattern.rowCount&&
+               rows<pattern.rowCount-(index/2-pattern.firstRow)){inPattern=true;break;}
+        }
+        if(!inPattern)return false;
+        // Prove that start is a genuine segment boundary, not a zero byte in
+        // another record's payload. Row programs were validated above.
+        auto offset=u32(preparedOffsets_+index*4);
+        while(offset<start&&preparedPrograms_[offset]!=255){
+            const auto* p=preparedPrograms_+offset;
+            offset+=*p?2:6+unsigned(p[3])*2+unsigned(p[4])*4;
+        }
+        if(offset!=start||preparedPrograms_[offset])return false;
+        unsigned row=0,cells=0,nonempty=0;
+        while(offset!=end||row!=rows){
+            const auto* p=preparedPrograms_+offset;
+            if(*p==255){
+                if(row==rows)return false;
+                offset=u32(preparedOffsets_+(index+(++row)*2)*4);continue;
+            }
+            if(*p)return false; // A source event must never be crossed.
+            if(p[3])++nonempty;
+            for(unsigned c=0;c<p[3];++c){
+                if(cells==count||groupGeometry_[geometry+cells*2]!=p[6+c*2]||
+                   groupGeometry_[geometry+cells*2+1]!=row)return false;
+                ++cells;
+            }
+            offset+=6+unsigned(p[3])*2+unsigned(p[4])*4;
+        }
+        if(cells!=count||nonempty!=segments)return false;
+    }
+    return true;
+}
+
+bool BuilderPatternPack::preparedGroup(const std::uint8_t* start,PreparedGroup& out)const{
+    if(!valid()||!groupRecords_||!start)return false;
+    static_assert(sizeof(std::size_t)>=sizeof(void*),"pattern pointer range");
+    const auto address=reinterpret_cast<std::size_t>(start),base=reinterpret_cast<std::size_t>(preparedPrograms_);
+    if(address<base||address-base>=preparedSize_)return false;
+    const auto key=std::uint32_t(address-base);
+    unsigned low=0,high=groupCount_;
+    while(low<high){
+        const unsigned middle=low+(high-low)/2;const auto* record=groupRecords_+middle*24;
+        const auto candidate=u32(record);
+        if(candidate<key)low=middle+1;
+        else if(candidate>key)high=middle;
+        else{out={preparedPrograms_+u32(record+4),groupGeometry_+u32(record+8),
+                  u16(record+16),u16(record+18),u16(record+20)};return true;}
+    }
+    return false;
+}
+
+unsigned BuilderPatternPack::preparedGroupCursor(const std::uint8_t* start)const{
+    if(!valid()||!groupRecords_||!start)return groupCount_;
+    const auto address=reinterpret_cast<std::size_t>(start),base=reinterpret_cast<std::size_t>(preparedPrograms_);
+    if(address<base||address-base>=preparedSize_)return groupCount_;
+    const auto key=std::uint32_t(address-base);
+    unsigned low=0,high=groupCount_;
+    while(low<high){
+        const unsigned middle=low+(high-low)/2;
+        if(u32(groupRecords_+middle*24)<key)low=middle+1;else high=middle;
+    }
+    return low;
+}
+
+bool BuilderPatternPack::nextPreparedGroup(unsigned& cursor,const std::uint8_t* start,PreparedGroup& out)const{
+    if(!valid()||!groupRecords_||cursor>=groupCount_)return false;
+    const auto address=reinterpret_cast<std::size_t>(start),base=reinterpret_cast<std::size_t>(preparedPrograms_);
+    if(address<base||address-base>=preparedSize_)return false;
+    const auto key=std::uint32_t(address-base);
+    const auto* record=groupRecords_+cursor*24;
+    while(cursor<groupCount_&&u32(record)<key){++cursor;record+=24;}
+    if(cursor==groupCount_||u32(record)!=key)return false;
+    out={preparedPrograms_+u32(record+4),groupGeometry_+u32(record+8),
+         u16(record+16),u16(record+18),u16(record+20)};
+    ++cursor;return true;
 }
 
