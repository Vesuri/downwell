diff --git a/src/core/NativeTerrainRegistration.h b/src/core/NativeTerrainRegistration.h
new file mode 100644
index 00000000..a3171e2a
--- /dev/null
+++ b/src/core/NativeTerrainRegistration.h
@@ -0,0 +1,84 @@
+#ifndef DOWNWELL_NATIVE_TERRAIN_REGISTRATION_H
+#define DOWNWELL_NATIVE_TERRAIN_REGISTRATION_H
+#include "RunnerObjectMembership.h"
+#include "InstanceHandle.h"
+namespace downwell {
+// The terrain store already owns identity and chronology. Keep registration
+// nodes only for actors; merge their live sequence with borrowed terrain runs.
+// Traversals have the runner's read-only membership contract.
+template<unsigned Capacity,unsigned First,unsigned Last,class Terrain>
+class NativeTerrainRegistration {
+    static_assert(First<Last&&Last<=Capacity&&Last-First==Terrain::capacity,"Terrain registration domain");
+    static constexpr unsigned Actors=Capacity-(Last-First);
+    RunnerObjectMembership<Actors> actors_;
+    Terrain* terrain_=nullptr;
+    unsigned revision_=0;
+    static unsigned local(unsigned slot){return slot<First?slot:slot-(Last-First);}
+    static unsigned shared(unsigned slot){return slot<First?slot:slot+(Last-First);}
+public:
+    static constexpr bool borrowsTerrain=true;
+    bool bindTerrain(Terrain& terrain){
+        if(terrain_&&terrain_!=&terrain)return false;
+        terrain_=&terrain;return true;
+    }
+    bool read(unsigned slot,std::uint32_t& generation,int& object)const{
+        if(slot>=Capacity)return false;
+        if(slot>=First&&slot<Last)return terrain_&&terrain_->readRegistration(slot-First,generation,object);
+        return actors_.read(local(slot),generation,object);
+    }
+    bool contains(unsigned slot)const{
+        std::uint32_t generation;int object;return read(slot,generation,object);
+    }
+    bool bind(unsigned slot,int object,std::uint32_t generation){
+        if(slot>=Capacity)return false;
+        const bool okay=slot>=First&&slot<Last?terrain_&&terrain_->bindRegistration({slot-First,generation},object):
+            actors_.bind(local(slot),object,generation);
+        if(okay)++revision_;
+        return okay;
+    }
+    bool unbind(unsigned slot){
+        if(slot>=Capacity)return false;
+        const bool okay=slot>=First&&slot<Last?terrain_&&terrain_->unbindRegistration(slot-First):actors_.unbind(local(slot));
+        if(okay)++revision_;
+        return okay;
+    }
+    void clear(){actors_.clear();if(terrain_)terrain_->clearRegistrations();++revision_;}
+    template<class Order,class Visit>
+    bool visit(unsigned first,unsigned last,int selected,Order order,Visit emit)const{
+        if(first>last||last>Capacity)return false;
+        if(first==last)return true;
+        const unsigned revision=revision_;
+        unsigned actor=actors_.firstRegistration();
+        std::uint32_t generation=0;int object=-1;
+        const auto advance=[&](){
+            while(actor!=Actors){
+                const unsigned slot=shared(actor);
+                if(!actors_.read(actor,generation,object))return false;
+                if(slot>=first&&slot<last&&(selected<0||object==selected))break;
+                actor=actors_.nextRegistration(actor);
+            }
+            return true;
+        };
+        const auto emitActor=[&](){
+            if(!emit(shared(actor),generation,object)||revision!=revision_)return false;
+            actor=actors_.nextRegistration(actor);return advance();
+        };
+        if(!advance())return false;
+        if(terrain_&&first<Last&&last>First){
+            if(!terrain_->visitRegistrations(selected,[&](InstanceHandle h,int terrainObject){
+                const unsigned slot=First+h.slot;
+                if(slot<first||slot>=last)return true;
+                if(actor!=Actors){
+                    const unsigned stamp=terrain_->registrationOrder(h);
+                    while(actor!=Actors&&order(InstanceHandle{shared(actor),generation})<stamp)
+                        if(!emitActor())return false;
+                }
+                return emit(slot,h.generation,terrainObject)&&revision==revision_;
+            }))return false;
+        }
+        while(actor!=Actors)if(!emitActor())return false;
+        return true;
+    }
+};
+}
+#endif
