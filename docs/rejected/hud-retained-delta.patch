--- a/src/platform/amiga/AmigaRenderer.c
+++ b/src/platform/amiga/AmigaRenderer.c
@@ -1170,6 +1170,36 @@ void amigaRendererPublishHudStage(AmigaRenderer* renderer, const AmigaHudStage*
     }
 }
 
+void amigaRendererPublishHudDelta(AmigaRenderer* renderer, const AmigaHudStage* stage,
+                                  const AmigaHudStage* overlay, AmigaHudStage* previous,
+                                  unsigned first, unsigned end) {
+    unsigned y, word;
+    UBYTE* row = renderer->hud + (stage->y + first) * downwellBytesPerPlaneLine + (stage->x >> 3);
+    for (y = first; y < end; ++y, row += downwellBytesPerPlaneLine) {
+        const int band = overlay ? stage->y + (int)y - overlay->y : -1;
+        const int layered = band >= 0 && band < (int)overlay->rows;
+        for (word = 0; word < stage->words; ++word) {
+            UWORD mask = stage->mask[y][word], low = stage->low[y][word], high = stage->high[y][word];
+            UWORD lowChange, highChange;
+            UBYTE* target = row + word*2;
+            if (layered && word < overlay->words) {
+                const UWORD top = overlay->mask[band][word];
+                low = (UWORD)((low & ~top) | (overlay->low[band][word] & top));
+                high = (UWORD)((high & ~top) | (overlay->high[band][word] & top));
+                mask |= top;
+            }
+            lowChange = mask & ((UWORD)~previous->mask[y][word] | (low ^ previous->low[y][word]));
+            highChange = mask & ((UWORD)~previous->mask[y][word] | (high ^ previous->high[y][word]));
+            if (lowChange) writeWord(target, (UWORD)((readWord(target) & ~lowChange) | (low & lowChange)));
+            if (highChange) writeWord(target + downwellPlaneBytes,
+                (UWORD)((readWord(target + downwellPlaneBytes) & ~highChange) | (high & highChange)));
+            previous->low[y][word] = (UWORD)((previous->low[y][word] & ~mask) | (low & mask));
+            previous->high[y][word] = (UWORD)((previous->high[y][word] & ~mask) | (high & mask));
+            previous->mask[y][word] |= mask;
+        }
+    }
+}
