New experimental header (not part of the base revision):
#ifndef DOWNWELL_AMIGA_TERRAIN_FIELD_WORDS_H
#define DOWNWELL_AMIGA_TERRAIN_FIELD_WORDS_H
#include "AmigaGoalField.h"

// No coverage index, merged-word bank or saved underlay. Each source circle
// writes its immutable prepared words in source order. The pristine ring is
// authoritative for restoration, including overlaps between old circles.
inline void amigaTerrainFieldWords(const UBYTE* terrain,UBYTE* target,
    const downwell::TimeFieldOutlines& shape,unsigned origin,bool restore,UWORD* paintedRows=nullptr){
    if(paintedRows)for(unsigned i=0;i<downwellGameRingHeight/16;++i)paintedRows[i]=0;
    unsigned lastRow=downwellGameRingHeight;
    amigaFieldWords(shape,downwellPlayfieldX,0,downwellPlayfieldX+downwellPlayfieldWidth,
        downwellDisplayHeight,[&](int x,int y,unsigned mask,unsigned low,unsigned high){
            unsigned row=origin+unsigned(y);
            if(row>=downwellGameRingHeight)row-=downwellGameRingHeight;
            if(paintedRows&&row!=lastRow){
                paintedRows[row/16]|=UWORD(1u<<(row&15));lastRow=row;
            }
            unsigned offset=row*downwellBytesPerPlaneLine+unsigned(x)/8;
            for(unsigned p=0;p<2;++p,offset+=downwellGameRingPlaneBytes){
                const unsigned actual=(unsigned(target[offset])<<8)|target[offset+1];
                const unsigned paint=restore?
                    (((unsigned(terrain[offset])<<8)|terrain[offset+1])&mask):p?high:low;
                const unsigned value=(actual&~mask)|paint;
                target[offset]=value>>8;target[offset+1]=value;
            }
        });
}
#endif

