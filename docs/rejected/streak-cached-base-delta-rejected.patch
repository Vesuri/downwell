         }
 }
 
+void amigaRendererPublishHudStageDelta(AmigaRenderer* renderer, AmigaHudStage* stage,
+                                       const AmigaHudStage* previous,
+                                       const UWORD previousShown[amigaHudStageRows][amigaHudStageWords],
+                                       UWORD shown[amigaHudStageRows][amigaHudStageWords]) {
+    const int top = stage->y < previous->y ? stage->y : previous->y;
+    const int end = stage->y + (int)stage->rows > previous->y + (int)previous->rows ?
+        stage->y + (int)stage->rows : previous->y + (int)previous->rows;
+    UBYTE* row = renderer->hud + top * downwellBytesPerPlaneLine + (stage->x >> 3);
+    int line;
+    unsigned word;
+    for (line = top; line < end; ++line, row += downwellBytesPerPlaneLine) {
+        const int now = line - stage->y, before = line - previous->y;
+        const int inNow = now >= 0 && now < (int)stage->rows;
+        const int inBefore = before >= 0 && before < (int)previous->rows;
+        for (word = 0; word < stage->words; ++word) {
+            UWORD mask = 0, low = 0, high = 0, wasMask = 0, wasLow = 0, wasHigh = 0, old = 0;
+            UBYTE* target;
+            if (inNow) { mask = stage->mask[now][word]; low = stage->low[now][word]; high = stage->high[now][word]; }
+            if (inBefore) {
+                wasMask = previous->mask[before][word];
+                wasLow = (UWORD)(previous->low[before][word] & wasMask);
+                wasHigh = (UWORD)(previous->high[before][word] & wasMask);
+                old = (UWORD)(previousShown[before][word] & ~mask);
+            }
+            if (old) { low = (UWORD)(low & ~old); high = (UWORD)(high & ~old); mask = (UWORD)(mask | old); }
+            if (inNow) {
+                stage->low[now][word] = low; stage->high[now][word] = high; stage->mask[now][word] = mask;
+                shown[now][word] = (UWORD)(mask & (low | high));
+            }
+            /* The layer already holds exactly this word's pixels under the
+               same mask: the previous publish wrote them. */
+            if (!mask || (mask == wasMask && (UWORD)(low & mask) == wasLow && (UWORD)(high & mask) == wasHigh))
+                continue;
+            target = row + word*2;
+            writeWord(target, (UWORD)((readWord(target) & ~mask) | (low & mask)));
+            writeWord(target + downwellPlaneBytes,
+                (UWORD)((readWord(target + downwellPlaneBytes) & ~mask) | (high & mask)));
+        }
+    }
+}
