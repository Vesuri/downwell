diff --git a/src/platform/amiga/AmigaFieldDelta.h b/src/platform/amiga/AmigaFieldDelta.h
new file mode 100644
index 00000000..3b4e9d1c
--- /dev/null
+++ b/src/platform/amiga/AmigaFieldDelta.h
@@ -0,0 +1,48 @@
+#ifndef DOWNWELL_AMIGA_FIELD_DELTA_H
+#define DOWNWELL_AMIGA_FIELD_DELTA_H
+#include "AmigaFieldColumns.h"
+
+// With an unchanged pristine underlay, old->new is reversible:
+// target ^= oldColour ^ newColour ^ (terrain & (oldCoverage ^ newCoverage)).
+// Adjacent offline packets compose in either direction, without intermediate
+// clearing or redrawing unchanged outline words. Caller owns the dirty-row gate.
+inline bool amigaFieldDelta(const UBYTE* terrain,UBYTE* target,
+    const downwell::TimeFieldOutlines::Circle& old,
+    const downwell::TimeFieldOutlines::Circle& next,unsigned origin){
+    using namespace downwell;
+    using namespace downwell_field_columns;
+    if(origin>=320||old.x!=next.x||old.y!=next.y||old.x<182||old.x>198||
+       old.radius<128*256||old.radius>=130*256||next.radius<128*256||next.radius>=130*256)return false;
+    unsigned a=fieldColumnRadii[old.radius-128*256],b=fieldColumnRadii[next.radius-128*256];
+    if(a>b){const auto t=a;a=b;b=t;}
+    if(b-a>4)return false;
+    const int base=(old.x-14)/16,shift=(old.x-14)%16;
+    const int rowBase=(int(origin)+old.y)*24;
+    auto part=[&](int offset,unsigned low,unsigned high,unsigned coverage,unsigned clip){
+        low&=clip;high&=clip;coverage&=clip;
+        if(!(low|high|coverage))return;
+        if(offset>=7680)offset-=7680;
+        for(unsigned plane=0;plane<2;++plane,offset+=7680){
+            const unsigned change=(plane?high:low)^(read(terrain,offset)&coverage);
+            if(change)write(target,offset,read(target,offset)^change);
+        }
+    };
+    static const unsigned short clip[24]={0,0,0,0,0,0,3,
+        65535,65535,65535,65535,65535,65535,65535,65535,65535,65532};
+    for(unsigned i=fieldDeltaOffsets[a];i<fieldDeltaOffsets[b];++i){
+        const auto& w=fieldDeltaWords[i];
+        const int y=old.y+w.row;
+        if(y<0||y>=284)continue;
+        const int col=base+w.wordOffset-w.row*24;
+        if(col<5||col>16)continue;
+        const int offset=rowBase+w.wordOffset+base;
+        if(!shift)part(offset,w.low,w.high,w.coverage,clip[col]);
+        else{
+            part(offset,w.low>>shift,w.high>>shift,w.coverage>>shift,clip[col]);
+            part(offset+1,(unsigned(w.low)<<(16-shift))&65535,
+                (unsigned(w.high)<<(16-shift))&65535,(unsigned(w.coverage)<<(16-shift))&65535,clip[col+1]);
+        }
+    }
+    return true;
+}
+#endif
