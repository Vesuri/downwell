diff --git a/src/platform/amiga/AmigaRenderer.c b/src/platform/amiga/AmigaRenderer.c
index 353c9bb5..68e5bd3c 100644
--- a/src/platform/amiga/AmigaRenderer.c
+++ b/src/platform/amiga/AmigaRenderer.c
@@ -758,6 +758,33 @@ unsigned amigaRendererPublishHudBlockedColumn(UBYTE* destination, UBYTE* working
     return writes;
 }
 
+/* A uniform run's final base and stamp are already combined. Publish through
+   the prepared divider without first filling/stamping the working bitmap.
+   Unmasked neighboring pixels stay owned by the retained HUD backing. */
+unsigned amigaRendererPublishHudConstantColumn(UBYTE* destination, UBYTE* working,
+    const AmigaHudBlockedColumn* overlay, unsigned word, int top, int bottom,
+    int shiftY, UWORD clip, UWORD baseLow, UWORD baseHigh) {
+    unsigned writes=0;
+    int y;
+    UBYTE *target,*input;
+    if(word>=downwellVisibleWidth/16 || top<0 || bottom>downwellDisplayHeight ||
+       top>=bottom || top<shiftY || bottom>downwellDisplayHeight+shiftY)return 0;
+    target=destination+top*downwellBytesPerPlaneLine+word*2;
+    input=working+top*downwellBytesPerPlaneLine+word*2;
+    for(y=top;y<bottom;++y){
+        const unsigned sourceY=y-shiftY;
+        const UWORD* source=overlay->blocks+overlay->indices[sourceY>>3]*16+(sourceY&7)*2;
+        const UWORD a=source[0],b=source[1],mask=(a|b)&clip;
+        const UWORD previousLow=readWord(input),previousHigh=readWord(input+downwellPlaneBytes);
+        const UWORD low=(previousLow & (UWORD)~clip) | (((baseLow & (UWORD)~mask)|(a&mask))&clip);
+        const UWORD high=(previousHigh & (UWORD)~clip) | (((baseHigh & (UWORD)~mask)|(b&mask))&clip);
+        if(low!=previousLow){writeWord(input,low);writeWord(target,low);++writes;}
+        if(high!=previousHigh){writeWord(input+downwellPlaneBytes,high);writeWord(target+downwellPlaneBytes,high);++writes;}
+        target+=downwellBytesPerPlaneLine;input+=downwellBytesPerPlaneLine;
+    }
+    return writes;
+}
