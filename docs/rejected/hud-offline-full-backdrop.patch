diff --git a/src/platform/amiga/AmigaGameplayHudBackdrop.h b/src/platform/amiga/AmigaGameplayHudBackdrop.h
new file mode 100644
index 00000000..b7a0d55e
--- /dev/null
+++ b/src/platform/amiga/AmigaGameplayHudBackdrop.h
@@ -0,0 +1,17 @@
+#ifndef DOWNWELL_AMIGA_GAMEPLAY_HUD_BACKDROP_H
+#define DOWNWELL_AMIGA_GAMEPLAY_HUD_BACKDROP_H
+#include "AmigaHealthArt.h"
+
+// The gameplay-entry owner admits the linked immutable source and retires DMA
+// before calling this. This replaces a whole initial HUD, never a live update.
+inline void amigaPublishGameplayHudBackdrop(UBYTE* hud){
+    for(unsigned i=0;i<downwellLayerBytes/2;++i){
+        const UWORD word=AmigaHealthArt::gameplayBackdrop[i];
+#ifdef DOWNWELL_PLATFORM_AMIGA
+        reinterpret_cast<UWORD*>(hud)[i]=word;
+#else
+        hud[i*2]=UBYTE(word>>8);hud[i*2+1]=UBYTE(word);
+#endif
+    }
+}
+#endif
