--- a/tools/generate-amiga-health-art.cpp
+++ b/tools/generate-amiga-health-art.cpp
@@ -22,6 +22,34 @@ static void emit(const char* name,const std::vector<UBYTE>& pixels){
     }
     std::printf("};\n");
 }
+static void emitBackdrop(const std::vector<UBYTE>& pack){
+    std::vector<UBYTE> pixels(downwellLayerBytes);
+    AmigaRenderer renderer;
+    amigaRendererInit(&renderer,nullptr,pixels.data());
+    // Fixed gameplay HUD background. Compose once on the host, including the
+    // mirrored non-word-aligned border, rather than reconstructing it on entry.
+    std::fill(pixels.begin(),pixels.end(),0);
+    amigaRendererFillRect(&renderer,0,0,downwellPlayfieldX,downwellDisplayHeight,3);
+    amigaRendererFillRect(&renderer,downwellPlayfieldX+downwellPlayfieldWidth,0,
+        downwellVisibleWidth-downwellPlayfieldX-downwellPlayfieldWidth,downwellDisplayHeight,3);
+    auto fixedAsset=[&](unsigned sprite,unsigned frame,int x,int y,int flip){
+        int left,top,width,height;
+        assert(amigaRendererAssetBounds(pack.data(),pack.data()+pack.size(),sprite,frame,x,y,flip,
+            &left,&top,&width,&height));
+        amigaRendererDrawAsset(&renderer,pack.data(),pack.data()+pack.size(),sprite,frame,x,y,flip);
+    };
+    fixedAsset(408,0,108,0,0);
+    fixedAsset(408,0,272,0,1);
+    fixedAsset(416,0,284,43,0);
+    amigaRendererFillRect(&renderer,289,49,10,184,1);
+    fixedAsset(416,1,284,43,0);
+    std::printf("static const UWORD gameplayBackdrop[downwellLayerBytes/2]={\n");
+    for(unsigned i=0;i<pixels.size();i+=2){
+        std::printf("%u,",word(pixels.data()+i));
+        if(i%48==46)std::printf("\n");
+    }
+    std::printf("};\n");
+}
 int main(int argc,char** argv){
     assert(argc==2);
     std::ifstream file(argv[1],std::ios::binary);
