new file mode 100644
index 00000000..caa24be7
--- /dev/null
+++ b/tests/platform/amiga/AmigaEffectWordsTest.cpp
@@ -0,0 +1,66 @@
+#include "platform/amiga/AmigaEffectWords.h"
+#include "core/EffectMaskAssets.h"
+#include "core/PaletteEffectSurface.h"
+#include <array>
+#include <vector>
+#include <fstream>
+#include <iterator>
+#include <iostream>
+#include <cstdlib>
+static void require(bool ok,const char* message){if(!ok){std::cerr<<message<<'\n';std::exit(1);}}
+static std::vector<std::uint8_t> read(const char* path){
+    std::ifstream input(path,std::ios::binary);require(bool(input),"missing input");
+    return {std::istreambuf_iterator<char>(input),{}};
+}
+int main(int argc,char** argv){
+    require(argc==3,"usage: effect-words-test game.dwap words.bin");
+    const auto pack=read(argv[1]),bytes=read(argv[2]);
+    downwell::EffectMaskAssets assets;require(assets.bind(pack.data(),pack.size()),"asset bank");
+    AmigaEffectWords bank;require(bank.bind(bytes.data(),bytes.size()),"word bank");
+    using Surface=downwell::PaletteEffectSurface<>;
+    std::array<std::uint16_t,12*284*3> actual;
+    std::array<std::uint16_t,10*284*3> expected;
+    unsigned checks=0;
+    for(unsigned image=0;image<17;++image){
+        const unsigned sprite=image<9?84:image<13?133:134,frame=image<9?image:(image-9)%4;
+        const auto& asset=*(image<9?assets.smoke(frame):assets.currency(sprite==134,frame));
+        const auto* descriptor=bank.find((sprite<<16)|frame);require(descriptor,"missing frame");
+        const auto& mask=asset.mask;
+        Surface::Asset scalar{{mask.data,mask.bytes,mask.width,mask.height,mask.stride},asset.low,asset.high};
+        for(int shift=0;shift<16;++shift)for(unsigned position=0;position<6;++position){
+            const int x=position==0?shift-32:position==1?shift-16:position==2?shift:
+                position==3?shift+64:position==4?shift+144:shift+160;
+            const int y=position%3==0?-8:position%3==1?140:278;
+            actual.fill(0xbeef);expected.fill(0);
+            for(unsigned plane=0;plane<3;++plane)for(unsigned row=0;row<284;++row)
+                for(unsigned word=1;word<=10;++word)actual[plane*12*284+row*12+word]=0;
+            Surface reference;
+            // Two ordered, overlapping opaque replacements from different art.
+            const auto& other=*assets.currency(true,3);
+            const auto& m=other.mask;
+            const auto* otherDescriptor=bank.find((134u<<16)|3u);
+            require(reference.add({{m.data,m.bytes,m.width,m.height,m.stride},other.low,other.high},x+3,y+2),"scalar lower stamp");
+            require(bank.paint(otherDescriptor,x+3,y+2,actual.data()+1,actual.data()+12*284+1,
+                actual.data()+24*284+1,12),"lower stamp");
+            require(reference.add(scalar,x,y)&&bank.paint(descriptor,x,y,actual.data()+1,
+                actual.data()+12*284+1,actual.data()+24*284+1,12),"upper stamp");
+            reference.visit([&](unsigned px,unsigned py,std::uint16_t a,std::uint16_t l,std::uint16_t h){
+                const unsigned at=py*10+px/16;expected[at]=a;expected[2840+at]=l;expected[5680+at]=h;
+            });
+            for(unsigned row=0;row<284;++row)for(unsigned word=0;word<10;++word){
+                const unsigned src=row*10+word,dst=row*12+word+1,alpha=expected[src];
+                require(actual[dst]==alpha,"alpha pixels");
+                require((actual[3408+dst]&alpha)==expected[2840+src]&&
+                    (actual[6816+dst]&alpha)==expected[5680+src],"color pixels");
+            }
+            for(unsigned plane=0;plane<3;++plane)for(unsigned row=0;row<284;++row)
+                require(actual[plane*3408+row*12]==0xbeef&&actual[plane*3408+row*12+11]==0xbeef,"row guards");
+            ++checks;
+        }
+    }
+    require(!bank.find(0),"missing key");
+    require(!bank.bind(bytes.data(),bytes.size()-1)&&!bank.find(84u<<16),"bad size invalidates binding");
+    auto bad=bytes;bad[20]=bad[21]=bad[22]=bad[23]=255;
+    require(!bank.bind(bad.data(),bad.size()),"bad offset");
+    std::cout<<checks<<" shifted/clipped/overlapping effect stamps match scalar pixels and guards\n";
+}
diff --git a/tools/generate-effect-words.py b/tools/generate-effect-words.py
new file mode 100644
index 00000000..7d4f8e8f
--- /dev/null
+++ b/tools/generate-effect-words.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""Compile small DWAP effects to shifted alpha/color words; no target conversion."""
+import hashlib
+import json
+import struct
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    source = ROOT / "generated/amiga-game.dwap"
+    pack = source.read_bytes()
+    assert pack[:8] == b"DWAP\x00\x02\x00\x14"
+    count = struct.unpack_from(">I", pack, 8)[0]
+    images = []
+    for i in range(count):
+        key, ox, oy, width, height, dma, planes, offset, size = struct.unpack_from(">IhhHHHHII", pack, 20+i*24)
+        if key >> 16 not in (84, 133, 134):
+            continue
+        assert planes == 3 and width <= 32 and height <= 32 and dma % 16 == 0
+        stride, plane = dma//8, dma//8*height
+        assert size == plane*3 and offset+size <= len(pack)
+        images.append((key, width, height, stride, plane, offset))
+    assert len(images) == 17
+    output = bytearray(b"DWES"+struct.pack(">HHI", 1, 12, len(images)))
+    output.extend(bytes(12*len(images)))
+    for i, (key, width, height, stride, plane, offset) in enumerate(images):
+        phases = len(output)
+        output.extend(bytes(64))
+        struct.pack_into(">IHHI", output, 12+i*12, key, width, height, phases)
+        for shift in range(16):
+            struct.pack_into(">I", output, phases+shift*4, len(output))
+            ops = []
+            for y in range(height):
+                row = [[0, 0, 0] for _ in range((width+shift+15)//16)]
+                for x in range(width):
+                    source_bit = 0x80 >> (x&7)
+                    at = offset+y*stride+x//8
+                    if not pack[at+plane*2] & source_bit:
+                        continue
+                    column, bit = (x+shift)//16, 0x8000 >> ((x+shift)&15)
+                    row[column][0] |= bit
+                    if pack[at] & source_bit:
+                        row[column][1] |= bit
+                    if pack[at+plane] & source_bit:
+                        row[column][2] |= bit
