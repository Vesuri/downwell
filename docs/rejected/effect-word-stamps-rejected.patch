diff --git a/src/platform/amiga/AmigaEffectWords.h b/src/platform/amiga/AmigaEffectWords.h
new file mode 100644
index 00000000..458e9065
--- /dev/null
+++ b/src/platform/amiga/AmigaEffectWords.h
@@ -0,0 +1,76 @@
+#ifndef DOWNWELL_AMIGA_EFFECT_WORDS_H
+#define DOWNWELL_AMIGA_EFFECT_WORDS_H
+#include <cstdint>
+
+// Host-shifted, nonzero alpha words for small immutable effect images.
+// Raster layout and painter semantics remain owned by PaletteEffectSurface.
+class AmigaEffectWords {
+    const std::uint8_t* data_=nullptr;
+    unsigned bytes_=0,count_=0;
+    static unsigned word(const std::uint8_t* p){
+#ifdef DOWNWELL_PLATFORM_AMIGA
+        return *reinterpret_cast<const std::uint16_t*>(p);
+#else
+        return unsigned(p[0])*256+p[1];
+#endif
+    }
+    static unsigned longWord(const std::uint8_t* p){return (word(p)<<16)|word(p+2);}
+public:
+    bool bind(const std::uint8_t* data,unsigned bytes){
+        data_=nullptr;bytes_=count_=0;
+        if(!data||bytes<12||data[0]!='D'||data[1]!='W'||data[2]!='E'||data[3]!='S'||
+           word(data+4)!=1||word(data+6)!=12||longWord(data+8)>32)return false;
+        const unsigned count=longWord(data+8),start=12+count*12;
+        if(!count||start>bytes)return false;
+        unsigned previous=0;
+        for(unsigned i=0;i<count;++i){
+            const auto* record=data+12+i*12;
+            const unsigned key=longWord(record),width=word(record+4),height=word(record+6),offset=longWord(record+8);
+            if((i&&key<=previous)||!width||width>32||!height||height>32||offset<start||offset>bytes||bytes-offset<64||(offset&1))return false;
+            previous=key;
+            for(unsigned phase=0;phase<16;++phase){
+                const unsigned at=longWord(data+offset+phase*4);
+                if(at<start||at>bytes||bytes-at<2||(at&1))return false;
+                const unsigned n=word(data+at);
+                if(n>(bytes-at-2)/10)return false;
+                for(unsigned op=0;op<n;++op){
+                    const auto* p=data+at+2+op*10;
+                    const unsigned alpha=word(p+4);
+                    if(word(p)>=height||word(p+2)>=(width+phase+15)/16||!alpha||
+                       ((word(p+6)|word(p+8))&~alpha))return false;
+                }
+            }
+        }
+        data_=data;bytes_=bytes;count_=count;return true;
+    }
+    const std::uint8_t* find(unsigned key)const{
+        for(unsigned i=0;i<count_;++i){
+            const auto* record=data_+12+i*12;
+            if(longWord(record)==key)return record;
+        }
+        return nullptr;
+    }
+    // Descriptor belongs to this bank; caller binds it once with matching
+    // immutable source art. Clipping is to the effect surface, not DMA sprites.
+    bool paint(const std::uint8_t* record,int x,int y,std::uint16_t* alpha,
+               std::uint16_t* low,std::uint16_t* high,unsigned stride)const{
+        if(!data_||!record||record<data_+12||record>=data_+12+count_*12||
+           (record-(data_+12))%12||!alpha||!low||!high||stride<10)return false;
+        const int width=int(word(record+4)),height=int(word(record+6));
+        if(x>=160||x<=-width||y>=284||y<=-height)return true;
+        int column=x/16,shift=x%16;if(shift<0){shift+=16;--column;}
+        const auto* phases=data_+longWord(record+8);
+        const auto* p=data_+longWord(phases+unsigned(shift)*4);
+        unsigned n=word(p);p+=2;
+        for(unsigned i=0;i<n;++i,p+=10){
+            const int dy=y+int(word(p)),dx=column+int(word(p+2));
+            if(dy<0||dy>=284||dx<0||dx>=10)continue;
+            const unsigned at=unsigned(dy)*stride+unsigned(dx),mask=word(p+4);
+            alpha[at]|=std::uint16_t(mask);
+            low[at]=std::uint16_t((low[at]&~mask)|word(p+6));
+            high[at]=std::uint16_t((high[at]&~mask)|word(p+8));
+        }
+        return true;
+    }
+};
+#endif
