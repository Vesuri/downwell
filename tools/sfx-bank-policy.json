{
 "comment": "W2.2 sound bank policy, read by tools/sfx-bank.py. Hand-authored. Each kept sound of docs/sound-inventory.md falls in the first class whose pattern matches its name. rate and crop are the class's current choice; the listening page (extracted/amiga-sfx/preview/index.html) exports an updated copy of this file. Long sounds take their cut from 'long'.",
 "rates": [8363, 11025, 13979, 16726],
 "crops": [-24, -30, -36],
 "chipReserveKiB": 465,
 "classes": [
  {"key": "thuds", "label": "Footsteps, landings, jump, turn",
   "match": ["^sfxFootstep", "^sfxFs", "^sfxJumpLand", "^sfxJl", "^sfxPlayerJump1$", "^sfxPlayerTurn$"],
   "rate": 8363, "crop": -24},
  {"key": "guns", "label": "Guns, empty, recharge, drone",
   "match": ["^sfxGun", "^sfxDroneShoot$"],
   "pitchPeak": 1.8, "pitchNote": "scrShotSound adds +0.8 at half ammo (outside area 3)",
   "rate": 8363, "crop": -24},
  {"key": "impacts", "label": "Bullet hits, breaks, explosions, stomps",
   "match": ["^sfxBhit", "^sndShotwall$", "^sfxBreakRock", "^sfxEnmExplode", "^sfxStompEnmUni$",
             "^sfxGemChunk", "^sfxUpgradeGunpowder_Bullet$", "^sndCaseBreak$", "^sfxTorchOut$"],
   "rate": 8363, "crop": -24},
  {"key": "creatures", "label": "Enemy cries, hurt, death, eat",
   "match": ["^sfx(Bat|Frog|Jelly|Slug|Snake|Turtle|Crawler|RedEye)", "^sndEnemyhurt$", "^sndPlayerHurt$",
             "^sfxPlayerEat$", "^sfxDeath$"],
   "rate": 8363, "crop": -24},
  {"key": "gems", "label": "Gems, coins, pickups, combos",
   "match": ["^sndGem$", "^sndCoinbounce1$", "^sfxGem(Bounce|Disappear|Get)", "^sndHpGain$",
             "^sfxPickupWeapon$", "^sfxUpgradeGem_pickup_shoot$", "^sfxCombo"],
   "rate": 8363, "crop": -24},
  {"key": "stings", "label": "Gem boost, void doors, rocket jump, transitions",
   "match": ["^sfxGemBoost", "^sfxVoid(Enter|Exit)$", "^sfxUpgradeRocket_Jump$", "^sfxDissipate$",
             "^sfxFallingDown$"],
   "rate": 8363, "crop": -24},
  {"key": "voices", "label": "Shopkeeper voice",
   "match": ["^sfxSk"],
   "rate": 8363, "crop": -24},
  {"key": "ui", "label": "Menus, shop UI, results, low-ammo beep",
   "match": ["^sfxUi", "^sfxShop", "^sfxNotifLowAmmo$"],
   "pitchSounds": {"328": 2.2}, "pitchNote": "DeathMenu raises the progress-bar fill (328) up to pitch 2.2",
   "rate": 8363, "crop": -24},
  {"key": "long", "label": "Long sounds, cut to fit",
   "match": ["^sfxMagicWind", "^amb1$", "^sfxFalling$", "^sfxTitleAppear$", "^sfxUpgradeJetpack_Fire_Loop$"],
   "rate": 8363, "crop": -24}
 ],
 "long": {
  "comment": "swellSeconds: a window around the loudest part, faded in over 40 % and out over 50 %. seconds: keep the head and fade out over fadeSeconds. loopStart/loopSeconds: a loop of that segment whose head is crossfaded (equal power, crossfadeSeconds) with the audio after it, so it repeats without an intro.",
  "349": {"cuts": {"swell 1.5 s": {"swellSeconds": 1.5}, "swell 2.5 s": {"swellSeconds": 2.5}, "swell 4 s": {"swellSeconds": 4.0}, "head 2.5 s": {"seconds": 2.5}}, "cut": "swell 1.5 s"},
  "350": {"cuts": {"swell 1.5 s": {"swellSeconds": 1.5}, "swell 2.5 s": {"swellSeconds": 2.5}, "swell 4 s": {"swellSeconds": 4.0}, "head 2.5 s": {"seconds": 2.5}}, "cut": "swell 1.5 s"},
  "351": {"cuts": {"swell 1.5 s": {"swellSeconds": 1.5}, "swell 2.5 s": {"swellSeconds": 2.5}, "swell 4 s": {"swellSeconds": 4.0}, "head 2.5 s": {"seconds": 2.5}}, "cut": "swell 1.5 s"},
  "352": {"cuts": {"swell 1.5 s": {"swellSeconds": 1.5}, "swell 2.5 s": {"swellSeconds": 2.5}, "swell 4 s": {"swellSeconds": 4.0}, "head 2.5 s": {"seconds": 2.5}}, "cut": "swell 1.5 s"},
  "353": {"cuts": {"swell 1.5 s": {"swellSeconds": 1.5}, "swell 2.5 s": {"swellSeconds": 2.5}, "swell 4 s": {"swellSeconds": 4.0}, "head 2.5 s": {"seconds": 2.5}}, "cut": "swell 1.5 s"},
  "354": {"cuts": {"swell 1.5 s": {"swellSeconds": 1.5}, "swell 2.5 s": {"swellSeconds": 2.5}, "swell 4 s": {"swellSeconds": 4.0}, "head 2.5 s": {"seconds": 2.5}}, "cut": "swell 1.5 s"},
  "355": {"cuts": {"swell 1.5 s": {"swellSeconds": 1.5}, "swell 2.5 s": {"swellSeconds": 2.5}, "swell 4 s": {"swellSeconds": 4.0}, "head 2.5 s": {"seconds": 2.5}}, "cut": "swell 1.5 s"},
